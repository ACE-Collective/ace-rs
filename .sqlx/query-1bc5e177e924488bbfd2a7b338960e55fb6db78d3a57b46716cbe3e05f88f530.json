  "query": "SELECT c.id, r.uuid AS run, u.username::text AS \"user?\", c.comment, c.created_at,\n                  c.updated_at\n           FROM svs.run_comments c\n           JOIN svs.runs r ON r.id = c.run_id\n           LEFT JOIN service.users u ON u.id = c.user_id\n           WHERE c.id = $1",
