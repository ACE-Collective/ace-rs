  "query": "SELECT h.sha256 AS \"sha256!\", s.size AS \"size?\", s.mime_type AS \"mime_type?\"\n           FROM unnest($1::text[]) WITH ORDINALITY AS h(sha256, n)\n           LEFT JOIN store.objects s\n             ON s.pool = $2 AND s.sha256 = h.sha256 AND s.state = 'present'\n           ORDER BY h.n",
