  "query": "SELECT id, uuid, state::text AS \"state!\", created_at, reviewed_at\n                           FROM svs.runs\n                           WHERE test_guid = $1 AND platform = $2 AND state IN ('ended', 'reviewed')\n                             AND (created_at, id) < ($3, $4)\n                           ORDER BY created_at DESC, id DESC\n                           LIMIT $5",
