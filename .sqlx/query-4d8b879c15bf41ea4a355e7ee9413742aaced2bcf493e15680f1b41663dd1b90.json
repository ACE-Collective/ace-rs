  "query": "INSERT INTO analysis.alert_comments (root_id, author_id, created_by, comment)\n         SELECT r.id, $2, $3::jsonb, $4 FROM analysis.roots r\n         WHERE r.id = ANY ($1) AND r.alerted_at IS NOT NULL\n         ORDER BY r.id\n         RETURNING id, root_id",
