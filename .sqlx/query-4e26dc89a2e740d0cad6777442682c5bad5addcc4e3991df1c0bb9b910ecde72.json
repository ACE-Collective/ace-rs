  "query": "SELECT o.type AS \"kind!\", o.value AS \"value!\" FROM analysis.observables o\n                       JOIN unnest($2::text[], $3::text[]) AS e (kind, value)\n                         ON o.type = e.kind AND lower(o.value) = e.value\n                       WHERE o.root_id = $1\n                       ORDER BY o.type, o.value LIMIT $4",
