  "query": "SELECT c.id, $2::uuid AS \"run!\", u.username::text AS \"user?\", c.comment,\n                                  c.created_at, c.updated_at\n                           FROM svs.run_comments c\n                           LEFT JOIN service.users u ON u.id = c.user_id\n                           WHERE c.run_id = $1 ORDER BY c.id",
