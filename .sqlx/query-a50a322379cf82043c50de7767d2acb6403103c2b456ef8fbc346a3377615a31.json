{
  "db_name": "PostgreSQL",
  "query": "SELECT r.root_id, a.observable_value, a.handler, a.status, a.result, a.result_message, a.events\n         FROM queue.actions a JOIN queue.action_roots r ON r.action_id = a.id\n         WHERE a.kind = 'remediation_check' AND a.observable_type = $1 AND r.root_id = ANY($2)\n         ORDER BY a.id",
