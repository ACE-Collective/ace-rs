  "db_name": "PostgreSQL",
  "query": "SELECT root_id AS \"root_id!\", id AS \"id!\", type AS \"kind!\", value AS \"value!\"\n                           FROM (\n                               SELECT root_id, id, type, value,\n                                      row_number() OVER (PARTITION BY root_id ORDER BY id) AS place\n                               FROM analysis.observables\n                               WHERE root_id = ANY($1)\n                           ) AS numbered\n                           WHERE place <= $2\n                           ORDER BY root_id, id",
