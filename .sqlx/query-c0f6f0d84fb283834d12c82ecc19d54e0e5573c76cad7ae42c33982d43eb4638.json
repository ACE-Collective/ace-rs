  "query": "SELECT a.object_sha256, a.size FROM email_archive.archive a\n               JOIN store.objects o ON o.pool = $2 AND o.sha256 = a.object_sha256\n               WHERE a.hash = $1 AND o.state = 'present'\n               ORDER BY a.insert_date DESC LIMIT 1",
