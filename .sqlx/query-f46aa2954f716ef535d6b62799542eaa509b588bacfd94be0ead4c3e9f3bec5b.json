{
  "db_name": "PostgreSQL",
  "query": "SELECT o.id AS \"id: ObservableId\", (o.redirection_type IS NOT NULL) AS \"redirected!\",\n                  f.path AS \"path?\", f.yara_meta AS \"yara_meta?\", s.size AS \"size?\",\n                  s.mime_type AS \"mime?\"\n           FROM analysis.observables o\n           LEFT JOIN LATERAL (\n               SELECT path, yara_meta FROM analysis.files\n               WHERE root_id = o.root_id AND observable_id = o.id\n               ORDER BY analyzed DESC, depth, path COLLATE \"C\" LIMIT 1\n           ) f ON o.type = 'file'\n           LEFT JOIN store.objects s ON o.type = 'file' AND s.pool = $3 AND s.sha256 = o.value\n           WHERE o.root_id = $1 AND o.id = ANY($2)",
