    {"name": "full_path re", "meta": {"full_path": "re:.*\\.pptx\\.extracted/.*\\.xml\\.noxml"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": true},
    {"name": "full_path re miss", "meta": {"full_path": "re:^/opt/"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": false},
    {"name": "full_path negated re", "meta": {"full_path": "!re:extracted"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": false},
    {"name": "full_path sub", "meta": {"full_path": "sub:Extracted/"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": true},
    {"name": "full_path negated sub", "meta": {"full_path": "!sub:extracted"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": false},

    {"name": "meta_tags plain", "meta": {"meta_tags": "type=email.attachment"}, "path": "a/x", "meta_tags": ["type=email.attachment", "other=Thing"], "keep": true},
    {"name": "meta_tags plain miss", "meta": {"meta_tags": "type=email.headers"}, "path": "a/x", "meta_tags": ["type=email.attachment", "other=Thing"], "keep": false},
    {"name": "meta_tags plain list against every tag", "meta": {"meta_tags": "type=email.headers, OTHER=thing"}, "path": "a/x", "meta_tags": ["type=email.attachment", "other=Thing"], "keep": true},
    {"name": "meta_tags negated", "meta": {"meta_tags": "!type=email.attachment"}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": false},
    {"name": "meta_tags negated miss", "meta": {"meta_tags": "!type=email.headers"}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": true},
    {"name": "meta_tags re", "meta": {"meta_tags": "re:^type=email\\."}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": true},
    {"name": "meta_tags re miss", "meta": {"meta_tags": "re:^type=script"}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": false},
    {"name": "meta_tags negated re", "meta": {"meta_tags": "!re:email"}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": false},
    {"name": "meta_tags sub", "meta": {"meta_tags": "sub:type=email."}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": true},
    {"name": "meta_tags sub miss", "meta": {"meta_tags": "sub:type=script."}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": false},
    {"name": "meta_tags negated sub", "meta": {"meta_tags": "!sub:script"}, "path": "a/x", "meta_tags": ["type=email.attachment"], "keep": true},

    {"name": "meta_tags with no tags", "meta": {"meta_tags": "type=email.attachment"}, "path": "a/x", "meta_tags": [], "keep": false},
    {"name": "meta_tags re with no tags", "meta": {"meta_tags": "re:.*"}, "path": "a/x", "meta_tags": [], "keep": false},
    {"name": "meta_tags sub with no tags", "meta": {"meta_tags": "sub:"}, "path": "a/x", "meta_tags": [], "keep": false},
    {"name": "meta_tags negated with no tags", "meta": {"meta_tags": "!type=email.attachment"}, "path": "a/x", "meta_tags": [], "keep": true},
    {"name": "no meta_tags directive with no tags", "meta": {"file_ext": "ps1"}, "path": "a/x.ps1", "meta_tags": [], "keep": true},

    {"name": "a directive key ignores case", "meta": {"FILE_EXT": "exe"}, "path": "a/report.ps1", "keep": false},
    {"name": "a value that isn't a string is ignored", "meta": {"file_ext": 1, "mime_type": true}, "path": "a/report.ps1", "keep": true},
    {"name": "every directive has to hold", "meta": {"file_ext": "ps1", "mime_type": "text/html"}, "path": "a/report.ps1", "mime_type": "text/plain", "keep": false},
    {"name": "an empty item in a sub: list matches anything", "meta": {"file_ext": "sub:zzz,"}, "path": "a/report.ps1", "keep": true},
    {"name": "a space before ! is not negation", "meta": {"file_ext": " !ps1"}, "path": "a/report.ps1", "keep": false},
    {"name": "an upper-case RE: is not a regex", "meta": {"file_ext": "RE:^ps1$"}, "path": "a/report.ps1", "keep": false},
    {"name": "re: wins over sub: given both", "meta": {"file_ext": "re:sub:^p"}, "path": "a/report.ps1", "keep": true},
    {"name": "a blacklisted rule is dropped", "meta": {}, "path": "a/report.ps1", "blacklisted": true, "keep": false}
