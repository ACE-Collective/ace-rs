{
  "about": "PLAN.md 1.2's table: each meta filter directive with each prefix, plus the no-tags case. tests/filter.rs runs it through ace-yara, and tools/ace3/yara/filter_cases.py runs it through yara_scanner_v2's filter_scan_results in ace3's dev container. keep is whether the match survives the filter.",
  "cases": [
    {"name": "no directives", "meta": {"author": "x"}, "path": "a/report.ps1", "keep": true},

    {"name": "file_ext plain", "meta": {"file_ext": "ps1"}, "path": "a/b/report.PS1", "keep": true},
    {"name": "file_ext plain list", "meta": {"file_ext": "exe, PS1 ,dll"}, "path": "a/b/report.ps1", "keep": true},
    {"name": "file_ext plain miss", "meta": {"file_ext": "exe,dll"}, "path": "a/b/report.ps1", "keep": false},
    {"name": "file_ext negated", "meta": {"file_ext": "!ps1"}, "path": "a/b/report.ps1", "keep": false},
    {"name": "file_ext negated miss", "meta": {"file_ext": "!exe"}, "path": "a/b/report.ps1", "keep": true},
    {"name": "file_ext re", "meta": {"file_ext": "re:^p.1$"}, "path": "a/b/report.PS1", "keep": true},
    {"name": "file_ext re miss", "meta": {"file_ext": "re:^exe$"}, "path": "a/b/report.ps1", "keep": false},
    {"name": "file_ext negated re", "meta": {"file_ext": "!re:^ps"}, "path": "a/b/report.ps1", "keep": false},
    {"name": "file_ext sub", "meta": {"file_ext": "sub:S"}, "path": "a/b/report.ps1", "keep": true},
    {"name": "file_ext sub miss", "meta": {"file_ext": "sub:x"}, "path": "a/b/report.ps1", "keep": false},
    {"name": "file_ext negated sub", "meta": {"file_ext": "!sub:x"}, "path": "a/b/report.ps1", "keep": true},
    {"name": "file_ext from a dot in a directory", "meta": {"file_ext": "d/noext"}, "path": "a.d/noext", "keep": true},
    {"name": "file_ext with no dot anywhere", "meta": {"file_ext": "exe"}, "path": "a/noext", "keep": false},

    {"name": "file_name plain", "meta": {"file_name": "invoice123.doc"}, "path": "x/y/Invoice123.DOC", "keep": true},
    {"name": "file_name plain miss", "meta": {"file_name": "other.doc"}, "path": "x/y/Invoice123.DOC", "keep": false},
    {"name": "file_name negated", "meta": {"file_name": "!invoice123.doc"}, "path": "x/y/Invoice123.DOC", "keep": false},
    {"name": "file_name re", "meta": {"file_name": "re:invoice[0-9]+\\.doc$"}, "path": "x/y/Invoice123.DOC", "keep": true},
    {"name": "file_name re against the name, not the path", "meta": {"file_name": "re:^y/"}, "path": "x/y/Invoice123.DOC", "keep": false},
    {"name": "file_name negated re", "meta": {"file_name": "!re:^inv"}, "path": "x/y/Invoice123.DOC", "keep": false},
    {"name": "file_name sub", "meta": {"file_name": "sub:VOICE"}, "path": "x/y/Invoice123.DOC", "keep": true},
    {"name": "file_name negated sub", "meta": {"file_name": "!sub:voice"}, "path": "x/y/Invoice123.DOC", "keep": false},
    {"name": "file_name re is lowercased before it compiles", "meta": {"file_name": "re:\\D+123"}, "path": "x/y/Invoice123.DOC", "keep": false},

    {"name": "mime_type plain", "meta": {"mime_type": "Application/PDF"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": true},
    {"name": "mime_type plain miss", "meta": {"mime_type": "text/plain"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": false},
    {"name": "mime_type negated", "meta": {"mime_type": "!application/pdf"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": false},
    {"name": "mime_type re", "meta": {"mime_type": "re:^application/"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": true},
    {"name": "mime_type negated re", "meta": {"mime_type": "!re:pdf$"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": false},
    {"name": "mime_type sub", "meta": {"mime_type": "sub:PDF"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": true},
    {"name": "mime_type sub miss", "meta": {"mime_type": "sub:image/"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": false},
    {"name": "mime_type negated sub", "meta": {"mime_type": "!sub:image/"}, "path": "a/x.pdf", "mime_type": "application/pdf", "keep": true},

    {"name": "full_path plain", "meta": {"full_path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml"}, "path": "alert/deck.pptx.extracted/ppt/slide1.xml.noxml", "keep": true},
