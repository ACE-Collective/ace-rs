#!/usr/bin/env python3
"""Builds the scanner images the scanner pool runs (PLAN.md 7.7), from ace3's own sources.

ace3's phishkit and js-deobfuscator services keep their code: each image is built from ace3's
Dockerfile for it (phishkit/Dockerfile.phishkit, js_deobfuscator/Dockerfile.js_deobfuscator) and the
files that Dockerfile copies, as ace3's commit has them, pinned as ace3 pins them. This reads them
with `git show` from ace3's checkout, writes them into a build context of its own under
target/scanners/<image>/, and builds:

    ace4-js-deobfuscator:latest    node 26 with webcrack and harness.js
    ace4-phishkit:latest           Ubuntu 22.04, Chrome, SeleniumBase and scanner.py

so a build here never replaces ace3's own `phishkit` and `js-deobfuscator` images, and nothing in
ace3's checkout changes. Each image is labelled with the ace3 commit it came from.

ACE4_ACE3_CHECKOUT is ace3's checkout (default: ../ace3 beside this checkout, or
~/Development/public/ace3), and ACE4_ACE3_COMMIT the commit to build from (default: its HEAD).

Usage: docker/scanners/build [js-deobfuscator] [phishkit]     (both by default)
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
CONTEXTS = REPO / "target" / "scanners"

# image name -> (ace3's Dockerfile, the files it copies)
IMAGES = {
    "js-deobfuscator": (
        "js_deobfuscator/Dockerfile.js_deobfuscator",
        ["js_deobfuscator/package.json", "js_deobfuscator/harness.js"],
    ),
    "phishkit": (
        "phishkit/Dockerfile.phishkit",
        ["phishkit/requirements.phishkit.txt", "phishkit/scanner.py", "etc/phishkit_config.yaml"],
    ),
}


def checkout():
    if "ACE4_ACE3_CHECKOUT" in os.environ:
        candidates = [Path(os.environ["ACE4_ACE3_CHECKOUT"])]
    else:
        candidates = [REPO.parent / "ace3", Path.home() / "Development" / "public" / "ace3"]
    for candidate in candidates:
        if (candidate / "phishkit" / "Dockerfile.phishkit").exists():
            return candidate
    sys.exit("scanners: no ace3 checkout; set ACE4_ACE3_CHECKOUT")


def show(ace3, commit, path):
    """A file's bytes at `commit`, read from git's objects: nothing in the checkout changes."""
    return subprocess.run(["git", "-C", str(ace3), "show", f"{commit}:{path}"], check=True,
                          capture_output=True).stdout


def build(ace3, commit, name):
    dockerfile, files = IMAGES[name]
    context = CONTEXTS / name
    if context.exists():
        shutil.rmtree(context)
    for path in [dockerfile, *files]:
        dest = context / path
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(show(ace3, commit, path))
    tag = f"ace4-{name}:latest"
    print(f"scanners: building {tag} from ace3 {commit[:12]}", flush=True)
    subprocess.run(["docker", "build", "--tag", tag, "--file", str(context / dockerfile),
                    "--label", f"ace4.scanner.ace3-commit={commit}", str(context)], check=True)


def main():
    names = sys.argv[1:] or list(IMAGES)
    unknown = [n for n in names if n not in IMAGES]
    if unknown:
        sys.exit(f"scanners: no image {', '.join(unknown)}; there are {', '.join(IMAGES)}")
    ace3 = checkout()
    commit = os.environ.get("ACE4_ACE3_COMMIT") or subprocess.run(
        ["git", "-C", str(ace3), "rev-parse", "HEAD"], check=True, capture_output=True,
        text=True).stdout.strip()
    for name in names:
        build(ace3, commit, name)


if __name__ == "__main__":
    main()
