{
  "about": "The local sample set from PLAN.md step 0.8, written by tools/samples/gather. alert_path and meta_tags give the unit each file is scanned as: an email is the alert's root file email.rfc822 with no tags, and anything else is an email attachment at the alert's top level tagged type=email.attachment. Files under local/ aren't in git; rerun the script to make them.",
  "ace3_commit": "141a60a2",
  "required_kinds": [
    "email",
    "archive/zip",
    "archive/7z",
    "archive/rar",
    "archive/password",
    "pdf",
    "office/macro",
    "rtf"
  ],
  "gaps": [
    "an encrypted RAR: making one needs RARLAB's non-free rar tool",
    "a legacy .xls (BIFF8) with an Excel 4.0 macro sheet: nothing here writes one",
    "PowerPoint and Excel files with VBA macros: ace3's tests hold Word ones only",
    "an encrypted PDF: ace3's tests build theirs with pikepdf at test time"
  ],
