#!/usr/bin/env python3
"""PLAN.md 2.30: the end-to-end test, against the Compose stack's own images.

It brings up postgres, bucket, ace, the parser and network pools and the e2e profile's
responder under a project of its own (ace4-e2e), with:

- a signatures repository it makes under target/e2e/ from tools/ace3/trees/signatures, holding
  one rule that matches a marker string only in a file tagged type=email.attachment (its meta_tags
  directive);
- tests/e2e/site/overlay.yaml, which points the RDAP module and the clicker_detection_splunk
  instance of the Splunk module at the responder's recordings, so nothing reaches the internet;
- a 15-second lease, so a task a killed pool held comes back quickly.

Then it submits samples/ace4/email/e2e.email.rfc822, an email with a DKIM signing domain
(example.com) in its headers and a zip attachment holding the marker, twice. Each time, the email, archive and YARA modules run in
email mode; the YARA match on the attachment makes the root an alert in correlation mode, which
runs RDAP and the Splunk instance, the delayed module, on the domain. The second time the
parser pool is frozen before the submission, so the core leases it a task it never answers, and
it is killed with SIGKILL while it holds that lease, then started again. Both roots must have
results from all five modules and complete; the second only later. The same email goes in both
times, so their trees in the normal form (PLAN.md 3.1) must be the same text, which goes to
<work>/normal-form.json.

Then it starts the Python pool (PLAN.md 4.1), from its own image, and queues tasks of a probe module
on it, one at a time, through the real core and bucket. Limits of 3 tasks and 128 MB make each kind
of recycling happen, and each task's result names the process it ran in. So this is 4.1's Done check:
a worker is recycled at its limit, and the next task runs on its replacement, in a different process.
The same module imports the image's libraries inside a contained worker and reports their versions,
and a task that raises must leave a failed row.

It then runs `ace compare` (PLAN.md 3.3, crates/ace-app/src/compare.rs) over the sample set, each
sample in the cli mode against ace3's tree in tools/ace3/trees/reference/ (3.2), and writes the
report to <work>/compare/. It enforces the acceptance threshold in docs/acceptance.md: a difference
in any sample that tools/ace3/trees/differences.md doesn't list fails the test, and so does a row
that matches nothing, so the list stays true. So does a sample absent from this machine, unless CI
is set: CI doesn't have the git-ignored samples/local/, so there it holds over the tracked samples,
and the report says how many were absent.

Usage: tests/e2e/run [--keep] [--compare]
  --keep      leaves the stack up
  --compare   only brings up the stack and runs `ace compare` over the sample set, reporting
              differences without enforcing the threshold, and fails only when a sample can't be
              run

Exits 0 when every check passes. Needs docker compose and python3 on the host.

A site repository runs the same scenario, without the comparison with ace3, against its own images (PLAN.md 2.32) by setting:

- ACE4_E2E_COMPOSE: its Compose file, whose services have this file's names (postgres, bucket,
  ace, parsers, lookups and the e2e profile's responder);
- ACE4_E2E_PREFIX: the prefix of that file's variables, such as SITE_PORT_, in place of ACE4_;
- ACE4_E2E_PROJECT: the Compose project the test runs under, in place of ace4-e2e;
- ACE4_E2E_SITE: the site overlay directory, in place of tests/e2e/site;
- ACE4_E2E_WORK: where the signatures repository goes, in place of target/e2e;
- ACE4_E2E_PORT: the host port, as for ace4;
- ACE4_E2E_ACE_COMMAND: the ace service's binary, in place of ace.

Its modules differ from ace3's by design, so setting ACE4_E2E_SITE skips the comparison, and the
Python pool's stage, whose probe is this overlay's.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
COMPOSE_FILE = Path(os.environ.get("ACE4_E2E_COMPOSE", ROOT / "compose.yaml")).resolve()
PREFIX = os.environ.get("ACE4_E2E_PREFIX", "ACE4_")
WORK = Path(os.environ.get("ACE4_E2E_WORK", ROOT / "target" / "e2e")).resolve()
SITE = Path(os.environ.get("ACE4_E2E_SITE", ROOT / "tests" / "e2e" / "site")).resolve()
PROJECT = os.environ.get("ACE4_E2E_PROJECT", "ace4-e2e")
PORT = os.environ.get("ACE4_E2E_PORT", "7444")
ACE_COMMAND = os.environ.get("ACE4_E2E_ACE_COMMAND", "ace")
SUBMIT_TOKEN = "ace4-e2e-submit-token"
LEASE_SECONDS = 15
RULE = "ace4_e2e_attachment"
SAMPLE = "ace4/email/e2e.email.rfc822"
TREES = ROOT / "tools" / "ace3" / "trees"
MODULES = [
    "email_analyzer",
    "archive",
    "yara_scanner_v3_4",
    "rdap_analyzer",
    "clicker_detection_splunk",
]
PARSER_MODULES = ["email_analyzer", "archive", "yara_scanner_v3_4"]
PYTHON_PROBE = "e2e_python_probe"
# what python/requirements.in pins
PYTHON_LIBRARIES = [
    "oletools 0.60.2", "msoffcrypto-tool 6.0.0", "pcodedmp 1.2.6", "XLMMacroDeobfuscator 0.2.7",
    "xlrd2 1.3.4", "pyxlsb2 0.0.9",
]

ENV = {
    **os.environ,
    **{
        PREFIX + name: value
        for name, value in {
            "STACK": PROJECT,
            "PORT_HTTPS": PORT,
            "SITE": str(SITE),
            "SIGNATURES": str(WORK / "signatures"),
            "LEASE_SECONDS": str(LEASE_SECONDS),
            "RULESET_POLL_SECONDS": "2",
            "POOL_RULESET_POLL_SECONDS": "2",
            "SUBMIT_TOKEN": SUBMIT_TOKEN,
            "PYTHON_CONCURRENCY": "1",
            "PYTHON_MAX_TASKS": "3",
            "PYTHON_MAX_MEMORY_MB": "128",
            # the recorded Splunk takes any password
            "SPLUNK_PASSWORD": "ace4-fake-password",
        }.items()
    },
}
ENV.pop("COMPOSE_PROJECT_NAME", None)
COMPOSE = ["docker", "compose", "-f", str(COMPOSE_FILE), "--profile", "e2e"]
SERVICES = ["postgres", "bucket", "ace", "parsers", "lookups", "responder"]


def log(message):
    print(f"e2e: {message}", flush=True)


def compose(*args, check=True, capture=False, exit_code=False):
    result = subprocess.run(
        [*COMPOSE, *args], env=ENV, cwd=COMPOSE_FILE.parent, text=True, capture_output=capture
    )
    if exit_code:
        return result.returncode
    if check and result.returncode != 0:
        raise SystemExit(
            f"e2e: docker compose {' '.join(args)} failed ({result.returncode})\n"
            f"{result.stderr if capture else ''}"
        )
    return result.stdout if capture else ""


def sql(query):
    """Rows of a query against the stack's Postgres, as lists of strings."""
    # the database and user the stack's Compose file gave the postgres service
    out = compose(
        "exec", "-T", "-e", f"QUERY={query}", "postgres", "sh", "-c",
        'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -At -F "\t" -v ON_ERROR_STOP=1 -c "$QUERY"',
        capture=True,
    )
    return [line.split("\t") for line in out.splitlines() if line]


def git(*args):
    subprocess.run(
        ["git", "-C", str(WORK / "signatures"), "-c", "user.name=ace4 e2e",
         "-c", "user.email=e2e@example.invalid", "-c", "commit.gpgsign=false",
         "-c", "init.defaultBranch=main", *args],
        check=True, capture_output=True,
    )


def make_signatures():
    """A repository with tools/ace3/trees/signatures' one fixture rule, the rule ace3's trees
    scanned with, committed. Returns its commit."""
    repo = WORK / "signatures"
    shutil.rmtree(repo, ignore_errors=True)
    shutil.copytree(ROOT / "tools" / "ace3" / "trees" / "signatures", repo / "yara")
    git("init", "-q")
    git("add", ".")
    git("commit", "-q", "-m", "the end-to-end test's rule")
    return subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "HEAD"], check=True, capture_output=True,
        text=True,
    ).stdout.strip()


def submit(email, mode="email", observables=()):
    """Submits a root, with the email as its file if there is one, and returns its uuid."""
    boundary = f"ace4-e2e-{uuid.uuid4().hex}"
    analysis = json.dumps({
        "description": "ace4 end-to-end test",
        "analysis_mode": mode,
        "observables": list(observables),
    })
    body = (
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"analysis\"\r\n\r\n"
        f"{analysis}\r\n"
    ).encode()
    if email is not None:
        body += (
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
            f"filename=\"email.rfc822\"\r\nContent-Type: message/rfc822\r\n\r\n"
        ).encode() + email + b"\r\n"
    body += f"--{boundary}--\r\n".encode()
    request = urllib.request.Request(
        f"http://127.0.0.1:{PORT}/api/analysis/v1/submit",
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {SUBMIT_TOKEN}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        },
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        if response.status != 201:
            raise SystemExit(f"e2e: the submission answered {response.status}")
        return json.load(response)["uuid"]


def wait_for(what, check, within, every=0.25):
    started = time.monotonic()
    while True:
        value = check()
        if value:
            return value
        if time.monotonic() - started > within:
            raise SystemExit(f"e2e: timed out after {within}s waiting for {what}")
        time.sleep(every)


def completed_after(root):
    """Seconds from the root's creation to its first completion, or None."""
    rows = sql(
        f"""SELECT extract(epoch FROM c.completed_at - r.created_at)
            FROM queue.root_completions c JOIN analysis.roots r ON r.id = c.root_id
            WHERE c.root_id = '{root}' ORDER BY c.pass LIMIT 1"""
    )
    return float(rows[0][0]) if rows else None


def tasks(root):
    return sql(
        f"""SELECT t.module, o.type, coalesce(f.path, o.value), t.state::text, t.attempts,
                   coalesce(t.error, '')
            FROM queue.tasks t JOIN analysis.observables o ON o.id = t.observable_id
            LEFT JOIN analysis.files f ON f.observable_id = o.id
            WHERE t.root_id = '{root}' ORDER BY t.id"""
    )


def check_root(root, failures):
    """Checks one root once it completed, adding a line to failures for each check that fails."""

    def expect(ok, message):
        log(("ok    " if ok else "FAIL  ") + message)
        if not ok:
            failures.append(f"{root}: {message}")

    modules = {row[0] for row in sql(
        f"SELECT DISTINCT module FROM analysis.results WHERE root_id = '{root}'"
    )}
    for module in MODULES:
        expect(module in modules, f"{module} has a result")
    mode, alerted, passes = sql(
        f"""SELECT analysis_mode, alerted_at IS NOT NULL, completed_pass = pass
            FROM analysis.roots WHERE id = '{root}'"""
    )[0]
    expect(mode == "correlation" and alerted == "t", "the YARA match made the root an alert")
    expect(passes == "t", "the root's pass completed")
    active = sql(
        f"""SELECT count(*) FROM queue.tasks WHERE root_id = '{root}'
            AND state IN ('queued', 'delayed', 'running')"""
    )[0][0]
    expect(active == "0", "no task is left queued, delayed or running")

    # the rule matched the attachment and not the extracted file, which holds the same marker;
    # a scan that matched nothing ends done with no result
    scans = {row[0]: (row[1], row[2] == "t") for row in sql(
        f"""SELECT f.path, t.state::text, coalesce(r.details::text LIKE '%{RULE}%', false)
            FROM queue.tasks t
            JOIN analysis.files f ON f.observable_id = t.observable_id AND f.root_id = t.root_id
            LEFT JOIN analysis.results r ON r.root_id = t.root_id
              AND r.observable_id = t.observable_id AND r.module = t.module
            WHERE t.root_id = '{root}' AND t.module = 'yara_scanner_v3_4'"""
    )}
    attachment = {p: v for p, v in scans.items() if p.endswith("invoice.zip")}
    extracted = {p: v for p, v in scans.items() if p.endswith("invoice.txt")}
    expect(bool(attachment) and all(v == ("done", True) for v in attachment.values()),
           f"the rule matched the tagged attachment: {attachment}")
    expect(bool(extracted) and all(v == ("done", False) for v in extracted.values()),
           f"the rule didn't match the untagged extracted file, which has the marker: "
           f"{extracted}")
    others = [p for p, v in scans.items() if v[1] and p not in attachment]
    expect(not others, f"the rule matched nothing else: {others}")

    rdap = sql(
        f"""SELECT o.value, r.details->>'lookup_protocol', coalesce(r.details->>'error', '')
            FROM analysis.results r JOIN analysis.observables o ON o.id = r.observable_id
            WHERE r.root_id = '{root}' AND r.module = 'rdap_analyzer'"""
    )
    expect(["example.com", "rdap", ""] in rdap,
           f"RDAP answered for example.com from the recording: {rdap}")
    splunk = sql(
        f"""SELECT o.value, coalesce(r.details->>'error', ''), t.attempts
            FROM analysis.results r JOIN analysis.observables o ON o.id = r.observable_id
            JOIN queue.tasks t ON t.root_id = r.root_id AND t.observable_id = r.observable_id
              AND t.module = r.module
            WHERE r.root_id = '{root}' AND r.module = 'clicker_detection_splunk'"""
    )
    expect(any(row[0] == "example.com" and row[1] == "" for row in splunk),
           f"the Splunk instance answered for example.com: {splunk}")
    delays = sql(
        f"""SELECT count(*) FROM queue.tasks
            WHERE root_id = '{root}' AND module = 'clicker_detection_splunk'
            AND first_delayed_at IS NOT NULL"""
    )[0][0]
    expect(delays != "0", "the Splunk task was delayed before its result")


def normal_form(root):
    """The root's tree in the normal form, as text."""
    return compose("exec", "-T", "ace", ACE_COMMAND, "root", "normal-form", root, capture=True)


def check_normal_form(text, failures):
    """Checks what the form of a root from this test has to say."""

    def expect(ok, message):
        log(("ok    " if ok else "FAIL  ") + message)
        if not ok:
            failures.append(f"the normal form: {message}")

    form = json.loads(text)
    observables = form["observables"]
    modules = {m for o in observables.values() for m in o["results"]}
    expect(modules >= set(MODULES), f"it has results from all five modules: {sorted(modules)}")
    expect(text == json.dumps(form, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
           "its text is what Python's json.dumps writes, so ace3's script can write the same")
    paths = {p: tags for o in observables.values() for p, tags in o.get("paths", {}).items()}
    expect(paths.get("email.rfc822") is not None and any(
        p.endswith("invoice.zip") and "type=email.attachment" in tags for p, tags in paths.items()
    ), f"files keep their paths and yara_meta tags: {sorted(paths)}")
    extracted = [o for o in observables.values()
                 if any(p.endswith("invoice.txt") for p in o.get("paths", {}))]
    expect(len(extracted) == 1 and any(
        r.startswith("extracted_from file:") for r in extracted[0]["relationships"]
    ), "the extracted file says what it was extracted from")
    expect(any(RULE in json.dumps(o["detections"]) or o["detections"]
               for o in observables.values()), "the YARA match's detection is on an observable")
    expect(not re.search(r'"/(tmp|var|opt|home|root|usr|workspace)/', text),
           "it holds no absolute path")
    expect(not re.search(r'"(created_at|completed_at|lease_expires_at|updated_at)"', text),
           "it holds no row timestamp")


def check_python_pool(failures):
    """PLAN.md 4.1's Done check, against the Python pool's image: see this file's docstring."""

    def expect(ok, message):
        log(("ok    " if ok else "FAIL  ") + message)
        if not ok:
            failures.append(f"the Python pool: {message}")

    started = time.monotonic()
    compose("up", "-d", "--build", "--wait", "python")
    actions = ["one", "two", "three", "four", "hold-200", "after", "libraries", "raise"]
    values = [f"{action}.example.com" for action in actions]
    root = submit(None, observables=[{"type": "fqdn", "value": value} for value in values])
    # no mode runs the probe, so the test queues it, in this order; a concurrency of 1 keeps it
    for value in values:
        sql(
            f"""INSERT INTO queue.tasks (root_id, observable_id, module, max_attempts, input_hashes)
                SELECT root_id, id, '{PYTHON_PROBE}', 1, '{{}}' FROM analysis.observables
                WHERE root_id = '{root}' AND value = '{value}'"""
        )
    wait_for(
        "the Python pool's tasks to end",
        lambda: sql(
            f"""SELECT count(*) FROM queue.tasks WHERE root_id = '{root}'
                AND module = '{PYTHON_PROBE}' AND state IN ('queued', 'delayed', 'running')"""
        )[0][0] == "0",
        within=120,
    )
    rows = {row[0]: row[1:] for row in sql(
        f"""SELECT o.value, t.state::text, replace(coalesce(t.error, ''), chr(10), ' '),
                   coalesce(r.details->>'pid', ''), coalesce(r.details->>'tasks_in_process', ''),
                   coalesce(r.details->>'uid', ''), coalesce(r.details->>'note', '')
            FROM queue.tasks t JOIN analysis.observables o ON o.id = t.observable_id
            LEFT JOIN analysis.results r ON r.root_id = t.root_id
              AND r.observable_id = t.observable_id AND r.module = t.module
            WHERE t.root_id = '{root}' AND t.module = '{PYTHON_PROBE}'"""
    )}
    for action, value in zip(actions, values):
        log(f"  {action}: {' | '.join(rows.get(value, ['no task']))[:300]}")

    def field(action, index):
        return rows.get(f"{action}.example.com", [""] * 6)[index]

    pid = lambda action: field(action, 2)  # noqa: E731
    count = lambda action: field(action, 3)  # noqa: E731
    expect(all(field(a, 0) == "done" for a in actions[:-1]), "every task but the last is done")
    expect(pid("one") == pid("two") == pid("three") != "", "the first three ran in one process")
    expect(count("three") == "3", "that process ran three tasks, its limit")
    expect(pid("four") not in ("", pid("three")) and count("four") == "1",
           f"the task after the task count ran on a replacement: {pid('three')} then {pid('four')}")
    expect(pid("hold-200") == pid("four") and count("hold-200") == "2",
           "the replacement held 200 MB on its second task, under the task count")
    expect(pid("after") not in ("", pid("hold-200")) and count("after") == "1",
           "the task after the memory limit ran on a replacement: "
           f"{pid('hold-200')} then {pid('after')}")
    logs = compose("logs", "--no-color", "python", capture=True)
    expect('"task count"' in logs, "the supervisor logged a recycling for the task count")
    expect('"memory limit"' in logs, "the supervisor logged a recycling for the memory limit")
    expect(all(field(a, 4) == "10001" for a in actions[:-1]), "every task ran as ace4-task")
    missing = [lib for lib in PYTHON_LIBRARIES if lib not in field("libraries", 5)]
    expect(not missing, f"a contained worker imports the image's pinned libraries: {missing or 'all'}")
    expect(field("raise", 0) == "failed" and "ValueError" in field("raise", 1),
           "a task that raises leaves a failed row with the error")
    log(f"the Python pool's stage took {time.monotonic() - started:.1f}s")


def compare_with_ace3(threshold=False):
    """Runs `ace compare` over the sample set in a one-off ace container, with the report under
    <work>/compare. Returns its exit code."""
    report = WORK / "compare"
    report.mkdir(parents=True, exist_ok=True)
    # the recorded Splunk job counts requests from when the responder started
    compose("restart", "responder")
    compose("up", "-d", "--wait", "responder")
    command = [
        "run", "--rm", "--no-deps", "--user", f"{os.getuid()}:{os.getgid()}",
        "-v", f"{ROOT / 'samples'}:/compare/samples:ro",
        "-v", f"{TREES}:/compare/trees:ro",
        "-v", f"{report}:/compare/report",
        "ace", ACE_COMMAND, "compare", "--samples", "/compare/samples", "--trees", "/compare/trees",
        "--report", "/compare/report",
    ]
    if threshold:
        command.append("--threshold")
        if os.environ.get("CI"):
            command.append("--allow-absent")
    code = compose(*command, check=False, exit_code=True)
    log(f"the comparison's report is in {report}")
    return code


def run(email, kill, failures):
    """Submits the email and waits for its root to complete. With kill, freezes the parser pool
    first, kills it once it holds a lease, and starts it again. Returns the root and seconds to
    completion."""
    # the recorded Splunk job answers "running" twice and then "done", counting requests from
    # when the responder started, so each run starts it again to see the same answers
    compose("restart", "responder")
    compose("up", "-d", "--wait", "responder")
    if kill:
        compose("pause", "parsers")
    root = submit(email)
    log(f"submitted root {root}{' with the parser pool frozen' if kill else ''}")
    if kill:
        held = wait_for(
            "the frozen parser pool to be given a task",
            lambda: sql(
                f"""SELECT module, lease_owner FROM queue.tasks WHERE root_id = '{root}'
                    AND state = 'running' AND lease_owner LIKE 'parsers/%'"""
            ),
            within=30,
        )
        log(f"the frozen parser pool holds {held}; killing it with SIGKILL")
        compose("kill", "-s", "SIGKILL", "parsers")
        killed_at = time.monotonic()
        compose("up", "-d", "--wait", "parsers")
        log(f"started the parser pool again {time.monotonic() - killed_at:.1f}s after the kill")
    seconds = wait_for(f"root {root} to complete", lambda: completed_after(root), within=300)
    log(f"root {root} completed {seconds:.2f}s after it was created")
    for row in tasks(root):
        log("  task " + " | ".join(row))
    check_root(root, failures)
    if kill:
        taken_back = [r for r in tasks(root) if r[0] in PARSER_MODULES and int(r[4]) >= 2]
        ok = bool(taken_back) and all(r[3] == "done" for r in taken_back)
        log(("ok    " if ok else "FAIL  ")
            + f"the killed pool's task ran again and ended done: {taken_back}")
        if not ok:
            failures.append(f"{root}: the killed pool's task didn't run again")
    return root, seconds


def finish(failures):
    if failures:
        log(f"{len(failures)} check(s) failed:")
        for failure in failures:
            log(f"  {failure}")
        return 1
    log("every check passed")
    return 0


def main(argv):
    keep = "--keep" in argv
    compare_only = "--compare" in argv
    WORK.mkdir(parents=True, exist_ok=True)
    commit = make_signatures()
    log(f"signatures at {WORK / 'signatures'}, commit {commit}")
    compose("up", "-d", "--build", "--wait", *SERVICES)
    failures = []
    try:
        wait_for(
            "the core to build the fixture's ruleset",
            lambda: sql(f"SELECT 1 FROM yara.rulesets WHERE commit = '{commit}'"),
            within=120,
        )
        wait_for(
            "the parser pool to load it",
            lambda: "the first ruleset loaded" in compose("logs", "parsers", capture=True),
            within=60,
        )
        if compare_only:
            if compare_with_ace3() != 0:
                failures.append("ace compare couldn't run every sample; see above")
            return finish(failures)
        email = (ROOT / "samples" / SAMPLE).read_bytes()
        first, undisturbed = run(email, kill=False, failures=failures)
        second, killed = run(email, kill=True, failures=failures)
        log(f"completion: {undisturbed:.2f}s undisturbed, {killed:.2f}s with the parser pool "
            f"killed mid-run (lease {LEASE_SECONDS}s)")
        if killed <= undisturbed:
            failures.append("the run with the kill wasn't slower; did the kill land?")
        form = normal_form(first)
        (WORK / "normal-form.json").write_text(form)
        check_normal_form(form, failures)
        killed_form = normal_form(second)
        (WORK / "normal-form-killed.json").write_text(killed_form)
        if form == killed_form:
            log("ok    both roots have the same normal form, killed pool and all")
        else:
            log("FAIL  the roots' normal forms differ; see normal-form*.json in " + str(WORK))
            failures.append("the same email's two roots have different normal forms")
        if "ACE4_E2E_SITE" not in os.environ:
            check_python_pool(failures)
            if compare_with_ace3(threshold=True) != 0:
                failures.append("the acceptance threshold (docs/acceptance.md) isn't met; see "
                                "above and target/e2e/compare/report.md")
            else:
                log("ok    the acceptance threshold is met: every difference from ace3 is listed "
                    "in differences.md, and every row matched one")
    finally:
        if failures or keep:
            for service in ("ace", "parsers", "lookups", "python", "responder"):
                print(f"----- {service} logs (last 40 lines)")
                print(compose("logs", "--no-color", "--tail", "40", service, capture=True,
                              check=False))
        if not keep:
            compose("down", "-v", "--remove-orphans", check=False)
    return finish(failures)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
