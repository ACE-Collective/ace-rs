          "NetworkMessageId": "6f1d5c2a-0000-4000-8000-000000000001"
        },
        {
          "Timestamp": "2026-11-08T10:02:00Z",
          "AccountUpn": "bob@example.com",
          "ActionType": "ClickBlocked",
          "Url": "https://click.example.com/login"
        }
      ]
    },
    {
      "match": [
        "index=ace_rs_proxy",
