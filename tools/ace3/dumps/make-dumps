@contextlib.contextmanager
def fake_clicker_splunk(fake_dir, job_args, query_timeout):
    """fake_splunk.py over the clicker rows, with the config that points ace3's clicker module at it."""
    docker("exec", CONTAINER, "mkdir", "-p", f"{fake_dir}/http")
    base = SPLUNK_CONFIG.format(port=SPLUNK_PORT, query_timeout="")
    base = base[: base.index("analysis_module_proxy_domain_lookup:")]
    timeout_line = f"  query_timeout: {query_timeout}\n" if query_timeout is not None else ""
    section = CLICKER_SECTION.format(config_path=f"{REMOTE}/fixtures/clicker/clicker_detection.yaml",
                                     query_timeout=timeout_line)
    put(f"{fake_dir}/saq.ace4_fake.yaml", (base + section).encode())
    docker(
        "exec", "-d", CONTAINER, "sh", "-c",
        f'exec /venv/bin/python3 -I {REMOTE}/fake_splunk.py --rows {REMOTE}/fixtures/splunk/clicker_rows.json '
        f'--cert {REMOTE}/fake/cert.pem --key {REMOTE}/fake/key.pem --port {SPLUNK_PORT} '
        f'--record {fake_dir}/http --pid-file {fake_dir}/pid {" ".join(job_args)} 2> {fake_dir}/fake.log',
    )
    try:
        for _ in range(100):
            if docker("exec", CONTAINER, "test", "-e", f"{fake_dir}/pid", check=False).returncode == 0:
                break
            time.sleep(0.1)
        else:
            log = docker("exec", CONTAINER, "cat", f"{fake_dir}/fake.log", check=False).stdout.decode(errors="replace")
            raise SystemExit(f"fake_splunk.py did not start:\n{log}")
        yield
    finally:
        docker("exec", CONTAINER, "sh", "-c", f'kill "$(cat {fake_dir}/pid)" 2>/dev/null || true', check=False)


