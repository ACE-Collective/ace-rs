def pcap_decryption_runs():
    """The decryption, with pcap_analyzer, on a capture whose root also holds a key log, as an archive
    of both does: the key log is the root's other file (--extracted-from), which the module finds by
    its content."""
    samples = {s["path"]: s for s in pcap_samples()}
    runs = []
    for path, keylog in PCAP_DECRYPTIONS:
        sample = samples[path]
        args = ["--file", f"{REMOTE}/samples/{path}", "--alert-path", sample["alert_path"]]
        args += [arg for tag in sample["meta_tags"] for arg in ("--meta-tag", tag)]
        name = path
        if keylog is not None:
            args += ["--extracted-from", f"{REMOTE}/samples/{keylog}", keylog.rsplit("/", 1)[-1]]
            name = f"{path}.with_{keylog.rsplit('/', 1)[-1]}"
        runs.append({
            "module": "pcap_tls_decryption",
            "enable": ["pcap_analyzer"],
            "name": name,
            "args": args,
            "label": path if keylog is None else f"{path} with {keylog}",
        })
    return runs


