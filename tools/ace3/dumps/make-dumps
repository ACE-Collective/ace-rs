def email_tree_runs():
    """The email-tree modules on each email sample, each run keeping the whole root (run_module.py
    --tree-view): the lure module, alone, with a settings file, with settings for the context of a
    link, and without pdf_link_text; the mailbox module on a mailbox
    alert and on another; the attachment module with no sender seen before and with the macro email's
    sender seen; and the link module with two patterns, one that doesn't compile, and with one that
    matches nothing."""
    runs = []
    configs = f"{REMOTE}/fixtures/emailtree"

    def add(module, sample, suffix="", args=(), label="", enable=EMAIL_TREE_ENABLE):
        runs.append({
            "module": module,
            "enable": [m for m in enable if m != module],
            "name": sample["path"] + suffix,
            "args": ["--file", f"{REMOTE}/samples/{sample['path']}", "--alert-path", sample["alert_path"],
                     "--tree-view", *args],
            "label": sample["path"] + label,
            "service": write_email_tree_configs,
            # lnk_parser and rtfole run the virtualenv's programs, as in make-trees
            "env": [VENV_PATH, "PYTHONHASHSEED=0"],
        })

    emails = [s for s in manifest_samples("email") if not s["path"].startswith("local/")]
    frequency = [*EMAIL_TREE_ENABLE, "email_conversation_frequency_analyzer"]
    for sample in emails:
        add("lure_url_analyzer", sample)
        add("mailbox_email_analyzer", sample, args=["--alert-type", "mailbox", "--directive", "original_email"],
            label=" as a mailbox alert", enable=["file_type", "email_analyzer"])
        if any(k.startswith("office/") for k in sample["kinds"]):
            add("email_conversation_attachment_analyzer", sample, args=["--brocess", f"{configs}/empty.json"],
                label=", no sender seen before", enable=frequency)
        if sample["path"].endswith("/lure_button.email.rfc822") or sample["path"].endswith("/lure_forward.email.rfc822"):
            add("email_conversation_link_analyzer", sample,
                args=["--brocess", f"{configs}/empty.json", "--config", f"{configs}/link.yaml"],
                label=", no sender seen before, with url_pattern_lure", enable=frequency)
    by_path = {s["path"]: s for s in emails}
    lure_button = by_path["ace4/email/lure_button.email.rfc822"]
    add("lure_url_analyzer", lure_button, ".settings", ["--config", f"{configs}/lure.yaml"], " with a settings file")
    for name in ("lure_thread", "lure_thread_text", "lure_signature", "lure_not_a_signature", "lure_pdf_link"):
        sample = by_path[f"ace4/email/{name}.email.rfc822"]
        add("lure_url_analyzer", sample, ".context", ["--config", f"{configs}/lure_context.yaml"],
            " with the context settings")
    for name in ("lure_signature", "lure_pdf_link"):
        sample = by_path[f"ace4/email/{name}.email.rfc822"]
        add("lure_url_analyzer", sample, ".no_reference", ["--config", f"{configs}/lure_no_reference.yaml"],
            " with no sign-off phrases and no attachment phrases")
    # the PDF's links without pdf_link_text, as in an alert analyzed with it disabled
    add("lure_url_analyzer", by_path["ace4/email/lure_pdf_link.email.rfc822"], ".no_link_text",
        label=" without pdf_link_text", enable=[m for m in EMAIL_TREE_ENABLE if m != "pdf_link_text"])
    add("mailbox_email_analyzer", lure_button, ".cli", ["--directive", "original_email"], " as a cli alert",
        enable=["file_type", "email_analyzer"])
    add("email_conversation_attachment_analyzer", by_path["ace4/email/macro_attachment.email.rfc822"], ".known_sender",
        ["--brocess", f"{REMOTE}/fixtures/brocess/smtplog.json"], ", its sender seen before", enable=frequency)
    add("email_conversation_link_analyzer", lure_button, ".known_sender",
        ["--brocess", f"{configs}/lure_sender.json", "--config", f"{configs}/link.yaml"],
        ", its sender seen before, with url_pattern_lure", enable=frequency)
    add("email_conversation_link_analyzer", by_path["ace4/email/lure_protected.email.rfc822"], ".nothing",
        ["--brocess", f"{configs}/empty.json", "--config", f"{configs}/link_nothing.yaml"],
        ", with a pattern that matches nothing", enable=frequency)
    return runs


