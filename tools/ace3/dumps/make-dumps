@contextlib.contextmanager
def logger_store(path, previous, minute):
    """Puts the brocess the run starts with at `path`: the one the previous run left, or the seed."""
    if previous is None:
        store = json.loads((HERE / "fixtures" / "email_logger" / "seed.json").read_text())
        store.pop("about", None)
    else:
        store = json.loads((OUT / "email_logger" / f"{previous}.json").read_text())["brocess_after"]
    store["now"] = f"2026-11-08 10:{minute:02d}:00"
    put(path, json.dumps(store).encode())
    yield


def logger_runs():
    runs = []
    for sample in manifest_samples("email"):
        runs.append({
            "module": "email_logger",
            "enable": ["email_analyzer", "file_type"],
            "name": sample["path"],
            "args": ["--file", f"{REMOTE}/samples/{sample['path']}", "--alert-path", sample["alert_path"],
                     "--brocess-store", f"{REMOTE}/fixtures/email_logger/empty.json", *LOGGER_ARGS]
            + [arg for tag in sample["meta_tags"] for arg in ("--meta-tag", tag)],
            "label": f"{sample['path']}, against an empty brocess",
        })
    previous = None
    for minute, name in enumerate(LOGGER_THREAD):
        store = f"{REMOTE}/runs/email_logger-{name}.store.json"
        runs.append({
            "module": "email_logger",
            "enable": ["email_analyzer", "file_type"],
            "name": f"thread/{name}",
            "args": ["--file", f"{REMOTE}/fixtures/email_logger/{name}.email.rfc822",
                     "--alert-path", f"{name}.email.rfc822", "--brocess-store", store, *LOGGER_ARGS],
            "label": f"fixtures/email_logger/{name}.email.rfc822, against the brocess "
            + (f"thread/{previous} left" if previous else "of fixtures/email_logger/seed.json"),
            "service": lambda store=store, previous=(f"thread/{previous}" if previous else None), minute=minute:
                logger_store(store, previous, minute),
        })
        previous = name
    return runs


