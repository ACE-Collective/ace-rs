@contextlib.contextmanager
def nrd_reference(config, age, first):
    """Runs nrd_reference.py once, before the first run, and writes the run's settings."""
    if first:
        put(f"{REMOTE}/nrd_reference.py", (HERE / "nrd_reference.py").read_bytes())
        out = f"{REMOTE}/runs/nrd/reference.json"
        result = subprocess.run(
            ["docker", "exec", "-e", "PYTHONDONTWRITEBYTECODE=1", "-e", "SAQ_SKIP_LOCAL_SAQ_YAML=1",
             "-e", "NO_PROXY=127.0.0.1,localhost", "-e", "no_proxy=127.0.0.1,localhost", CONTAINER,
             "/venv/bin/python3", f"{REMOTE}/nrd_reference.py", "--work", f"{REMOTE}/runs/nrd/work",
             "--fixtures", f"{REMOTE}/fixtures/nrd", "--out", out, "--db", NRD_DB],
            capture_output=True,
        )
        if result.returncode != 0:
            sys.stderr.write(result.stderr.decode(errors="replace"))
            raise SystemExit("nrd_reference.py failed")
        target = OUT / "nrd" / "reference.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(docker("exec", CONTAINER, "cat", out).stdout)
    put(config, NRD_CONFIG.format(db=NRD_DB, age=age).encode())
    yield


def nrd_runs():
