FILLER = "".join(hashlib.sha256(str(i).encode()).hexdigest() for i in range(35))[:1100]


def encrypted_runs():
    """Each file attached to an email made by run_module.py, whose body gives its password, another,
    none, or nothing a password could be, or no body; and some alone, with no email. A dump is named
    <fixture>.<body>, or <fixture> for a file alone."""
    runs = []
    bodies = {}

    def add(fixture, kind=None, body=None, suffix=".txt"):
        folder, name = fixture.split("/")
        args = ["--file", f"{REMOTE}/fixtures/encrypted/{fixture}", "--alert-path", name]
        label = f"fixtures/encrypted/{fixture}"
        if kind is not None:
            if body is None:
                args += ["--carrying-email", "-"]
            else:
                body_file = f"{fixture.replace('/', '_')}.{kind}{suffix}"
                bodies[body_file] = body
                args += ["--carrying-email", f"{REMOTE}/fixtures/encrypted/bodies/{body_file}"]
            label += f" attached to an email, body {kind}"
        runs.append({
            "module": ENCRYPTED_MODULES[folder],
            "enable": ["email_analyzer", "file_type"] if kind is not None else [],
            "name": fixture + (f".{kind}" if kind else ""),
            "args": args,
            "label": label,
            "service": lambda: write_bodies(bodies),
        })

    for fixture, passwords in ENCRYPTED_PASSWORDS.items():
        add(fixture, "right", "The password for the attached file is " + " and ".join(passwords) + " thanks\n")
    for fixture, owner in OWNER_PASSWORDS.items():
        add(fixture, "owner", f"The password for the attached file is {owner} thanks\n")
    add("pdf/aes_256.pdf", "owner_and_user", "The passwords are OwnerPw4 and Aes256Us\n")
    for fixture in ("zip/zipcrypto.zip", "rar/rar5.rar", "pdf/aes_128.pdf"):
        add(fixture, "wrong", "The password for the attached file is Wr0ngOne thanks\n")
        add(fixture, "nothing", "a b c d\n")
        add(fixture, "no_body")
        add(fixture)
    add("zip/zipcrypto.zip", "html", "<html><body><p>Use <b>Secr3tPw</b></p></body></html>\n", ".html")
    # ace3's 1998ca56 reads every body part: the password in the text part where the HTML one, which
    # EmailAnalysis.body picks, says nothing of it; an HTML part that repeats the text one, read once;
    # and two long parts, each cut at byte_limit
    for fixture, password in (("zip/zipcrypto.zip", "Secr3tPw"), ("rar/rar5.rar", "Rar5Pass"),
                              ("pdf/aes_128.pdf", ENCRYPTED_PASSWORDS["pdf/aes_128.pdf"][0])):
        add(fixture, "text_part", f"The password is {password} thanks\n--html--\n"
            "<html><body><p>See the attached file.</p></body></html>\n", ".both")
    add("zip/zipcrypto.zip", "repeated", "Use Secr3tPw to open it\n--html--\n"
        "<html><body><p>Use Secr3tPw to open it</p></body></html>\n", ".both")
    add("zip/zipcrypto.zip", "long_parts", LONG_BODY + "--html--\n<html><body><p>" + LONG_BODY + "</p></body></html>\n",
        ".both")
    add("zip/zipcrypto.zip", "long", LONG_BODY)
    add("zip/zipcrypto.zip", "full_early", "Secr3tPw" + FILLER + "\n")
    add("zip/zipcrypto.zip", "full_late", FILLER[:1000] + "Secr3tPw" + FILLER[1000:] + "\n")
    add("rar/rar4_headers.rar")
    add("pdf/owner_only.pdf")
    # the samples each module takes, alone
    for sample in manifest_samples(""):
        kinds = sample["kinds"]
        if "email" in kinds:
            continue
        if "archive/zip" in kinds:
            module = "zip_encryption_analyzer"
        elif "archive/rar" in kinds:
            module = "rar_encryption_analyzer"
        elif "pdf" in kinds and "/encrypted" in sample["path"]:
            module = "pdf_encryption_analyzer"
        else:
            continue
        runs.append({
            "module": module,
            "enable": [],
            "name": sample["path"],
            "args": ["--file", f"{REMOTE}/samples/{sample['path']}", "--alert-path", sample["alert_path"]]
            + [arg for tag in sample["meta_tags"] for arg in ("--meta-tag", tag)],
            "label": sample["path"],
        })
    return runs


