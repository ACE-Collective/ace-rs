@contextlib.contextmanager
def fake_dns(fake_dir):
    """Runs fake_dns.py in the container over the zone fixture, recording to fake_dir/dns.json."""
    docker("exec", CONTAINER, "mkdir", "-p", fake_dir)
    record = f"{fake_dir}/dns.json"
    docker(
        "exec", "-d", CONTAINER, "sh", "-c",
        f"exec /venv/bin/python3 -I {REMOTE}/fake_dns.py --zone {REMOTE}/fixtures/dns/zone.json "
        f"--port {DNS_PORT} --record {record} --pid-file {fake_dir}/dns.pid 2> {fake_dir}/dns.log",
    )
    try:
        for _ in range(100):
            if docker("exec", CONTAINER, "test", "-e", f"{fake_dir}/dns.pid", check=False).returncode == 0:
                break
            time.sleep(0.1)
        else:
            log = docker("exec", CONTAINER, "cat", f"{fake_dir}/dns.log", check=False).stdout.decode(errors="replace")
            raise SystemExit(f"fake_dns.py did not start:\n{log}")
        yield
    finally:
        docker("exec", CONTAINER, "sh", "-c", f'kill "$(cat {fake_dir}/dns.pid)" 2>/dev/null || true', check=False)


