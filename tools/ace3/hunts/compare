#!/usr/bin/env python3
"""6.2's Done check over the signatures: ace-rs loads every hunt in the signatures checkout and diffs
the result with what ace3's loader made of it (PLAN.md step 6.2).

    tools/ace3/hunts/compare

It runs crates/ace-hunt's load_hunts example in a one-off `dev` container of ace-rs's stack, with
the signatures checkout bind-mounted read only at /opt/ace/signatures, the path ace3's container
reads it from, against reference/signatures.json, which make-hunts wrote from ace3. That file holds the hunts'
own text, which belongs to the signatures repository, so it's git-ignored: run make-hunts once
before this, in ace3's dev container. It prints each
difference no `signatures` row of differences.md explains and each such row that explains none, and
exits 1 if there are any. ace3 needn't be running.

ACE_RS_ACE3_CHECKOUT is ace3's checkout on the host (default: ../ace3 beside this checkout), as for
tools/ace3/yara/compare-scan, and the signatures are its signatures/. Compose reads ACE_RS_STACK and the other ACE_RS_ variables as usual. The checkout must
be at the commit reference/signatures.json records (`root_commit`); rerun make-hunts when it moves.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
SIGNATURES = (Path(os.environ.get("ACE_RS_ACE3_CHECKOUT", REPO.parent / "ace3")) / "signatures").resolve()


def main():
    path = HERE / "reference" / "signatures.json"
    if not path.exists():
        raise SystemExit(f"{path} isn't here; it's git-ignored: run tools/ace3/hunts/make-hunts first")
    reference = json.loads(path.read_text())
    head = subprocess.run(["git", "-C", str(SIGNATURES), "log", "-1", "--format=%H"],
                          capture_output=True, text=True).stdout.strip()
    if head != reference["root_commit"]:
        raise SystemExit(f"the signatures checkout is at {head or 'no commit'}, "
                         f"reference/signatures.json at {reference['root_commit']}: rerun make-hunts")
    command = [
        "docker", "compose", "run", "--rm", "--no-deps", "-T",
        "-v", f"{SIGNATURES}:/opt/ace/signatures:ro",
        "dev", "cargo", "run", "--locked", "--quiet", "-p", "ace-hunt", "--example", "load_hunts", "--",
        "--root", "/opt/ace/signatures",
        "--rule-dir", "splunk=hunts/splunk", "--rule-dir", "logscale=hunts/logscale",
        "--reference", "tools/ace3/hunts/reference/signatures.json",
        "--differences", "tools/ace3/hunts/differences.md", "--set", "signatures",
    ]
    return subprocess.run(command, cwd=REPO).returncode


if __name__ == "__main__":
    sys.exit(main())
