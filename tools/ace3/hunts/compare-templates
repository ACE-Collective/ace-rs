#!/usr/bin/env python3
"""6.3's Done check over the signatures: ace4 renders every template of every hunt in the
signatures checkout and diffs the results with what ace3's Jinja rendered (PLAN.md step 6.3).

    tools/ace3/hunts/compare-templates

It runs crates/ace-hunt's render_templates example in a one-off `dev` container of ace4's stack,
with the signatures checkout bind-mounted read only at /opt/ace/signatures, against
reference/templates-signatures.json, which make-templates wrote from ace3. That file holds the
hunts' own text and the events each template rendered against, so it's git-ignored: run
`make-templates signatures` once before this, in ace3's dev container. It prints each difference no
`templates-signatures` row of differences.md explains and each such row that explains none, and
exits 1 if there are any. ace3 needn't be running.

ACE4_ACE3_CHECKOUT is ace3's checkout on the host (default: ../ace3 beside this checkout), and the
signatures are its signatures/. The checkout must be at the commit the reference records
(`root_commit`); rerun make-templates when it moves.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[3]
HERE = Path(__file__).resolve().parent
SIGNATURES = (Path(os.environ.get("ACE4_ACE3_CHECKOUT", REPO.parent / "ace3")) / "signatures").resolve()


def main():
    path = HERE / "reference" / "templates-signatures.json"
    if not path.exists():
        raise SystemExit(f"{path} isn't here; it's git-ignored: run tools/ace3/hunts/make-templates signatures first")
    with open(path) as fp:
        root_commit = json.load(fp)["root_commit"]
    head = subprocess.run(["git", "-C", str(SIGNATURES), "log", "-1", "--format=%H"],
                          capture_output=True, text=True).stdout.strip()
    if head != root_commit:
        raise SystemExit(f"the signatures checkout is at {head or 'no commit'}, "
                         f"reference/templates-signatures.json at {root_commit}: rerun make-templates")
    command = [
        "docker", "compose", "run", "--rm", "--no-deps", "-T",
        "-v", f"{SIGNATURES}:/opt/ace/signatures:ro",
        "dev", "cargo", "run", "--locked", "--quiet", "-p", "ace-hunt", "--example", "render_templates", "--",
        "--root", "/opt/ace/signatures",
        "--rule-dir", "splunk=hunts/splunk", "--rule-dir", "logscale=hunts/logscale",
        "--rule-dir", "rapid7=hunts/rapid7",
        "--reference", "tools/ace3/hunts/reference/templates-signatures.json",
        "--differences", "tools/ace3/hunts/differences.md", "--set", "templates-signatures",
    ]
    return subprocess.run(command, cwd=REPO).returncode


if __name__ == "__main__":
    sys.exit(main())
