#!/usr/bin/env python3
"""Write what ace3's Splunk hunter submits for the hunts in tools/ace3/hunts/query (PLAN.md step 6.4).

    tools/ace3/hunts/make-query-hunts

run_query_hunts.py runs in ace3's dev container (ace-dev-1) with the cases, hunts written for this
comparison and the ticks each one runs at in runs.yaml, and tools/ace3/dumps/fake_splunk.py as the
Splunk they search. It writes reference/query.json: for each tick, every exchange with the fake,
the submissions ace3's hunter staged, the hunt's state after it, and its suppression decisions
(step 6.5): the groups a suppression dropped and the staged submissions ace3's collector would drop
as duplicates. ace4's side is `ace_app::hunter`'s test, which replays those exchanges to ace4's
hunter, diffs its submissions, searches and state with these, and records each run in a test
database, where its suppression rows must be these decisions.

Everything happens under /tmp/ace4-dumps/query in the container, and nothing reaches ace3's
database: the hunter's file manager is replaced by one that records what it would stage. The cases
are made up, so the output is committed. Rerun this when ace3 moves (PLAN.md decision 14).
"""

import os
import subprocess
import sys
from pathlib import Path

CONTAINER = os.environ.get("ACE4_ACE3_CONTAINER", "ace-dev-1")
REMOTE = "/tmp/ace4-dumps/query"
HERE = Path(__file__).resolve().parent
OUT = HERE / "reference" / "query.json"


def docker(*args, stdin=None, check=True):
    return subprocess.run(["docker", *args], input=stdin, capture_output=True, check=check)


def put_tree(source, target):
    # /tmp in the container is a tmpfs, which `docker cp` can't write to, so a tar stream
    files = sorted(str(p.relative_to(source)) for p in source.rglob("*") if p.is_file() and p.name != ".DS_Store")
    archive = subprocess.run(
        ["tar", "--no-xattrs", "-C", str(source), "-cf", "-", *files],
        capture_output=True, check=True, env={**os.environ, "COPYFILE_DISABLE": "1"},
    ).stdout
    docker("exec", CONTAINER, "mkdir", "-p", target)
    docker("exec", "-i", CONTAINER, "tar", "-C", target, "-xf", "-", stdin=archive)


def main():
    docker("exec", CONTAINER, "rm", "-rf", REMOTE)
    try:
        put_tree(HERE / "query", f"{REMOTE}/cases")
        docker("exec", "-i", CONTAINER, "sh", "-c", f"cat > {REMOTE}/fake_splunk.py",
               stdin=(HERE.parent / "dumps" / "fake_splunk.py").read_bytes())
        script = (HERE / "run_query_hunts.py").read_bytes()
        result = docker(
            "exec", "-i", "-e", "PYTHONDONTWRITEBYTECODE=1", "-e", "SAQ_SKIP_LOCAL_SAQ_YAML=1", CONTAINER,
            "/venv/bin/python3", "-", "--work", f"{REMOTE}/work", "--cases", f"{REMOTE}/cases",
            "--fake", f"{REMOTE}/fake_splunk.py", stdin=script, check=False,
        )
        if result.returncode != 0:
            sys.stderr.write(result.stderr.decode(errors="replace"))
            raise SystemExit("run_query_hunts.py failed")
        OUT.parent.mkdir(exist_ok=True)
        OUT.write_bytes(docker("exec", CONTAINER, "cat", f"{REMOTE}/work/submissions.json").stdout)
        print(f"wrote {OUT}")
    finally:
        docker("exec", CONTAINER, "rm", "-rf", REMOTE, check=False)


if __name__ == "__main__":
    main()
