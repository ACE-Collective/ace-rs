#!/usr/bin/env python3
"""Check docs/modules.md, the module inventory (PLAN.md 7.1), against ace3's config.

It reads etc/saq.default.yaml at a commit of ace3's checkout with `git show`, which writes nothing
there, and fails when the inventory's table of modules:

- misses an `analysis_module_*` section, or names a module that no section has;
- gives a module a class other than the section's python_class, or groups or modes other than
  the config's module_group_* and analysis_mode_* sections give it;
- gives a module no pool or step from the inventory's lists, or a 7.5 batch the list of batches
  doesn't have, or a batch list that disagrees with the table;
- names a crate as ace4's that crates/ace doesn't register, or misses one it does, or names
  ace-core, where the core runs a module as a hook (PLAN.md 7.6), for a module off the core's pool;
- disagrees with a module's entry below it, or with its own counts.

And it finds the modules that read or write ACE's own data (PLAN.md 7.2) in ace3's code at the same
commit, and fails when the inventory's "What 7.2 serves" table misses one or lists one it doesn't
find, when a row names nothing to serve it, or a read crates/ace-core/src/reads.md doesn't have, or
`core` for a module off the core's pool, and when reads.md lists a read no row names (a read served
for a site integration's module is named in SITE_READS instead).

And it finds the modules that start a process (PLAN.md 7.3) the same way, and fails when the
inventory's "Modules that start a process" table misses one, when a row has no decision or
decisions other than those of the "Tools" rows that name it, when a decision doesn't fit the
module's pool (the sandbox runner needs the sandbox pool, or a ported module whose tool comes
later; a scanner the scanner pool), or when a tool has no decision or names a module with no row.

    tools/ace3/modules/check                  at the commit ace4 follows
    tools/ace3/modules/check --commit HEAD    at ace3's head, when a checkpoint brings ace4 up to it
    tools/ace3/modules/check --commit f72f894 at another commit
    tools/ace3/modules/check --allow-absent   exits 0 with a SKIP when there's no checkout (CI)

ace4 follows ace3 at checkpoints, not at every commit (PLAN.md decision 14): the commit it follows
is the one the trees were made at, tools/ace3/trees/reference/index.json's `ace3_commit`. Checked
there, ace3's checkout moving doesn't fail a step that changed nothing ace3 has. When the checkout
is past that commit, a note says by how many commits.

ACE4_ACE3_CHECKOUT is ace3's checkout on the host (default: ../ace3 beside this checkout, or
~/Development/public/ace3). Exits 0 when every check passes. Needs only python3 and git.
"""

import argparse
import json
import ast
import collections
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[3]
DOC = REPO / "docs" / "modules.md"
READS = REPO / "crates" / "ace-core" / "src" / "reads.md"
# the ace3 commit ace4 follows: the one tools/ace3/trees/make-trees made the trees at
FOLLOWED = REPO / "tools" / "ace3" / "trees" / "reference" / "index.json"
POOLS = ["parser", "lookup", "core", "sandbox", "scanner"]
STEPS = ["done", "7.4", "7.5", "7.6", "7.7", "7.8", "7.9", "7.10", "owner"]
# ace3's SplunkAPIAnalyzer has no section of its own in saq.default.yaml: sites run it as
# instances, as tests/e2e/site/overlay.yaml does
REGISTERED_WITHOUT_A_SECTION = {"ace-mod-splunk"}
# the core runs a core-pool module as one of its hooks (PLAN.md 7.6, crates/ace-core/src/hooks.rs),
# so it's in the core's crate rather than a crate crates/ace registers
CORE_CRATE = "ace-core"
ROW = re.compile(
    r"^\| `(?P<name>[a-z0-9_]+)` \| `(?P<cls>[A-Za-z0-9_]+)` \| (?P<ace4>not yet|`[a-z0-9-]+`) "
    r"\| (?P<pool>[^|]+) \| (?P<step>[^|]+) \| (?P<groups>[^|]+) \| (?P<modes>[^|]+) \|$"
)


def checkout():
    if "ACE4_ACE3_CHECKOUT" in os.environ:
        candidates = [Path(os.environ["ACE4_ACE3_CHECKOUT"])]
    else:
        candidates = [REPO.parent / "ace3", Path.home() / "Development" / "public" / "ace3"]
    for candidate in candidates:
        if (candidate / "etc" / "saq.default.yaml").exists():
            return candidate
    return None


def git(ace3, *args):
    return subprocess.run(["git", "-C", str(ace3), *args], check=True, capture_output=True,
                          text=True).stdout


def sections(text):
    """The config's top-level sections, each as its own lines, in order."""
    out, name = {}, None
    for line in text.splitlines():
        top = re.match(r"^([A-Za-z0-9_]+):", line)
        if top:
            name = top.group(1)
            out[name] = []
        elif name is not None:
            out[name].append(line)
    return out


def fields(lines):
    """A section's two-space keys, each a scalar or a list (block or inline)."""
    out, key = {}, None
    for line in lines:
        if line.lstrip().startswith("#") or not line.strip():
            continue
        field = re.match(r"^  ([A-Za-z0-9_]+):\s*(.*?)\s*(#.*)?$", line)
        item = re.match(r"^\s+- (.*?)\s*$", line)
        if field:
            key, value = field.group(1), field.group(2)
            if value.startswith("[") and value.endswith("]"):
                out[key] = [v.strip() for v in value[1:-1].split(",") if v.strip()]
            else:
                out[key] = value if value else []
        elif item and key is not None and isinstance(out.get(key), list):
            out[key].append(item.group(1))
    return out


def config(text):
    """{module: (class, groups, modes)} from ace3's config."""
    found = {k: fields(v) for k, v in sections(text).items()}
    groups = {f["name"]: f.get("modules", []) for k, f in found.items()
              if k.startswith("module_group_")}
    modes = {f["name"]: f for k, f in found.items() if k.startswith("analysis_mode_")}
    out = {}
    for key, f in found.items():
        if not key.startswith("analysis_module_"):
            continue
        name = key[len("analysis_module_"):]
        if f.get("name") != name:
            sys.exit(f"modules: {key} names itself {f.get('name')!r}; the check expects its key")
        in_groups = sorted(g for g, members in groups.items() if name in members)
        in_modes = sorted(
            m for m, mode in modes.items()
            if set(mode.get("module_groups") or []) & set(in_groups)
            or name in (mode.get("enabled_modules") or [])
        )
        out[name] = (f.get("python_class"), in_groups, in_modes)
    return out


def registered():
    """The ace_mod_* crates crates/ace registers."""
    text = (REPO / "crates" / "ace" / "src" / "lib.rs").read_text()
    return {"ace-mod-" + m.replace("_", "-") for m in re.findall(r"ace_mod_([a-z0-9_]+)::", text)}


def listed(cell):
    return [] if cell.strip() == "-" else [x.strip() for x in cell.split(",")]


def check_doc(doc, ace3, failures):
    """Checks the table against ace3's config and the rest of the doc against the table."""
    rows, seen = {}, collections.Counter()
    table = doc.split("\n## Modules\n", 1)[1].split("\n## ", 1)[0]
    for line in table.splitlines():
        if line.startswith("| `"):
            match = ROW.match(line)
            if not match:
                failures.append(f"a row of the table doesn't parse: {line}")
                continue
            seen[match["name"]] += 1
            rows[match["name"]] = match
    for name, count in seen.items():
        if count > 1:
            failures.append(f"{name} has {count} rows")
    for name in sorted(set(ace3) - set(rows)):
        failures.append(f"analysis_module_{name} has no row")
    for name in sorted(set(rows) - set(ace3)):
        failures.append(f"{name} has a row and no section in ace3's config")

    batches = re.findall(r"^(\d+)\. \*\*[^*]+\*\*: (.+)$", doc.split("\n## 7.5's batches\n", 1)[1]
                         .split("\n## ", 1)[0], re.M)
    in_batch = {}
    for number, line in batches:
        for name in re.findall(r"`([a-z0-9_]+)`", line.split(". ", 1)[0]):
            in_batch[name] = int(number)
    if [int(n) for n, _ in batches] != list(range(1, len(batches) + 1)):
        failures.append("7.5's batches aren't numbered 1 to n")

    crates = registered()
    named = set()
    for name, row in rows.items():
        cls, groups, modes = ace3.get(name, (None, None, None))
        if cls is not None and row["cls"] != cls:
            failures.append(f"{name}: the class is {row['cls']}, and ace3's config says {cls}")
        if groups is not None and listed(row["groups"]) != groups:
            failures.append(f"{name}: groups {row['groups'].strip()}, and ace3's config says "
                            f"{', '.join(groups) or '-'}")
        if modes is not None and listed(row["modes"]) != modes:
            failures.append(f"{name}: modes {row['modes'].strip()}, and ace3's config says "
                            f"{', '.join(modes) or '-'}")
        pool, step = row["pool"].strip(), row["step"].strip()
        if pool not in POOLS:
            failures.append(f"{name}: pool {pool!r} isn't one of {', '.join(POOLS)}")
        batch = re.fullmatch(r"7\.5 batch (\d+)", step)
        if batch:
            if int(batch.group(1)) > len(batches):
                failures.append(f"{name}: 7.5 has no batch {batch.group(1)}")
            if in_batch.get(name) != int(batch.group(1)):
                failures.append(f"{name}: the table says {step}, and 7.5's batches say "
                                f"{in_batch.get(name)}")
        elif step not in STEPS or step == "7.5":
            failures.append(f"{name}: step {step!r} isn't one of {', '.join(STEPS)} or a 7.5 batch")
        elif name in in_batch:
            failures.append(f"{name}: 7.5's batch {in_batch[name]} has it, and the table says {step}")
        crate = row["ace4"].strip("`") if row["ace4"] != "not yet" else None
        if crate == CORE_CRATE:
            if pool != "core":
                failures.append(f"{name}: ace4 {CORE_CRATE} is for a module on the core's pool")
            if f"`{name}`" not in (REPO / "crates" / "ace-core" / "src" / "hooks.rs").read_text():
                failures.append(f"{name}: crates/ace-core/src/hooks.rs doesn't run it")
        elif crate:
            named.add(crate)
            if crate not in crates:
                failures.append(f"{name}: crates/ace doesn't register {crate}")
        if (crate is not None) != (step == "done"):
            failures.append(f"{name}: ace4 {row['ace4']} with step {step}")

        entry = re.search(rf"^### {name}\n(.*?)(?=^### |^## |\Z)", doc, re.M | re.S)
        if not entry:
            failures.append(f"{name} has no entry")
            continue
        body = entry.group(1)
        if not re.search(rf"^- \*\*Pool\*\*: {re.escape(pool)}\. ", body, re.M):
            failures.append(f"{name}: its entry's pool isn't the table's {pool}")
        ace4 = f"ported in `{crate}`" if crate else "not yet"
        if f"- **ace4**: {ace4}." not in body:
            failures.append(f"{name}: its entry's ace4 isn't the table's {row['ace4']}")
        if not re.search(rf"^- \*\*Step\*\*: {re.escape(step)}[ .]", body, re.M):
            failures.append(f"{name}: its entry's step isn't the table's {step}")
        if cls is not None and f"class `{cls}`" not in body:
            failures.append(f"{name}: its entry's class isn't {cls}")
    for crate in sorted(crates - named - REGISTERED_WITHOUT_A_SECTION):
        failures.append(f"crates/ace registers {crate}, and no module's row names it")
    for name in sorted(set(in_batch) - set(rows)):
        failures.append(f"7.5's batches name {name}, which has no row")

    pools = collections.Counter(r["pool"].strip() for r in rows.values())
    ported = collections.Counter(r["pool"].strip() for r in rows.values() if r["ace4"] != "not yet")
    steps = collections.Counter(r["step"].strip().split(" batch")[0] for r in rows.values())
    for pool in POOLS:
        want = f"| {pool} | {pools[pool]} | {ported[pool]} |"
        if want not in doc:
            failures.append(f"the counts table doesn't say {want}")
    for step in STEPS:
        if steps[step] and f"| {step} | {steps[step]} |" not in doc:
            failures.append(f"the counts table doesn't say | {step} | {steps[step]} |")
    return pools, steps, rows


# What the scan for ACE's own data looks for in a function's source, and what it means.
ACCESS = {
    "database": re.compile(r"\b(get_db|get_db_connection|private_transaction|run_private_transaction"
                           r"|sessionmaker)\("),
    "redis": re.compile(r"\b(redis\.Redis|redis\.StrictRedis|get_redis_connection)\("),
}
# a name imported from these is a use of ACE's encryption key
KEY_MODULES = {"saq.crypto"}
# ace3's framework: its own reads (the analysis result cache, secrets kept in the database) are the
# engine's, not a module's, so the scan doesn't follow it
FRAMEWORK = ("saq.analysis", "saq.configuration", "saq.environment", "saq.engine", "saq.constants",
             "saq.util", "saq.logging", "saq.error", "saq.modules.base_module", "saq.modules.adapter",
             "saq.modules.context", "saq.modules.config", "saq.modules.interfaces")
# what starts a process in a module's code (PLAN.md 7.3): ACE's own helpers and the standard library's
PROCESS = {
    "process": re.compile(
        r"\b(run_tool|run_sandboxed_tool|run_sandboxed|Popen|create_subprocess_exec"
        r"|create_subprocess_shell|subprocess\.(run|call|check_call|check_output|getoutput"
        r"|getstatusoutput)|os\.(system|popen|fork|exec\w*|spawn\w*|posix_spawn\w*)"
        r"|pytesseract\.\w+)\("),
}
# what 7.3 decides for a program a module starts
DECISIONS = {"crate", "runner", "children", "scanner", "none"}
# what serves a module besides a read of reads.md
# Reads ace4 adds for a module whose data ace3 keeps outside ACE's own databases, so the scan
# doesn't find the module: nrd_analyzer's list is a SQLite file on each node in ace3, and in ace4
# the core's list, which a worker reads through the core (PLAN.md 7.4).
ADDED_READS = {"newly-registered": "nrd_analyzer"}
# Reads ace4 serves for a site integration's module, which isn't one of ace3's sections and so has no
# row here: a site's mail_filter_email_thread_recovery asks the thread store which ids it holds, as
# ace3's get_recorded_message_ids (PLAN.md decision 29).
SITE_READS = {"recorded-message-ids": "mail_filter_email_thread_recovery"}
SERVED = {"lease", "ruleset", "end", "core"}
FUNCTION = (ast.FunctionDef, ast.AsyncFunctionDef)


class Code:
    """ace3's Python at a commit, read with git show and parsed, never imported or run."""

    def __init__(self, ace3, commit):
        self.ace3, self.commit = ace3, commit
        self.files = set(git(ace3, "ls-tree", "-r", "--name-only", commit, "saq").splitlines())
        self.modules = {}

    def path(self, module):
        stem = module.replace(".", "/")
        for path in (stem + ".py", stem + "/__init__.py"):
            if path in self.files:
                return path
        return None

    def module(self, name):
        """(source, top-level definitions, imports) of a module, or None."""
        if name not in self.modules:
            path = self.path(name)
            if path is None:
                self.modules[name] = None
                return None
            text = git(self.ace3, "show", f"{self.commit}:{path}")
            tree = ast.parse(text)
            package = name if path.endswith("__init__.py") else name.rpartition(".")[0]
            imports = {}
            for node in ast.walk(tree):
                if isinstance(node, ast.ImportFrom):
                    base = node.module or ""
                    if node.level:
                        parts = package.split(".")
                        parts = parts[:len(parts) - (node.level - 1)]
                        base = ".".join(parts + ([base] if base else []))
                    for alias in node.names:
                        imports[alias.asname or alias.name] = (base, alias.name)
            defs = {n.name: n for n in tree.body if isinstance(n, (*FUNCTION, ast.ClassDef))}
            self.modules[name] = (text, defs, imports, package)
        return self.modules[name]

    def resolve(self, module, name, depth=0):
        """(module, node) that `name` means in `module`, through re-exports, or None."""
        found = self.module(module)
        if found is None or depth > 5:
            return None
        _, defs, imports, _ = found
        if name in defs:
            return module, defs[name]
        if name in imports:
            base, attr = imports[name]
            if self.path(f"{base}.{attr}") is None:
                return self.resolve(base, attr, depth + 1)
        return None

    def package_methods(self, package, name):
        """Each (module, class, method) called `name` in the package's own files: what an
        interface's call reaches, as saq.email_archive's wrappers reach its local archive."""
        prefix = package.replace(".", "/") + "/"
        for path in sorted(self.files):
            rest = path[len(prefix):] if path.startswith(prefix) else None
            if not rest or "/" in rest or not rest.endswith(".py") or rest.startswith("test"):
                continue
            module = path[:-3].replace("/", ".").removesuffix(".__init__")
            for node in self.module(module)[1].values():
                if isinstance(node, ast.ClassDef):
                    for item in node.body:
                        if isinstance(item, FUNCTION) and item.name == name:
                            yield module, node, item

    def access(self, module, cls, patterns=None, crypto=True):
        """{kind: the path to its first use} for a module's class: of `patterns` (ACCESS by default)
        and, with `crypto`, of ACE's encryption key."""
        patterns = ACCESS if patterns is None else patterns
        found, seen = {}, set()

        def outside(name):
            return any(name == f or name.startswith(f + ".") for f in FRAMEWORK)

        def visit(module, node, owner, trail):
            key = (module, getattr(owner, "name", None), node.name)
            if key in seen or len(trail) > 10:
                return
            seen.add(key)
            text, _, imports, package = self.module(module)
            trail = trail + [f"{module}.{node.name}"]
            source = ast.get_source_segment(text, node) or ""
            for kind, pattern in patterns.items():
                if pattern.search(source):
                    found.setdefault(kind, " > ".join(trail))
            if isinstance(node, ast.ClassDef):
                owner = node
                for base in node.bases:
                    if isinstance(base, ast.Name):
                        target = self.resolve(module, base.id)
                        if target and not outside(target[0]) and isinstance(target[1], ast.ClassDef):
                            visit(target[0], target[1], target[1], trail)
            for sub in ast.walk(node):
                if isinstance(sub, ast.Name):
                    if crypto and sub.id in imports and imports[sub.id][0] in KEY_MODULES:
                        found.setdefault("key", " > ".join(trail + [f"saq.crypto.{sub.id}"]))
                    target = self.resolve(module, sub.id)
                    if target and not outside(target[0]) and isinstance(target[1], FUNCTION):
                        visit(target[0], target[1], None, trail)
                elif isinstance(sub, ast.Attribute):
                    if (owner is not None and isinstance(sub.value, ast.Name)
                            and sub.value.id == "self"):
                        for item in owner.body:
                            if isinstance(item, FUNCTION) and item.name == sub.attr:
                                visit(module, item, owner, trail)
                    elif isinstance(sub.value, ast.Call) and not outside(module):
                        for target, klass, item in self.package_methods(package, sub.attr):
                            visit(target, item, klass, trail)

        target = self.resolve(module, cls)
        if target:
            visit(target[0], target[1], target[1], [])
        return found


def readers(text, code, patterns=None, crypto=True):
    """{module: {kind: path}} for each section whose class reads ACE's data, or with `patterns`
    does what they find."""
    out = {}
    for key, lines in sections(text).items():
        if key.startswith("analysis_module_"):
            f = fields(lines)
            found = code.access(f.get("python_module"), f.get("python_class"), patterns, crypto)
            if found:
                out[key[len("analysis_module_"):]] = found
    return out


def table(section, heading):
    """The rows of the table under `### heading` in a section, as lists of cells."""
    part = section.split(f"\n### {heading}\n", 1)
    if len(part) < 2:
        return None
    rows = []
    for line in part[1].split("\n### ", 1)[0].splitlines():
        if line.startswith("| ") and not line.startswith("|---"):
            rows.append([c.strip() for c in line.strip().strip("|").split(" | ")])
    return rows[1:]


def check_tools(doc, rows, found, failures):
    """Checks "External tools" against the scan for processes and against the table of modules."""
    section = doc.split("\n## External tools\n", 1)[1].split("\n## ", 1)[0]
    tools, starters = table(section, "Tools"), table(section, "Modules that start a process")
    if tools is None or starters is None:
        failures.append("7.3: External tools has no Tools table or no Modules that start a process")
        return 0, 0

    def decisions(cell):
        return set(re.findall(r"\*\*([a-z]+)\*\*", cell))

    by_tool = collections.defaultdict(set)
    for cells in tools:
        if len(cells) != 6:
            failures.append(f"7.3: a Tools row doesn't have 6 cells: {' | '.join(cells)}")
            continue
        made = decisions(cells[4])
        if len(made) != 1 or not made <= DECISIONS:
            failures.append(f"7.3: {cells[0]} has decisions {sorted(made)}; it needs one of "
                            f"{', '.join(sorted(DECISIONS))}")
        if not cells[2] or not cells[3]:
            failures.append(f"7.3: {cells[0]} doesn't say what it starts or what was weighed")
        names = re.findall(r"`([a-z0-9_]+)`", cells[1])
        if not names:
            failures.append(f"7.3: {cells[0]} names no module")
        for name in names:
            by_tool[name] |= made
    listed = {}
    for cells in starters:
        name = cells[0].strip("`")
        if len(cells) != 4:
            failures.append(f"7.3: {name}'s row doesn't have 4 cells")
            continue
        if name in listed:
            failures.append(f"7.3: {name} has two rows")
        listed[name] = decisions(cells[3])
        made, pool = listed[name], cells[1]
        if name not in rows:
            failures.append(f"7.3: {name} has a row and no row in the table of modules")
            continue
        if pool != rows[name]["pool"].strip():
            failures.append(f"7.3: {name}'s pool is {pool}, and the table of modules says "
                            f"{rows[name]['pool'].strip()}")
        if not made or not made <= DECISIONS or "decides" in cells[3]:
            failures.append(f"7.3: {name} has no decision: {cells[3]}")
        if made != by_tool.get(name, set()):
            failures.append(f"7.3: {name}'s decisions are {sorted(made)}, and the Tools rows that "
                            f"name it say {sorted(by_tool.get(name, set()))}")
        ported = rows[name]["step"].strip() == "done"
        if made & {"runner", "children"} and pool != "sandbox" and not (pool == "parser" and ported):
            failures.append(f"7.3: {name} runs a program in the sandbox runner from pool {pool}")
        if pool == "sandbox" and not made & {"runner", "children"}:
            failures.append(f"7.3: {name} is on the sandbox pool and runs nothing in the runner")
        if ("scanner" in made) != (pool == "scanner"):
            failures.append(f"7.3: {name} has pool {pool} and decisions {sorted(made)}")
    for name in sorted(set(found) - set(listed)):
        failures.append(f"7.3: {name} starts a process and has no row: {found[name]['process']}")
    for name in sorted(set(listed) - set(found)):
        if not listed[name] <= {"scanner", "none"}:
            failures.append(f"7.3: {name} has a row, the scan finds no process, and its decision "
                            "isn't scanner or none")
    for name in sorted(set(by_tool) - set(listed)):
        failures.append(f"7.3: a Tools row names {name}, which has no row")
    for name in sorted(set(rows) - set(listed)):
        if rows[name]["pool"].strip() in ("sandbox", "scanner"):
            failures.append(f"7.3: {name} is on the {rows[name]['pool'].strip()} pool and has no row")
    return len(listed), len(tools)


def check_reads(doc, reads_doc, rows, found, failures):
    """Checks "What 7.2 serves" against the scan and against reads.md."""
    section = doc.split("\n## What 7.2 serves\n", 1)[1].split("\n## ", 1)[0]
    served = {}
    for line in section.splitlines():
        if line.startswith("| `"):
            cells = [c.strip() for c in line.strip().strip("|").split(" | ")]
            name = cells[0].strip("`")
            if name in served:
                failures.append(f"7.2: {name} has two rows")
            served[name] = re.findall(r"`([a-z0-9-]+)`", cells[-1]) if len(cells) == 4 else []
    reads = {}
    table = reads_doc.split("\n## The reads\n", 1)[1].split("\n## ", 1)[0]
    for line in table.splitlines():
        match = re.match(r"^\| `([a-z0-9-]+)` \| `([a-z0-9_]+)` \|", line)
        if match:
            reads[match.group(1)] = match.group(2)
    for name in sorted(set(found) - set(served)):
        kinds = ", ".join(f"{k} ({v})" for k, v in sorted(found[name].items()))
        failures.append(f"7.2: {name} reads ACE's data and has no row: {kinds}")
    for name in sorted(set(served) - set(found)):
        failures.append(f"7.2: {name} has a row and the scan finds no read of ACE's data")
    named = set()
    for name, tokens in served.items():
        if name not in rows:
            failures.append(f"7.2: {name} has a row and no row in the table of modules")
        if not tokens:
            failures.append(f"7.2: {name} reads ACE's data and names nothing to serve it")
        for token in tokens:
            if token in reads:
                named.add(token)
                if reads[token] != name:
                    failures.append(f"7.2: {name} names {token}, which reads.md gives to "
                                    f"{reads[token]}")
            elif token not in SERVED:
                failures.append(f"7.2: {name} names {token}, which isn't a read in reads.md or "
                                f"one of {', '.join(sorted(SERVED))}")
            if token == "core" and name in rows and rows[name]["pool"].strip() != "core":
                failures.append(f"7.2: {name} is served in the core and its pool is "
                                f"{rows[name]['pool'].strip()}")
    for read, module in ADDED_READS.items():
        if reads.get(read) == module:
            named.add(read)
        else:
            failures.append(f"7.2: ADDED_READS gives {read} to {module}, which reads.md doesn't")
    for read, module in SITE_READS.items():
        if reads.get(read) == module:
            named.add(read)
        else:
            failures.append(f"7.2: SITE_READS gives {read} to {module}, which reads.md doesn't")
    for read in sorted(set(reads) - named):
        failures.append(f"7.2: reads.md has {read}, which no module's row names")
    return len(served), len(reads)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    parser.add_argument("--commit", help="default: the commit the trees were made at")
    parser.add_argument("--allow-absent", action="store_true")
    parser.add_argument("--doc", type=Path, default=DOC, help=argparse.SUPPRESS)
    parser.add_argument("--reads", type=Path, default=READS, help=argparse.SUPPRESS)
    args = parser.parse_args(argv)
    ace3 = checkout()
    if ace3 is None:
        if args.allow_absent:
            print("SKIP  the module inventory: no ace3 checkout")
            return 0
        sys.exit("modules: no ace3 checkout; set ACE4_ACE3_CHECKOUT")
    followed = args.commit is None
    if followed:
        args.commit = json.loads(FOLLOWED.read_text())["ace3_commit"]
    commit = git(ace3, "rev-parse", "--short=8", args.commit).strip()
    if followed:
        # how far ace3's checkout is past the commit ace4 follows: for a checkpoint to bring ace4
        # up to, and nothing a step fails on
        ahead = int(git(ace3, "rev-list", "--count", f"{commit}..HEAD").strip())
        if ahead:
            head = git(ace3, "rev-parse", "--short=8", "HEAD").strip()
            print(f"note  ace3's checkout is at {head}, {ahead} commits past {commit}, the commit "
                  "ace4 follows; a checkpoint brings ace4 up to it (PLAN.md decision 14)")
    text = git(ace3, "show", f"{commit}:etc/saq.default.yaml")
    sections_ = config(text)
    doc = args.doc.read_text()
    failures = []
    pools, steps, rows = check_doc(doc, sections_, failures)
    code = Code(ace3, commit)
    served, reads = check_reads(doc, args.reads.read_text(), rows, readers(text, code), failures)
    starting, tools = check_tools(doc, rows, readers(text, code, PROCESS, crypto=False), failures)
    documented = re.search(r"at ace3 `([0-9a-f]+)`", doc)
    if documented and not commit.startswith(documented.group(1)[:7]):
        print(f"note  docs/modules.md was written at ace3 {documented.group(1)}; checked at {commit}")
    for failure in failures:
        print(f"FAIL  {failure}")
    summary = (f"{len(sections_)} sections at ace3 {commit}; pools "
               + ", ".join(f"{p} {pools[p]}" for p in POOLS) + "; steps "
               + ", ".join(f"{s} {steps[s]}" for s in STEPS if steps[s])
               + f"; {served} read ACE's data, with {reads} reads in reads.md"
               + f"; {starting} start a process, with {tools} tools decided")
    print(("ok    " if not failures else "FAIL  ") + "the module inventory: " + summary)
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
