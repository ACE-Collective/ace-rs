#!/usr/bin/env python3
"""Write ace3's tree of each sample in the normal form (PLAN.md 3.2).

Each sample runs through ace3's cli analysis mode, in ace3's dev container, with the modules
ace4 has ported. So that both
systems see the same world, as tests/e2e/run gives ace4:

- RDAP is answered from the recording tests/e2e/run's responder replays, and WHOIS fails;
- the Splunk module has the same query as tests/e2e/site/overlay.yaml's instance, against
  fake_splunk.py with the rows the responder's recording holds, for any search as it answers;
- YARA scans with tools/ace3/trees/signatures, the rule tests/e2e/run gives the stack;
- brocess is tools/ace3/trees/brocess.json, empty: its smtplog for the frequency module and its
  thread store for the thread module (run_module.py --brocess-store), as tests/e2e/run empties
  ace4's before its comparison;
- the newly registered domains list is tools/ace3/trees/nrd.json, unverified by RDAP, as
  tests/e2e/run gives ace4 the same list;
- DNS is answered by fake_dns.py from tools/ace3/dumps/fixtures/dns/zone.json, and what it answered
  is kept in tools/ace3/trees/dns.json, which tests/e2e/run's responder replays to ace4;
- the email archive is empty (run_module.py --email-archive-store), under the dumps' test-only key, as
  tests/e2e/run's stack starts with an empty archive. No sample has the archive directive, so the
  archiver archives nothing, and none is a .gz.e;
- the observables enabled for detection are tools/ace3/trees/detections.json (run_module.py
  --detections), and the tags analysts mapped to observables tools/ace3/trees/observable_tags.json
  (--observable-tags), as tests/e2e/run gives ace4's observable_detection list and
  analysis.observable_tags the same before its comparison;
- the site tagger reads tools/ace3/trees/site_tags.csv, the text tests/e2e/site/overlay.yaml gives
  ace4's site_tagger;
- the core's hooks (PLAN.md 7.6) are tests/e2e/site/overlay.yaml's `hooks:` section. ace3 ships
  configuration_defined_tagging disabled, so it's enabled here, over ace3's own `tags:` section, which
  the overlay's tags have to equal (checked in the container, which has PyYAML). ace3 ships
  observable_modifier enabled with an empty rules file; it gets the overlay's rules, written as ace3's
  YAML with ace3's names for the modules they name (MODULE_PATHS).

    tools/ace3/trees/make-trees                     every sample
    tools/ace3/trees/make-trees ace4/email/e2e...   the samples named, by path under samples/

The trees go to tools/ace3/trees/reference/<sample>.json, with index.json naming ace3's commit.
The comparison follows the newest ace3 (PLAN.md decision 14), so rerun this after ace3 moves.
Everything runs under the container's /tmp/ace4-dumps; nothing is written under /opt/ace. Samples
under samples/local/ are git-ignored, so make them or copy them in first.
"""

import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[2]
DUMPS = HERE.parent / "dumps"
OUT = HERE / "reference"

_loader = importlib.machinery.SourceFileLoader("make_dumps", str(DUMPS / "make-dumps"))
_spec = importlib.util.spec_from_loader("make_dumps", _loader)
dumps = importlib.util.module_from_spec(_spec)
_loader.exec_module(dumps)

CONTAINER, REMOTE, docker, put = dumps.CONTAINER, dumps.REMOTE, dumps.docker, dumps.put
ENABLE = [
    "file_type", "archive", "yara_scanner_v3_4", "rdap_analyzer", "proxy_domain_splunk", "olevba_v1_2",
    "rtfole", "msoffice_encryption_analyzer", "xlmdeobfuscator", "pcodedmp", "pdf_analyzer", "fqdn_analyzer",
    "email_conversation_frequency_analyzer", "email_thread_analyzer", "nrd_analyzer", "url_extraction",
    "ioc_extraction", "file_hash_analyzer", "binary_file_analyzer", "x509_analyzer", "lnk_parser", "dhash",
    "command_line_analyzer", "file_location_analysis", "file_path_analysis", "network_identifier", "parse_url",
    "idna_analyzer", "email_address_fqdn_analyzer", "protected_url_analyzer", "html_data_url_extraction",
    "har_extraction", "html_js_extraction", "mhtml", "onenote_extraction", "officeparser3", "office_xml_rel",
    "xml_binary_analyzer", "xml_plain_text_analyzer", "extracted_ole_analyzer", "hidden_mime", "active_mime",
    "microsoft_script_encoding_analysis", "extracted_rtf_analyzer", "vbscript_analyzer", "nowhitespace_analyzer",
    "zip_encryption_analyzer", "rar_encryption_analyzer", "pdf_encryption_analyzer", "lure_url_analyzer",
    "mailbox_email_analyzer", "email_conversation_attachment_analyzer", "email_conversation_link_analyzer",
    "email_archiver", "encrypted_archive_analyzer", "url_email_pivot_analyzer", "message_id_analyzer_v2",
    "pdftotext", "exif", "qrcode", "ocr", "java_class_decompiler", "upx", "autoit", "de4dot", "ilspy",
    "dmg_analyzer", "cve_2021_30657_analyzer", "pcap_analyzer", "pcap_dns", "pcap_tls", "pcap_http", "pcap_files",
    "pcap_tls_decryption", "tls_keylog", "user_defined_tagging", "observable_detection", "site_tagger",
    "javascript_deobfuscation", "observable_modifier", "configuration_defined_tagging",
]
OVERLAY = REPO / "tests" / "e2e" / "site" / "overlay.yaml"
MODIFIER_RULES = f"{REMOTE}/trees-observable_modifier_rules.yaml"
# ace4 names a module by its key, where ace3's rules name the Python path of what they mean: a tree
# condition's analysis_type and reset_analysis an Analysis class, exclude_analysis an analyzer class.
# limit_analysis takes ace3's module names, which are ace4's keys.
MODULE_PATHS = {
    "analysis": {
        "email_analyzer": "saq.modules.email.rfc822:EmailAnalysis",
        "file_hash_analyzer": "saq.modules.file_analysis.hash:FileHashAnalysis",
    },
    "analyzer": {
        "rdap_analyzer": "saq.modules.rdap:RdapAnalyzer",
    },
}
# Run in ace3's container: checks the overlay's tags against ace3's and writes its rules as ace3's.
HOOKS_SCRIPT = r'''
import json, sys, yaml
overlay = yaml.safe_load(open(sys.argv[1]))["hooks"]
paths = json.loads(sys.argv[3])
ace3_tags = yaml.safe_load(open("/opt/ace/etc/saq.default.yaml"))["tags"]
tags = overlay["configuration_defined_tagging"]["tags"]
if tags != ace3_tags:
    sys.exit(f"the overlay's tags aren't ace3's: {sorted(set(tags.items()) ^ set(ace3_tags.items()))}")
rules = overlay["observable_modifier"]["rules"]
for rule in rules:
    for tc in rule.get("conditions", {}).get("tree_conditions", []):
        if tc.get("analysis_type"):
            tc["analysis_type"] = paths["analysis"][tc["analysis_type"]]
    actions = rule.get("actions", {})
    for key, kind in (("exclude_analysis", "analyzer"), ("reset_analysis", "analysis")):
        if key in actions:
            actions[key] = [paths[kind][m] for m in actions[key]]
with open(sys.argv[2], "w") as fp:
    yaml.safe_dump({"rules": rules}, fp, sort_keys=False)
'''
BROCESS = HERE / "brocess.json"
NRD = HERE / "nrd.json"
DETECTIONS = HERE / "detections.json"
OBSERVABLE_TAGS = HERE / "observable_tags.json"
SITE_TAGS = HERE / "site_tags.csv"
NRD_DB = f"{REMOTE}/trees-nrd.db"
# the newly registered domains list of nrd.json, which ace3 reads from a SQLite file as its refresh
# builds one; RDAP knows nothing of its domains, so a hit isn't verified
NRD_CONFIG = f"""\
nrd:
  database_path: {NRD_DB}
analysis_module_nrd_analyzer:
  max_registration_age_days: 0
analysis_module_site_tagger:
  csv_file: {REMOTE}/trees-site_tags.csv
analysis_module_observable_modifier:
  rules_config_path: {MODIFIER_RULES}
"""
DNS_RECORDING = HERE / "dns.json"
RDAP_RECORDING = DUMPS / "reference" / "rdap_analyzer" / "fqdn_example.com.http"
FAKE = f"{REMOTE}/fake/trees"
# tests/e2e/site/overlay.yaml's proxy_domain_splunk, by the same name, which ace3 has no module of.
# run_module.py writes a SplunkAPIAnalyzer's results under it.
SPLUNK_INSTANCE = """\
analysis_module_proxy_domain_splunk:
  name: proxy_domain_splunk
  python_module: saq.modules.splunk
  python_class: SplunkAPIAnalyzer
  enabled: true
  api_name: ace4_fake
  valid_observable_types: [fqdn]
  question: Was this domain seen in proxy logs?
  summary: Proxy correlation
  query: index=proxy hostname="<O_VALUE>"
  use_index_time: true
  observable_mapping:
    - field: user
      type: email_address
"""


def splunk_config():
    """make-dumps' fake Splunk connection and defaults, with this instance in place of its query."""
    config = dumps.SPLUNK_CONFIG.format(port=dumps.SPLUNK_PORT, query_timeout="")
    return config[: config.index("analysis_module_proxy_domain_lookup:")] + SPLUNK_INSTANCE + NRD_CONFIG


def copy_tree(source, target):
    archive = subprocess.run(
        ["tar", "--no-xattrs", "-C", str(source), "-cf", "-", "."],
        capture_output=True, check=True, env={"COPYFILE_DISABLE": "1"},
    ).stdout
    docker("exec", CONTAINER, "mkdir", "-p", target)
    docker("exec", "-i", CONTAINER, "tar", "-C", target, "-xf", "-", stdin=archive)


def start_fake():
    docker("exec", CONTAINER, "mkdir", "-p", f"{FAKE}/http")
    put(f"{FAKE}/saq.yaml", splunk_config().encode())
    docker(
        "exec", "-d", CONTAINER, "sh", "-c",
        f"exec /venv/bin/python3 -I {REMOTE}/fake_splunk.py "
        f"--rows {REMOTE}/fixtures/splunk/proxy_rows.json --cert {REMOTE}/fake/cert.pem "
        f"--key {REMOTE}/fake/key.pem --port {dumps.SPLUNK_PORT} --record {FAKE}/http "
        f"--pid-file {FAKE}/pid --running-polls 4 --any-hostname 2> {FAKE}/fake.log",
    )
    for _ in range(100):
        if docker("exec", CONTAINER, "test", "-e", f"{FAKE}/pid", check=False).returncode == 0:
            return
        time.sleep(0.1)
    raise SystemExit("fake_splunk.py did not start")


def stop_fake():
    docker("exec", CONTAINER, "sh", "-c", f'kill "$(cat {FAKE}/pid)" 2>/dev/null || true', check=False)


def run(sample):
    work = f"{REMOTE}/runs/trees/{sample['path']}"
    command = [
        "docker", "exec", "-i", "-e", "PYTHONDONTWRITEBYTECODE=1", "-e", "SAQ_SKIP_LOCAL_SAQ_YAML=1",
        # sets' order, such as urlfinderlib's URLs, then comes out the same each time the trees are made
        "-e", "PYTHONHASHSEED=0",
        "-e", "NO_PROXY=127.0.0.1,localhost", "-e", "no_proxy=127.0.0.1,localhost",
        # ace3's rtfole runs `python`, which has to be the virtualenv's, as in ace3's services
        "-e", "PATH=/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        CONTAINER, "/venv/bin/python3", "-", "--work", work, "--module", "email_analyzer",
        "--label", sample["path"], "--file", f"{REMOTE}/samples/{sample['path']}",
        "--alert-path", sample["alert_path"], "--yara-rules", f"{REMOTE}/signatures",
        "--config", f"{FAKE}/saq.yaml", "--replay-http", f"{REMOTE}/rdap", "--tree",
        "--dns", f"127.0.0.1:{dumps.DNS_PORT}", "--brocess", f"{REMOTE}/trees-brocess.json",
        "--brocess-store", f"{REMOTE}/trees-brocess.json",
        "--email-archive-store", f"{REMOTE}/fixtures/email_archive/empty.json",
        "--encryption-key", dumps.EMAIL_ARCHIVE_KEY,
        "--detections", f"{REMOTE}/trees-detections.json",
        "--observable-tags", f"{REMOTE}/trees-observable_tags.json",
    ]
    for tag in sample["meta_tags"]:
        command += ["--meta-tag", tag]
    for module in ENABLE:
        command += ["--enable", module]
    result = subprocess.run(command, input=(DUMPS / "run_module.py").read_bytes(), capture_output=True)
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode(errors="replace")[-4000:])
        raise SystemExit(f"run_module.py failed for {sample['path']}")
    target = OUT / f"{sample['path']}.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(docker("exec", CONTAINER, "cat", f"{work}/tree.json").stdout)
    docker("exec", CONTAINER, "rm", "-rf", work)


def save_dns_recording(recorded):
    """Keeps one answer per name and type, the newest, beside those of samples this run didn't make."""
    exchanges = {}
    if DNS_RECORDING.exists():
        for exchange in json.loads(DNS_RECORDING.read_text())["exchanges"]:
            exchanges[(exchange["name"], exchange["type"])] = exchange
    for exchange in json.loads(recorded)["exchanges"] if recorded else []:
        exchanges[(exchange["name"], exchange["type"])] = exchange
    DNS_RECORDING.write_text(json.dumps({
        "about": "What tools/ace3/dumps/fake_dns.py answered ace3's DNS lookups with while "
        "tools/ace3/trees/make-trees ran, one answer per name and type. tests/e2e/run's responder "
        "replays it to ace4.",
        "exchanges": [exchanges[key] for key in sorted(exchanges)],
    }, indent=2) + "\n")


def main():
    manifest = json.loads((REPO / "samples" / "manifest.json").read_text())
    wanted = sys.argv[1:]
    samples = [s for s in manifest["samples"] if not wanted or s["path"] in wanted]
    missing = set(wanted) - {s["path"] for s in samples}
    if missing:
        raise SystemExit(f"not in the manifest: {sorted(missing)}")
    dumps.copy_in(["splunk"])
    copy_tree(HERE / "signatures", f"{REMOTE}/signatures")
    copy_tree(RDAP_RECORDING, f"{REMOTE}/rdap")
    put(f"{REMOTE}/trees-brocess.json", BROCESS.read_bytes())
    put(f"{REMOTE}/trees-nrd.json", NRD.read_bytes())
    put(f"{REMOTE}/trees-detections.json", DETECTIONS.read_bytes())
    put(f"{REMOTE}/trees-observable_tags.json", OBSERVABLE_TAGS.read_bytes())
    put(f"{REMOTE}/trees-site_tags.csv", SITE_TAGS.read_bytes())
    put(f"{REMOTE}/trees-overlay.yaml", OVERLAY.read_bytes())
    hooks = docker(
        "exec", CONTAINER, "/venv/bin/python3", "-I", "-c", HOOKS_SCRIPT, f"{REMOTE}/trees-overlay.yaml",
        MODIFIER_RULES, json.dumps(MODULE_PATHS), check=False,
    )
    if hooks.returncode != 0:
        raise SystemExit(hooks.stderr.decode(errors="replace"))
    docker(
        "exec", CONTAINER, "/venv/bin/python3", "-I", "-c",
        "import json, sqlite3, sys; db = sqlite3.connect(sys.argv[2]); "
        "db.execute('CREATE TABLE nrd (domain TEXT PRIMARY KEY) WITHOUT ROWID'); "
        "db.executemany('INSERT INTO nrd VALUES (?)', [(d,) for d in json.load(open(sys.argv[1]))['domains']]); "
        "db.commit()",
        f"{REMOTE}/trees-nrd.json", NRD_DB,
    )
    start_fake()
    try:
        with dumps.fake_dns(f"{FAKE}/dns"):
            for sample in samples:
                print(sample["path"], flush=True)
                run(sample)
    finally:
        stop_fake()
    save_dns_recording(docker("exec", CONTAINER, "cat", f"{FAKE}/dns/dns.json", check=False).stdout)
    commit = docker(
        "exec", CONTAINER, "git", "-C", "/opt/ace", "rev-parse", "--short=8", "HEAD"
    ).stdout.decode().strip()
    (OUT / "index.json").write_text(json.dumps({"ace3_commit": commit}, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
