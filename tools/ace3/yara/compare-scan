#!/usr/bin/env python3
"""Compares ace-rs's `ace yara scan` with ace3's on fixture files (PLAN.md 1.8).

ace3's command sends each file's path to ace3's running yara service, whose worker reads the
file there, so the files have to be ones ace3's containers can see without anything being
written into ace3's checkout or volumes: files already in ace3's checkout. Each case is one
of those with the meta tags it is scanned with:

- sample_pdf_with_qr_code.pdf, one of ace3's test fixtures and in samples/, with every tag
  the signatures' meta_tags directives name;
- two rule files from the signatures repository, which match their own strings, one with
  those tags and one with none;
- evil.zip, which matches nothing.

ace3's side runs in ace3's dev container. ace-rs's side runs `ace yara scan` in a one-off
`dev` container of ace-rs's stack, compiling the signatures from the same checkout, with
ace3's signatures/ and tests/ bind-mounted read only at /opt/ace/, so every file has the
same path on both sides and the path externals and filters see the same thing.

Usage: tools/ace3/yara/compare-scan

ACE_RS_ACE3_CHECKOUT is ace3's checkout on the host (default: ../ace3 beside this checkout),
ACE_RS_ACE3_CONTAINER ace3's dev container (default: ace-dev-1). Compose reads ACE_RS_STACK and
the other ACE_RS_ variables as usual. Prints both outputs for each case and exits 1 if any
case prints different rules.
"""

import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[3]
ACE3 = Path(os.environ.get("ACE_RS_ACE3_CHECKOUT", REPO.parent / "ace3")).resolve()
CONTAINER = os.environ.get("ACE_RS_ACE3_CONTAINER", "ace-dev-1")

# Every tag the signatures' meta_tags directives name.
TAGS = [
    "type=email.attachment", "type=document.html.phishkit", "type=script.javascript",
    "type=email.headers", "type=email.combined", "type=document.pdf.object",
    "type=document.pdf.annotation_uris", "type=executable",
]

# The signatures' first two rule files under yara/, by path, which name nothing here.
RULE_FILES = sorted(p.relative_to(ACE3) for p in (ACE3 / "signatures" / "yara").rglob("*.yar"))[:2]
CASES = [
    ("/opt/ace/tests/saq/modules/test_file_analysis/sample_pdf_with_qr_code.pdf", TAGS),
    *[(f"/opt/ace/{path}", tags) for path, tags in zip(RULE_FILES, [TAGS, []])],
    ("/opt/ace/tests/saq/modules/test_file_analysis/evil.zip", TAGS),
]


def ace3_scan(path, tags):
    argv = ["docker", "exec", "-w", "/opt/ace", CONTAINER, "/venv/bin/python3", "./ace", "yara", "scan", path]
    if tags:
        argv += ["--meta-tags", *tags]
    return subprocess.run(argv, check=True, capture_output=True, text=True).stdout


def ace_rs(command):
    argv = [
        "docker", "compose", "run", "--rm", "-T", "--no-deps",
        "-v", f"{ACE3 / 'signatures'}:/opt/ace/signatures:ro",
        "-v", f"{ACE3 / 'tests'}:/opt/ace/tests:ro",
        "dev", "bash", "-c", command,
    ]
    return subprocess.run(argv, check=True, capture_output=True, text=True, cwd=REPO).stdout


def rules(output):
    """The rule names a scan printed, without the commit ace-rs adds to each."""
    return [re.sub(r" \([0-9a-f]{40}\)$", "", line.strip()) for line in output.splitlines()
            if line.startswith("\t")]


def main():
    ace_rs("cargo build -q -p ace")
    differences = 0
    for path, tags in CASES:
        tag_args = " ".join(["--meta-tags", *tags]) if tags else ""
        ours = ace_rs(f"target/debug/ace yara scan --rules /opt/ace/signatures/yara {path} {tag_args}")
        theirs = ace3_scan(path, tags)
        same = rules(ours) == rules(theirs) and ours.splitlines()[0] == theirs.splitlines()[0]
        differences += not same
        print(f"== {path} ({len(tags)} tags): {'same rules' if same else 'DIFFERENT'}")
        print("-- ace3:")
        print(theirs, end="")
        print("-- ace-rs:")
        print(ours, end="")
    print(f"{len(CASES)} files, {differences} with different rules")
    return 1 if differences else 0


if __name__ == "__main__":
    sys.exit(main())
