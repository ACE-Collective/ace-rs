#!/bin/sh
# Refuses to push T3 Code's private refs (refs/t3/*), which stay on the machine that made them
# and can reach rewritten history. Push branches and tags by name instead. Turn it on once per
# clone: git config core.hooksPath tools/git-hooks
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref $remote_ref" in
        *refs/t3/*)
            echo "pre-push: refusing to push $local_ref -> $remote_ref (T3 refs stay local)" >&2
            status=1 ;;
    esac
done
exit $status
