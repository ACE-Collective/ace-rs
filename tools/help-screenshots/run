                    " set('platform', 'windows'); set('usernames', 'art'); set('ips', '10.20.30.14');"
                    " set('notes', 'Windows 11 24H2'); })()"},
    ]


def main(argv):
    reuse = "--reuse" in argv
    keep = "--keep" in argv or reuse
    optimised = "--no-optimise" not in argv
    out = IMAGES
    if "--out" in argv:
        out = Path(argv[argv.index("--out") + 1]).resolve()
    only = [arg for at, arg in enumerate(argv)
            if not arg.startswith("--") and (at == 0 or argv[at - 1] != "--out")]
    out.mkdir(parents=True, exist_ok=True)
    if not reuse:
        start()
    try:
        if not reuse:
            token = make_users()
            seed("1-catalog.sql", yara_x=yara_x_version())
            launcher_calls(token)
            seed("2-runs.sql")
            cookie = sign_in()
            reviews(cookie)
            coverage(cookie)
        wanted = [shot for shot in shots(launcher_made()) if not only or shot["name"] in only]
        unknown = set(only) - {shot["name"] for shot in wanted}
        if unknown:
            fail(f"no shot is named {sorted(unknown)}")
        page = open_browser()
        try:
            for shot in wanted:
                capture(page, shot, out)
        finally:
            page.close()
        names = [shot["name"] for shot in wanted]
        if optimised:
            optimise(out, names)
        total = 0
        for name in names:
            size = (out / f"{name}.png").stat().st_size
            total += size
            log(f"{name}.png {size / 1024:.0f} KB")
        log(f"{len(names)} pictures, {total / 1024:.0f} KB in all, in {out}")
    finally:
        if keep:
            log(f"left ace serve, {DATABASE} and the browser up (--keep)")
        else:
            stop()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
