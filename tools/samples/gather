def make_local(local, work):
    """Makes the local samples and returns (path, kinds, how it was made) for each."""
    made = []

    def add(relative, kinds, how):
        made.append((local / relative, kinds, how))

    archive = local / "archive"
    archive.mkdir(parents=True)

    seven_zip(archive / "password-infected.zip", work, "-tzip", "-pinfected", "-mem=ZipCrypto")
    add("archive/password-infected.zip", ["archive/zip", "archive/password"],
        "7z, ZipCrypto, password infected, one text member")
    seven_zip(archive / "password-infected-aes256.zip", work, "-tzip", "-pinfected", "-mem=AES256")
    add("archive/password-infected-aes256.zip", ["archive/zip", "archive/password"],
        "7z, AES-256, password infected, one text member")
    seven_zip(archive / "password-infected.7z", work, "-t7z", "-pinfected")
    add("archive/password-infected.7z", ["archive/7z", "archive/password"],
        "7z, password infected, member names visible")
    seven_zip(archive / "password-infected-headers.7z", work, "-t7z", "-pinfected", "-mhe=on")
    add("archive/password-infected-headers.7z", ["archive/7z", "archive/password"],
        "7z, password infected, member names encrypted too")

    inner = work / "inner.zip"
    write_zip(inner, {"readme.txt": BENIGN_TEXT})
    write_zip(archive / "nested.zip", {"inner.zip": inner.read_bytes()})
    add("archive/nested.zip", ["archive/zip", "archive/nested"],
        "Python zipfile, a zip inside a zip holding one text file")
    write_zip(archive / "zip-slip.zip", {"../x": BENIGN_TEXT, "readme.txt": BENIGN_TEXT})
    add("archive/zip-slip.zip", ["archive/zip", "archive/path-traversal"],
        "Python zipfile, a member named ../x beside a normal one")

    # An email whose zip attachment is encrypted with a password given in the body, as
    # ace3/tests/saq/modules/email/test_encryption.py builds it.
    mail = local / "email"
    mail.mkdir(parents=True)
    password = "Secr3tPw"
    payload = work / "invoice.txt"
    payload.write_text("the decrypted payload https://payload.example.com/x\n")
    os.utime(payload, (FIXED_EPOCH, FIXED_EPOCH))
    run("7z", "a", "-tzip", f"-p{password}", "invoice.zip", payload.name, cwd=work)
    message = email.message.EmailMessage()
    message["From"] = "sender@example.com"
    message["To"] = "recipient@example.com"
    message["Subject"] = "invoice"
    message["Message-ID"] = "<encrypted-zip-sample@example.com>"
    message.set_content(f"The password for the attached invoice is {password} thanks")
    message.add_attachment(
        (work / "invoice.zip").read_bytes(), maintype="application", subtype="zip", filename="invoice.zip"
    )
    message.set_boundary("ace4-sample-boundary")
    (mail / "encrypted_zip_password_in_body.email.rfc822").write_bytes(bytes(message))
    add("email/encrypted_zip_password_in_body.email.rfc822", ["email", "archive/password"],
        "Python email, a zip encrypted with the password Secr3tPw, which the body gives")

    office = local / "office"
    office.mkdir(parents=True)
    write_zip(office / "invoice.xlsm", XLSM_PARTS)
    add("office/invoice.xlsm", ["office/macro", "office/ooxml"],
        "Python zipfile, an Excel 4.0 (XLM) auto-open macro sheet")

    rtf = local / "rtf"
    rtf.mkdir(parents=True)
    data = ole1_package(b"payload.exe", b"MZ" + b"\x90" * 64).hex().encode()
    (rtf / "document.rtf").write_bytes(
        b"{\\rtf1\\ansi Hello \\par\r\n{\\object\\objemb{\\*\\objclass Package}{\\*\\objdata "
        + data
        + b"}}}"
    )
    add("rtf/document.rtf", ["rtf", "rtf/ole-object"],
        "an OLE1 Package object holding payload.exe, which is MZ and 64 NOPs")
    (rtf / "plain.rtf").write_bytes(b"{\\rtf1\\ansi\\deff0 {\\fonttbl {\\f0 Arial;}} Hello from ace4.\\par}")
    add("rtf/plain.rtf", ["rtf"], "text only, no objects")
    return made


def make_e2e_email(path):
    """The email tests/e2e/run submits and PLAN.md 3.2 compares: a DKIM signing domain the recorded
    RDAP answers for, and a stored zip attachment holding the marker tools/ace3/trees/signatures
    matches. Every byte is fixed, so it stays one sample across runs of this script."""
    archive = io.BytesIO()
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_STORED) as z:
        z.writestr(
            zipfile.ZipInfo("invoice.txt", date_time=(2026, 1, 1, 0, 0, 0)),
            "Invoice 1001\nACE4-E2E-MARKER-6c1f\n",
        )
    message = email.message.EmailMessage()
    message["From"] = "Alice <alice@example.com>"
    message["To"] = "bob@example.net"
    message["Subject"] = "ace4 end-to-end"
    message["Date"] = "Sun, 01 Nov 2026 12:00:00 +0000"
    message["Message-ID"] = "<ace4-e2e@example.com>"
    message["DKIM-Signature"] = (
        "v=1; a=rsa-sha256; c=relaxed/relaxed; d=example.com; s=e2e; "
        "h=from:to:subject; bh=AAAA; b=BBBB"
    )
    message.set_content("The invoice is attached.\n")
    message.add_attachment(
        archive.getvalue(), maintype="application", subtype="zip", filename="invoice.zip"
    )
    message.set_boundary("ace4-e2e-boundary")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(message.as_bytes())


def make_office_edges(directory, macro_docm):
    """Files for what ace3's olevba decides before it opens a file and when it can't, which ace3's
    fixtures don't reach. Every byte is fixed. `macro_docm` gives the last one a real VBA project."""
    with zipfile.ZipFile(macro_docm) as z:
        project = z.read("word/vbaProject.bin")
    mso = b"ActiveMime".ljust(0x32, b"\0") + zlib.compress(project, 9)
    files = {
        # the two mime types ace3's module leaves alone, under an Office extension
        "html_named.doc": b"<html><body>not a Word document</body></html>\n",
        "text_named.doc": b"This is plain text, not a Word document.\n",
        # no format oletools knows, so an Office extension gets olevba_failed
        "garbage.doc": bytes(range(256)) * 8,
        # oletools reads anything without a NUL as source code: XML, so its mime type isn't plain
        "source.doc": b'<?xml version="1.0"?>\n<a>\nSub AutoOpen()\nShell "calc.exe"\nEnd Sub\n</a>\n',
        # a Word "single file web page" whose part's name decodes to a lone surrogate, which JSON
        # text can't carry. oletools skips what's before MIME, which keeps its mime type off text/plain
        "surrogate_name.doc": (
            b"\x00\x01\xff\r\nMIME-Version: 1.0\r\nContent-Type: multipart/related; boundary=\"b\"\r\n\r\n--b\r\n"
            b"Content-Type: application/x-mso\r\nContent-Transfer-Encoding: base64\r\n"
            b"Content-Disposition: attachment; filename*=raw-unicode-escape''%5Cud800.mso\r\n\r\n"
            + base64.encodebytes(mso).replace(b"\n", b"\r\n")
            + b"\r\n--b--\r\n"
        ),
    }
    directory.mkdir(parents=True, exist_ok=True)
    for name, data in files.items():
        (directory / name).write_bytes(data)
    return [directory / name for name in files]


def encrypted_email(path, body, attachments=(), html=None, nested=None):
    """An email for ace3's msoffice module, with fixed headers, so only the files' salts change."""
    message = email.message.EmailMessage()
    message["From"] = "sender@example.com"
    message["To"] = "recipient@example.com"
    message["Subject"] = "the attached file"
    message["Date"] = "Fri, 06 Nov 2026 12:00:00 +0000"
    message["Message-ID"] = f"<{path.name}@example.com>"
    if body is not None:
        message.set_content(body)
    if html is not None:
        message.add_alternative(html, subtype="html")
    if body is None and html is None:
        message.make_mixed()
    for name, data in attachments:
        message.add_attachment(data, maintype="application", subtype="octet-stream", filename=name)
    if nested is not None:
        message.add_attachment(nested)
    return message


def make_encrypted_office(directory, email_directory):
    """Encrypted Office files, and the emails that carry them, for what ace3's msoffice module does:
    a password found in a body, in HTML, in a nested email and from an email past a zip, none found,
    no email, no body, a default password, and formats John doesn't take. The files' encryption is
    tools/samples/make-encrypted-office's, in the Python pool's image."""
    with tempfile.TemporaryDirectory(dir=REPO / "target") as work:
        subprocess.run(
            ["docker", "run", "--rm", "-u", f"{os.getuid()}:{os.getgid()}", "--entrypoint", "python3",
             "-v", f"{REPO}:/repo:ro", "-v", f"{work}:/out", "ace4-python:latest", "-I",
             "/repo/tools/samples/make-encrypted-office", "/out",
             "/repo/samples/ace3/office/mortgage_payment-0873821-0565.docm",
             "/repo/samples/ace3/office/doc.docx", "/repo/samples/ace3/office/doc.doc",
             "/repo/samples/ace3/email/encrypted_msoffice.email.rfc822"],
            check=True,
        )
        made = {path.name: path.read_bytes() for path in Path(work).iterdir()}
    directory.mkdir(parents=True, exist_ok=True)
    email_directory.mkdir(parents=True, exist_ok=True)
    files = []
    for source, name in [
        ("velvet.docx", "encrypted_velvet.docx"),
        ("agile_not_in_body.docx", "encrypted_no_email.docx"),
        ("extensible.docx", "encrypted_extensible.docx"),
        ("xor.doc", "encrypted_xor.doc"),
        ("xor.xls", "encrypted_xor.xls"),
    ]:
        (directory / name).write_bytes(made[source])
        files.append(directory / name)

    inner_zip = io.BytesIO()
    with zipfile.ZipFile(inner_zip, "w") as z:
        z.writestr(zipfile.ZipInfo("invoice.docm", (2020, 1, 1, 0, 0, 0)), made["agile_in_body.docm"])
    inner = encrypted_email(
        email_directory / "inner.email.rfc822",
        "The inner password is InnerPw1\n",
        [("invoice.docx", made["agile_inner.docx"])],
    )
    emails = {
        "encrypted_in_body.email.rfc822": encrypted_email(
            email_directory / "encrypted_in_body.email.rfc822",
            "The password is Secr3tPw\n", [("invoice.docm", made["agile_in_body.docm"])],
        ),
        "encrypted_standard.email.rfc822": encrypted_email(
            email_directory / "encrypted_standard.email.rfc822",
            "The password is St4ndard\n", [("invoice.docm", made["standard_in_body.docm"])],
        ),
        "encrypted_wrong_password.email.rfc822": encrypted_email(
            email_directory / "encrypted_wrong_password.email.rfc822",
            "The password is Wr0ngOne\n", [("invoice.docx", made["agile_not_in_body.docx"])],
        ),
        "encrypted_html_body.email.rfc822": encrypted_email(
            email_directory / "encrypted_html_body.email.rfc822",
            "See the HTML part\n", [("invoice.docx", made["agile_in_html.docx"])],
            html="<html><body><p>Use <b>H7mlPass</b></p></body></html>\n",
        ),
        "encrypted_no_body.email.rfc822": encrypted_email(
            email_directory / "encrypted_no_body.email.rfc822",
            None, [("invoice.docx", made["agile_not_in_body.docx"])],
        ),
        "encrypted_in_zip.email.rfc822": encrypted_email(
            email_directory / "encrypted_in_zip.email.rfc822",
            "The password is Secr3tPw\n", [("invoice.zip", inner_zip.getvalue())],
        ),
        "encrypted_nested.email.rfc822": encrypted_email(
            email_directory / "encrypted_nested.email.rfc822",
            "The outer email has no password\n", nested=inner,
        ),
        # the outer email's HTML is its body, so only the nested email's body has the password, and
        # the outer email adds the attachment before the nested one has been parsed
        "encrypted_nested_html.email.rfc822": encrypted_email(
            email_directory / "encrypted_nested_html.email.rfc822",
            "The outer email has no password\n",
            html="<html><body><p>The outer email has no password</p></body></html>\n",
            nested=inner,
        ),
    }
    for name, message in emails.items():
        (email_directory / name).write_bytes(message.as_bytes())
    return files, [email_directory / name for name in emails]


def entry(path, kinds, source, note=None):
    data = path.read_bytes()
    relative = path.relative_to(SAMPLES).as_posix()
    is_email = "email" in kinds
    record = {
        "path": relative,
        "sha256": hashlib.sha256(data).hexdigest(),
        "size": len(data),
        "kinds": kinds,
        "source": source,
        "in_git": not relative.startswith("local/"),
        "alert_path": "email.rfc822" if is_email else path.name,
        "meta_tags": [] if is_email else ["type=email.attachment"],
    }
    if note:
        record["note"] = note
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--ace3", type=Path, default=REPO.parent / "ace3")
    args = parser.parse_args()
    ace3 = args.ace3.resolve()
    commit = subprocess.run(
        ["git", "-C", str(ace3), "rev-parse", "--short=8", "HEAD"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()

    samples = []
    shutil.rmtree(SAMPLES / "ace3", ignore_errors=True)
    for relative, directory, kinds, note in ACE3_FIXTURES:
        source = ace3 / relative
        target = SAMPLES / "ace3" / directory / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
        samples.append(entry(target, kinds, f"ace3 {commit}: {relative}", note))

    shutil.rmtree(SAMPLES / "local", ignore_errors=True)
    with tempfile.TemporaryDirectory() as work:
        for path, kinds, how in make_local(SAMPLES / "local", Path(work)):
            samples.append(entry(path, kinds, f"made by tools/samples/gather: {how}"))

    e2e_email = SAMPLES / "ace4" / "email" / "e2e.email.rfc822"
    make_e2e_email(e2e_email)
    samples.append(
        entry(e2e_email, ["email", "archive/zip"], "made by tools/samples/gather: Python email")
    )

    docm = SAMPLES / "ace3" / "office" / "mortgage_payment-0873821-0565.docm"
    for path in make_office_edges(SAMPLES / "ace4" / "office", docm):
        samples.append(entry(path, ["office/edge"], "made by tools/samples/gather: by hand"))

    macro_doc = (SAMPLES / "ace3" / "office" / "receipt_687790.doc").read_bytes()
    for path in make_rtf_edges(SAMPLES / "ace4" / "rtf", macro_doc):
        samples.append(entry(path, ["rtf", "rtf/edge"], "made by tools/samples/gather: by hand"))

    office_files, office_emails = make_encrypted_office(SAMPLES / "ace4" / "office", SAMPLES / "ace4" / "email")
    how = "made by tools/samples/gather: tools/samples/make-encrypted-office"
    for path in office_files:
        samples.append(entry(path, ["office/encrypted"], how))
    for path in office_emails:
        samples.append(entry(path, ["email", "office/encrypted"], how))

    covered = {kind for sample in samples for kind in sample["kinds"]}
    missing = [kind for kind in REQUIRED_KINDS if kind not in covered]
    manifest = {
        "about": (
            "The local sample set from PLAN.md step 0.8, written by tools/samples/gather. "
            "alert_path and meta_tags give the unit each file is scanned as: an email is "
            "the alert's root file email.rfc822 with no tags, and anything else is an "
            "email attachment at the alert's top level tagged type=email.attachment. "
            "Files under local/ aren't in git; rerun the script to make them."
        ),
        "ace3_commit": commit,
        "required_kinds": REQUIRED_KINDS,
        "gaps": [
            "an encrypted RAR: making one needs RARLAB's non-free rar tool",
            "a legacy .xls (BIFF8) with an Excel 4.0 macro sheet: nothing here writes one",
            "PowerPoint and Excel files with VBA macros: ace3's tests hold Word ones only",
            "an encrypted PDF: ace3's tests build theirs with pikepdf at test time",
            "an encrypted .ppt, and an RC4 .doc: msoffcrypto writes neither, only ace3's RC4 .xls is here",
        ],
        "samples": sorted(samples, key=lambda sample: sample["path"]),
    }
    (SAMPLES / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")

    for kind in REQUIRED_KINDS:
        count = sum(kind in sample["kinds"] for sample in samples)
        print(f"{kind:18} {count:3} samples")
    if missing:
        print(f"missing kinds: {', '.join(missing)}", file=sys.stderr)
        return 1
    print(f"wrote {len(samples)} samples to samples/manifest.json")
    return 0


if __name__ == "__main__":
    sys.exit(main())
