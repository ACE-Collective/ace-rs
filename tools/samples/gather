def make_local(local, work):
    """Makes the local samples and returns (path, kinds, how it was made) for each."""
    made = []

    def add(relative, kinds, how):
        made.append((local / relative, kinds, how))

    archive = local / "archive"
    archive.mkdir(parents=True)

    seven_zip(archive / "password-infected.zip", work, "-tzip", "-pinfected", "-mem=ZipCrypto")
    add("archive/password-infected.zip", ["archive/zip", "archive/password"],
        "7z, ZipCrypto, password infected, one text member")
    seven_zip(archive / "password-infected-aes256.zip", work, "-tzip", "-pinfected", "-mem=AES256")
    add("archive/password-infected-aes256.zip", ["archive/zip", "archive/password"],
        "7z, AES-256, password infected, one text member")
    seven_zip(archive / "password-infected.7z", work, "-t7z", "-pinfected")
    add("archive/password-infected.7z", ["archive/7z", "archive/password"],
        "7z, password infected, member names visible")
    seven_zip(archive / "password-infected-headers.7z", work, "-t7z", "-pinfected", "-mhe=on")
    add("archive/password-infected-headers.7z", ["archive/7z", "archive/password"],
        "7z, password infected, member names encrypted too")

    inner = work / "inner.zip"
    write_zip(inner, {"readme.txt": BENIGN_TEXT})
    write_zip(archive / "nested.zip", {"inner.zip": inner.read_bytes()})
    add("archive/nested.zip", ["archive/zip", "archive/nested"],
        "Python zipfile, a zip inside a zip holding one text file")
    write_zip(archive / "zip-slip.zip", {"../x": BENIGN_TEXT, "readme.txt": BENIGN_TEXT})
    add("archive/zip-slip.zip", ["archive/zip", "archive/path-traversal"],
        "Python zipfile, a member named ../x beside a normal one")

    # An email whose zip attachment is encrypted with a password given in the body, as
    # ace3/tests/saq/modules/email/test_encryption.py builds it.
    mail = local / "email"
    mail.mkdir(parents=True)
    password = "Secr3tPw"
    payload = work / "invoice.txt"
    payload.write_text("the decrypted payload https://payload.example.com/x\n")
    os.utime(payload, (FIXED_EPOCH, FIXED_EPOCH))
    run("7z", "a", "-tzip", f"-p{password}", "invoice.zip", payload.name, cwd=work)
    message = email.message.EmailMessage()
    message["From"] = "sender@example.com"
    message["To"] = "recipient@example.com"
    message["Subject"] = "invoice"
    message["Message-ID"] = "<encrypted-zip-sample@example.com>"
    message.set_content(f"The password for the attached invoice is {password} thanks")
    message.add_attachment(
        (work / "invoice.zip").read_bytes(), maintype="application", subtype="zip", filename="invoice.zip"
    )
    message.set_boundary("ace4-sample-boundary")
    (mail / "encrypted_zip_password_in_body.email.rfc822").write_bytes(bytes(message))
    add("email/encrypted_zip_password_in_body.email.rfc822", ["email", "archive/password"],
        "Python email, a zip encrypted with the password Secr3tPw, which the body gives")

    office = local / "office"
    office.mkdir(parents=True)
    write_zip(office / "invoice.xlsm", XLSM_PARTS)
    add("office/invoice.xlsm", ["office/macro", "office/ooxml"],
        "Python zipfile, an Excel 4.0 (XLM) auto-open macro sheet")

    rtf = local / "rtf"
    rtf.mkdir(parents=True)
    data = ole1_package(b"payload.exe", b"MZ" + b"\x90" * 64).hex().encode()
    (rtf / "document.rtf").write_bytes(
        b"{\\rtf1\\ansi Hello \\par\r\n{\\object\\objemb{\\*\\objclass Package}{\\*\\objdata "
        + data
        + b"}}}"
    )
    add("rtf/document.rtf", ["rtf", "rtf/ole-object"],
        "an OLE1 Package object holding payload.exe, which is MZ and 64 NOPs")
    (rtf / "plain.rtf").write_bytes(b"{\\rtf1\\ansi\\deff0 {\\fonttbl {\\f0 Arial;}} Hello from ace4.\\par}")
    add("rtf/plain.rtf", ["rtf"], "text only, no objects")
    return made


def make_e2e_email(path):
    """The email tests/e2e/run submits and PLAN.md 3.2 compares: a DKIM signing domain the recorded
    RDAP answers for, and a stored zip attachment holding the marker tools/ace3/trees/signatures
    matches. Every byte is fixed, so it stays one sample across runs of this script."""
    archive = io.BytesIO()
    with zipfile.ZipFile(archive, "w", zipfile.ZIP_STORED) as z:
        z.writestr(
            zipfile.ZipInfo("invoice.txt", date_time=(2026, 1, 1, 0, 0, 0)),
            "Invoice 1001\nACE4-E2E-MARKER-6c1f\n",
        )
    message = email.message.EmailMessage()
    message["From"] = "Alice <alice@example.com>"
    message["To"] = "bob@example.net"
    message["Subject"] = "ace4 end-to-end"
    message["Date"] = "Sun, 01 Nov 2026 12:00:00 +0000"
    message["Message-ID"] = "<ace4-e2e@example.com>"
    message["DKIM-Signature"] = (
        "v=1; a=rsa-sha256; c=relaxed/relaxed; d=example.com; s=e2e; "
        "h=from:to:subject; bh=AAAA; b=BBBB"
    )
    message.set_content("The invoice is attached.\n")
    message.add_attachment(
        archive.getvalue(), maintype="application", subtype="zip", filename="invoice.zip"
    )
    message.set_boundary("ace4-e2e-boundary")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(message.as_bytes())


def make_url_emails(directory):
    """An email for url_extraction (PLAN.md 7.5), whose bodies the email module marks extract_urls: a
    newsletter with more links than the module makes observables of. Every byte is fixed."""
    made = []
    def write(name, subject, text, html=None):
        message = email.message.EmailMessage()
        message["From"] = "Support <support@example.com>"
        message["To"] = "bob@example.net"
        message["Subject"] = subject
        message["Date"] = "Sun, 01 Nov 2026 12:00:00 +0000"
        message["Message-ID"] = f"<{name}@example.com>"
        message.set_content(text, cte="quoted-printable" if html is None else None)
        if html is not None:
            message.add_alternative(html, subtype="html")
            message.set_boundary(f"{name}-boundary")
        path = directory / f"{name}.email.rfc822"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(message.as_bytes())
        made.append(path)
    links = "".join(
        f'<li><a href="https://{host}/{path}">{host}</a></li>'
        for host, path in [
            ("news.example.com", "a"), ("news.example.com", "b"), ("news.example.com", "c"),
            ("shop.example.net", "sale"), ("shop.example.net", "cart"),
            ("blog.example.org", "post/1"), ("cdn.example.org", "logo.png"),
            ("track.example.info", "o?u=https%3A%2F%2Fland.example.co.uk%2Fx"),
            ("198.51.100.4", "x"), ("www.w3.org", "TR/html4"), ("mail.example.com", "unsub"),
            ("news.example.com", "d"), ("news.example.com", "e"),
        ]
    )
    write(
        "url_newsletter", "News",
        "Read online: https://news.example.com/online\n",
        f"<html><body><p>This week</p><ul>{links}</ul></body></html>",
    )
    return made


def make_lure_emails(directory, macro_doc):
    """Emails for 7.5 batch 8's modules, which ace3's fixtures don't reach: lure_url_analyzer's signals
    (a button, call-to-action text, a click tracker, footer links, an image, a font host, a form, a
    protected URL, an attachment, a forwarded email, links only on the sender's domain), and an Office
    document with a macro for email_conversation_attachment_analyzer. Every byte is fixed."""
    made = []

    def message(name, subject, sender="IT Desk <it@corp.example>", to="pat@corp.example"):
        m = email.message.EmailMessage()
        m["From"] = sender
        m["To"] = to
        m["Return-Path"] = "<bounce@mailer.corp.example>"
        m["Subject"] = subject
        m["Date"] = "Mon, 09 Nov 2026 12:00:00 +0000"
        m["Message-ID"] = f"<{name}@corp.example>"
        return m

    def write(name, m):
        # every multipart its own fixed boundary, or Python picks a random one
        for i, part in enumerate(m.walk()):
            if part.is_multipart():
                part.set_boundary(f"{name}-boundary" + (f"-{i}" if i else ""))
        path = directory / f"{name}.email.rfc822"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(m.as_bytes())
        made.append(path)

    m = message("lure_button", "Action required: verify your mailbox")
    m.set_content("Verify your mailbox at https://login.lure-example.net/verify?id=7\n")
    m.add_alternative(
        '<html><head><link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet"></head><body>'
        '<p><a href="https://corp.example/"><img src="https://corp.example/logo.png" alt="Corp"></a></p>'
        '<p>Your mailbox is almost full.</p>'
