BENIGN_TEXT = b"ace4 sample set: a benign text file.\n"
# A fixed timestamp, so zips without encryption come out the same on every run.
FIXED_TIME = (2026, 10, 29, 0, 0, 0)
FIXED_EPOCH = 1793232000  # 2026-10-29T00:00:00Z


def run(*command, cwd=None):
    subprocess.run(command, cwd=cwd, check=True, capture_output=True)


def write_zip(path, members):
    with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as archive:
        for name, data in members.items():
            info = zipfile.ZipInfo(name, date_time=FIXED_TIME)
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(info, data)


def seven_zip(path, work, *flags):
    """Archives work/readme.txt into path with 7z and the given flags."""
    payload = work / "readme.txt"
    payload.write_bytes(BENIGN_TEXT)
    os.utime(payload, (FIXED_EPOCH, FIXED_EPOCH))
    run("7z", "a", *flags, str(path), payload.name, cwd=work)


def ole1_package(filename, payload):
    """An embedded OLE1 Package object, built as ace3/tests/saq/modules/file_analysis/test_rtf.py does."""
    source = b"C:\\tmp\\" + filename
    native = struct.pack("<H", 2) + filename + b"\x00" + source + b"\x00" + struct.pack("<II", 0, 0)
    native += source + b"\x00" + struct.pack("<I", len(payload)) + payload
    class_name = b"Package\x00"
    header = (
        struct.pack("<II", 0x00000501, 2)
        + struct.pack("<I", len(class_name))
        + class_name
        + struct.pack("<II", 0, 0)
    )
    return header + struct.pack("<I", len(native)) + native


