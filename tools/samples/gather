def entry(path, kinds, source, note=None):
    data = path.read_bytes()
    relative = path.relative_to(SAMPLES).as_posix()
    is_email = "email" in kinds
    record = {
        "path": relative,
        "sha256": hashlib.sha256(data).hexdigest(),
        "size": len(data),
        "kinds": kinds,
        "source": source,
        "in_git": not relative.startswith("local/"),
        "alert_path": "email.rfc822" if is_email else path.name,
        "meta_tags": [] if is_email else ["type=email.attachment"],
    }
    if note:
        record["note"] = note
    return record


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--ace3", type=Path, default=REPO.parent / "ace3")
    args = parser.parse_args()
    ace3 = args.ace3.resolve()
    commit = subprocess.run(
        ["git", "-C", str(ace3), "rev-parse", "--short=8", "HEAD"],
        check=True, capture_output=True, text=True,
    ).stdout.strip()

    samples = []
    shutil.rmtree(SAMPLES / "ace3", ignore_errors=True)
    for relative, directory, kinds, note in ACE3_FIXTURES:
        source = ace3 / relative
        target = SAMPLES / "ace3" / directory / source.name
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
        samples.append(entry(target, kinds, f"ace3 {commit}: {relative}", note))

    shutil.rmtree(SAMPLES / "local", ignore_errors=True)
    with tempfile.TemporaryDirectory() as work:
        for path, kinds, how in make_local(SAMPLES / "local", Path(work)):
            samples.append(entry(path, kinds, f"made by tools/samples/gather: {how}"))

    e2e_email = SAMPLES / "ace4" / "email" / "e2e.email.rfc822"
    make_e2e_email(e2e_email)
    samples.append(
        entry(e2e_email, ["email", "archive/zip"], "made by tools/samples/gather: Python email")
    )

    for path in make_url_emails(SAMPLES / "ace4" / "email"):
        samples.append(entry(path, ["email"], "made by tools/samples/gather: Python email"))

    receipt = (SAMPLES / "ace3" / "office" / "receipt_687790.doc").read_bytes()
    for path in make_lure_emails(SAMPLES / "ace4" / "email", receipt):
        kinds = ["email", "office/macro"] if path.name.startswith("macro_") else ["email"]
        samples.append(entry(path, kinds, "made by tools/samples/gather: Python email"))

    docm = SAMPLES / "ace3" / "office" / "mortgage_payment-0873821-0565.docm"
    for path in make_office_edges(SAMPLES / "ace4" / "office", docm):
        samples.append(entry(path, ["office/edge"], "made by tools/samples/gather: by hand"))

    macro_doc = (SAMPLES / "ace3" / "office" / "receipt_687790.doc").read_bytes()
    for path in make_rtf_edges(SAMPLES / "ace4" / "rtf", macro_doc):
        samples.append(entry(path, ["rtf", "rtf/edge"], "made by tools/samples/gather: by hand"))

    office_files, office_emails = make_encrypted_office(SAMPLES / "ace4" / "office", SAMPLES / "ace4" / "email")
    how = "made by tools/samples/gather: tools/samples/make-encrypted-office"
    for path in office_files:
        samples.append(entry(path, ["office/encrypted"], how))
    for path in office_emails:
        samples.append(entry(path, ["email", "office/encrypted"], how))
    samples.extend(
        make_encrypted_binary(SAMPLES / "ace4" / "office", SAMPLES / "ace4" / "email", SAMPLES / "ace4" / "html")
    )

    samples.append(
        entry(SAMPLES / "ace4" / "office" / "xlm_info_3805.xls", ["office/macro", "office/xlm"],
              "made by tools/samples/gather: tools/samples/make-encrypted-office: ace3's info_3805.xls, decrypted")
    )
    xlm = subprocess.run(
        [sys.executable, "-I", str(REPO / "tools" / "samples" / "make-xlm"), str(SAMPLES / "ace4" / "office")],
        check=True, capture_output=True, text=True,
    ).stdout.split()
    for name in xlm:
        samples.append(
            entry(SAMPLES / "ace4" / "office" / name, ["office/macro", "office/xlm"],
                  "made by tools/samples/gather: tools/samples/make-xlm")
        )

    # on the pdf-libraries image, because the encrypted ones go through pikepdf
    (SAMPLES / "ace4" / "pdf").mkdir(parents=True, exist_ok=True)
    pdfs = subprocess.run(
        ["docker", "run", "--rm", "--user", f"{os.getuid()}:{os.getgid()}", "-v", f"{REPO}:/repo:ro",
         "-v", f"{SAMPLES / 'ace4' / 'pdf'}:/out", pdf_libraries_image(), "python", "-I",
         "/repo/tools/samples/make-pdf", "/out"],
        check=True, capture_output=True, text=True,
    ).stdout.split()
    for name in pdfs:
        samples.append(
            entry(SAMPLES / "ace4" / "pdf" / name, ["pdf", "pdf/made"], "made by tools/samples/gather: tools/samples/make-pdf")
        )

    covered = {kind for sample in samples for kind in sample["kinds"]}
    missing = [kind for kind in REQUIRED_KINDS if kind not in covered]
    manifest = {
        "about": (
            "The local sample set from PLAN.md step 0.8, written by tools/samples/gather. "
            "alert_path and meta_tags give the unit each file is scanned as: an email is "
            "the alert's root file email.rfc822 with no tags, and anything else is an "
            "email attachment at the alert's top level tagged type=email.attachment. "
            "Files under local/ aren't in git; rerun the script to make them."
        ),
        "ace3_commit": commit,
        "required_kinds": REQUIRED_KINDS,
        "gaps": [
            "PowerPoint and Excel files with VBA macros: ace3's tests hold Word ones only",
            "binary RC4 without CryptoAPI as Office 97 wrote it: tools/samples/make-encrypted-binary writes it from MS-OFFCRYPTO",
        ],
        "samples": sorted(samples, key=lambda sample: sample["path"]),
    }
    (SAMPLES / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")

    for kind in REQUIRED_KINDS:
        count = sum(kind in sample["kinds"] for sample in samples)
        print(f"{kind:18} {count:3} samples")
    if missing:
        print(f"missing kinds: {', '.join(missing)}", file=sys.stderr)
        return 1
    print(f"wrote {len(samples)} samples to samples/manifest.json")
    return 0


if __name__ == "__main__":
    sys.exit(main())
