def make_office_edges(directory, macro_docm):
    """Files for what ace3's olevba decides before it opens a file and when it can't, which ace3's
    fixtures don't reach. Every byte is fixed. `macro_docm` gives the last one a real VBA project."""
    with zipfile.ZipFile(macro_docm) as z:
        project = z.read("word/vbaProject.bin")
    mso = b"ActiveMime".ljust(0x32, b"\0") + zlib.compress(project, 9)
    files = {
        # the two mime types ace3's module leaves alone, under an Office extension
        "html_named.doc": b"<html><body>not a Word document</body></html>\n",
        "text_named.doc": b"This is plain text, not a Word document.\n",
        # no format oletools knows, so an Office extension gets olevba_failed
        "garbage.doc": bytes(range(256)) * 8,
        # oletools reads anything without a NUL as source code: XML, so its mime type isn't plain
        "source.doc": b'<?xml version="1.0"?>\n<a>\nSub AutoOpen()\nShell "calc.exe"\nEnd Sub\n</a>\n',
        # a Word "single file web page" whose part's name decodes to a lone surrogate, which JSON
        # text can't carry. oletools skips what's before MIME, which keeps its mime type off text/plain
        "surrogate_name.doc": (
            b"\x00\x01\xff\r\nMIME-Version: 1.0\r\nContent-Type: multipart/related; boundary=\"b\"\r\n\r\n--b\r\n"
            b"Content-Type: application/x-mso\r\nContent-Transfer-Encoding: base64\r\n"
            b"Content-Disposition: attachment; filename*=raw-unicode-escape''%5Cud800.mso\r\n\r\n"
            + base64.encodebytes(mso).replace(b"\n", b"\r\n")
            + b"\r\n--b--\r\n"
        ),
    }
    directory.mkdir(parents=True, exist_ok=True)
    for name, data in files.items():
        (directory / name).write_bytes(data)
    return [directory / name for name in files]


def encrypted_email(path, body, attachments=(), html=None, nested=None):
    """An email for ace3's msoffice module, with fixed headers, so only the files' salts change."""
    message = email.message.EmailMessage()
    message["From"] = "sender@example.com"
    message["To"] = "recipient@example.com"
    message["Subject"] = "the attached file"
    message["Date"] = "Fri, 06 Nov 2026 12:00:00 +0000"
    message["Message-ID"] = f"<{path.name}@example.com>"
    if body is not None:
        message.set_content(body)
    if html is not None:
        message.add_alternative(html, subtype="html")
    if body is None and html is None:
        message.make_mixed()
    for name, data in attachments:
        message.add_attachment(data, maintype="application", subtype="octet-stream", filename=name)
    if nested is not None:
        message.add_attachment(nested)
    return message


