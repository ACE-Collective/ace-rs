def make_encrypted_binary(directory, email_directory, html_directory):
    """Each kind of encryption msoffcrypto reads, on its own at the top level as well as in an email: Office's
    own files from msoffcrypto-tool's tests, and tools/samples/make-encrypted-binary's for what those
    don't cover, broken ones included. A top-level file gets only the two default passwords, as it
    has no email; tools/library-diff tries its whole list on every file."""
    for name, digest in MSOFFCRYPTO_FILES.items():
        with urllib.request.urlopen(MSOFFCRYPTO_INPUTS + name) as response:
            data = response.read()
        if hashlib.sha256(data).hexdigest()[:20] != digest:
            raise SystemExit(f"{name} isn't the file this was written for")
        (directory / f"msoffcrypto_{name}").write_bytes(data)
    with tempfile.TemporaryDirectory(dir=REPO / "target") as work:
        subprocess.run(
            ["docker", "run", "--rm", "-u", f"{os.getuid()}:{os.getgid()}", "--entrypoint", "python3",
             "-v", f"{REPO}:/repo:ro", "-v", f"{work}:/out", library_image(), "-I", "-B",
             "/repo/tools/samples/make-encrypted-binary", "/out",
             "/repo/samples/ace3/office/doc.doc", "/repo/samples/ace3/office/doc.docx",
             "/repo/samples/ace3/email/encrypted_msoffice.email.rfc822"],
            check=True, stdout=subprocess.DEVNULL,
        )
        made = {path.name: path.read_bytes() for path in Path(work).iterdir()}
    files = []
    for name, data in made.items():
        (directory / f"encrypted_{name}").write_bytes(data)
        files.append(directory / f"encrypted_{name}")
    html_directory.mkdir(parents=True, exist_ok=True)
    bodies = []
    for name, text in HTML_BODIES.items():
        path = html_directory / f"html2text_{name}"
        path.write_bytes(text.encode())
        bodies.append(path)
    emails = {
        "encrypted_rc4_doc.email.rfc822": ("The password is R4Binary1\n", "invoice.doc", "rc4.doc", None),
        "encrypted_cryptoapi_doc.email.rfc822": ("The password is CryptoAp1\n", "invoice.doc", "cryptoapi.doc", None),
        "encrypted_rc4_xls.email.rfc822": ("The password is R4Binary1\n", "invoice.xls", "rc4.xls", None),
        "encrypted_cryptoapi_ppt.email.rfc822": ("The password is CryptoAp1\n", "invoice.ppt", "cryptoapi.ppt", None),
        "encrypted_rc4_wrong.email.rfc822": ("The password is Wr0ngOne\n", "invoice.doc", "rc4_not_in_list.doc", None),
        "encrypted_ppt_wrong.email.rfc822": ("The password is Wr0ngOne\n", "invoice.ppt", "cryptoapi.ppt", None),
        "encrypted_not_zip.email.rfc822": ("The password is Secr3tPw\n", "invoice.docx", "not_zip.docx", None),
        "encrypted_html_markup.email.rfc822": (
            "See the HTML part\n", "invoice.docx", "agile.docx",
            '<html><head><title>x</title></head><body><h2>Your &amp; document</h2><ol start="2"><li>Open it</li>'
            '<li>Use <a href="http://x.test/help">the <b>password</b></a>: <code>Secr3tPw</code></li></ol>'
            "<table><tr><td>a</td><td>b</td></tr></table></body></html>\n",
        ),
        "encrypted_body_raises.email.rfc822": ("before &#1a after\n", "invoice.docx", "agile.docx", None),
        "encrypted_agile_sha1.email.rfc822": ("The password is Secr3tPw\n", "invoice.docx", "agile_sha1.docx", None),
        "encrypted_agile_sha256.email.rfc822": ("The password is Secr3tPw\n", "invoice.docx", "agile_sha256.docx", None),
    }
    paths = []
    for name, (body, attachment, source, html) in emails.items():
        path = email_directory / name
        message = encrypted_email(path, body, [(attachment, made[source])], html=html)
        path.write_bytes(message.as_bytes())
        paths.append(path)
    how = "made by tools/samples/gather: tools/samples/make-encrypted-binary"
    records = [
        entry(directory / f"msoffcrypto_{name}", ["office/encrypted"],
              f"msoffcrypto-tool v6.0.0 tests/inputs/{name}, written by Office")
        for name in MSOFFCRYPTO_FILES
    ]
    records += [entry(path, ["office/encrypted"], how) for path in files]
    records += [entry(path, ["email", "office/encrypted"], how) for path in paths]
    records += [entry(path, ["html/body"], "made by tools/samples/gather: HTML_BODIES") for path in bodies]
    return records


