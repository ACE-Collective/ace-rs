B64_DOC = base64.encodebytes(b"MZ\x90\x00 an attachment hidden in MIME\n" * 3).decode()


def nested_mime(n):
    """Multiparts nested n deep around one text part."""
    out = 'junk\nContent-Type: multipart/mixed; boundary="b0"\n\n'
    for i in range(n):
        out += f'--b{i}\nContent-Type: multipart/mixed; boundary="b{i + 1}"\n\n'
    out += f"--b{n}\nContent-Type: text/plain\n\ndeep part\n"
    for i in range(n, -1, -1):
        out += f"--b{i}--\n"
    return out.encode()


