def fdso(payload, length=None, filler=b"\0" * 12):
    """A FileDataStoreObject: its GUID, cbLength, 12 unused bytes and the data."""
    return FDSO_GUID + struct.pack("<Q", len(payload) if length is None else length) + filler + payload


def onenote(*objects, header=ONE_HEADER):
    body = header + bytes(1024 - len(header))
    for obj in objects:
        body += obj + b"\0" * 8
    return body


