    with zipfile.ZipFile(SOURCE_DOCM) as archive:
        real_vba = archive.read("word/vbaProject.bin")
    ole = ole_fixtures(real_vba)
    mht = (SAMPLES / "ace-rs" / "office" / "vba_mht.mht").read_bytes()
    write(FIXTURES / "onenote", onenote_fixtures())
    write(FIXTURES / "activemime", activemime_fixtures(ole["native.doc"]))
    write(FIXTURES / "mime", hidden_mime_fixtures(mht))
    write(FIXTURES / "flat", xml_binary_fixtures(real_vba))
    write(FIXTURES / "plain", plain_text_fixtures())
    write(FIXTURES / "rels", rels_fixtures())
    write(FIXTURES / "ole", ole)
    write(FIXTURES / "extracted", extracted_ole_fixtures())
    (FIXTURES / "source.docx").write_bytes(office_zip([("word/document.xml", document_xml("<w:p/>"))]))

    made = []
    for name, data in samples(real_vba, ole["native.doc"]).items():
        (OFFICE / name).write_bytes(data)
        made.append(
            {
                "path": f"ace-rs/office/{name}",
                "sha256": hashlib.sha256(data).hexdigest(),
                "size": len(data),
                "kinds": ["office/containers"],
                "source": SOURCE,
                "in_git": True,
                "alert_path": name,
                "meta_tags": ["type=email.attachment"],
            }
        )
    manifest_path = SAMPLES / "manifest.json"
    manifest = json.loads(manifest_path.read_text())
    kept = [s for s in manifest["samples"] if s.get("source") != SOURCE]
    manifest["samples"] = sorted(kept + made, key=lambda s: s["path"])
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    print(f"{len(made)} samples")


if __name__ == "__main__":
    main()
