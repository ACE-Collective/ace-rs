# --- ActiveMime --------------------------------------------------------------------------------


def activemime(payload, field_size=4, field_d=4, field_e=4, tail=b"", compressed=None, head=b"ActiveMime\0\0", field=None):
    """ace3's parse_active_mime layout: 12 bytes, 2, a sized field, 4, the compressed size and the
    sizes of two fields, the first, the vba tail type, the size, then zlib."""
    body = zlib.compress(payload) if compressed is None else compressed
    out = head + b"\x01\xf0" + struct.pack("<I", field_size) + (b"\xff" * field_size if field is None else field)
    out += b"\x01\x00\x00\xf0" + struct.pack("<III", len(body), field_d, field_e) + bytes(field_d)
    out += struct.pack("<I", 1) + struct.pack("<I", len(payload)) + body + tail
    return out


