# --- Word 2003 XML packages --------------------------------------------------------------------

PKG = "http://schemas.microsoft.com/office/2006/xmlPackage"


def flat(parts, progid="Word.Document", head=""):
    out = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n' + head
    out += f'<?mso-application progid="{progid}"?>\n<pkg:package xmlns:pkg="{PKG}">\n'
    for name, kind, body in parts:
        name_attr = "" if name is None else f' pkg:name="{name}"'
        if kind == "binary":
            out += f'<pkg:part{name_attr} pkg:contentType="application/octet-stream"><pkg:binaryData>{body}</pkg:binaryData></pkg:part>\n'
        else:
            out += f'<pkg:part{name_attr} pkg:contentType="application/xml"><pkg:xmlData>{body}</pkg:xmlData></pkg:part>\n'
    return out + "</pkg:package>\n"


def b64(data, width=76):
    text = base64.b64encode(data).decode()
    return "\n".join(text[i:i + width] for i in range(0, len(text), width))


