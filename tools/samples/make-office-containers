# --- compound files for officeparser3 ----------------------------------------------------------


def ole10native(filename, data, src=b"C:\\src\\x", temp=b"C:\\tmp\\x"):
    """An \\x01Ole10Native stream as Packager writes it."""
    body = struct.pack("<H", 2) + filename + b"\0" + src + b"\0" + bytes(8) + temp + b"\0" + struct.pack("<I", len(data)) + data
    return struct.pack("<I", len(body)) + body


def vba_project(modules, project_lines=None):
    """A VBA project of (name, source) modules, each a standard module."""
    lines = project_lines if project_lines is not None else [f"Module={name}" for name, _ in modules]
    vba = {
        "_VBA_PROJECT": struct.pack("<HHBH", 0x61CC, 0xFFFF, 0, 0),
        "dir": compress_literal(dir_stream([(name, name, 0) for name, _ in modules])),
    }
    stream_names = {}
    for name, source in modules:
        stream_names[name] = compress_literal(source)
    vba.update(stream_names)
    return {
        "PROJECT": b'ID="{00000000-0000-0000-0000-000000000000}"\r\n' + b"".join(l.encode("latin1") + b"\r\n" for l in lines) + b'Name="VBAProject"\r\n',
        "PROJECTwm": b"",
        "VBA": vba,
    }


MACRO = b'Attribute VB_Name = "Module1"\r\nSub AutoOpen()\r\n  Shell "cmd /c echo officeparser"\r\nEnd Sub\r\n'
EMPTY_MACRO = b'Attribute VB_Name = "Empty"\r\n\r\nAttribute VB_Exposed = False\r\n'
VBS = b'CreateObject("WScript.Shell").Run "calc.exe"\r\n'


def native_storage(filename, data):
    return {"\x01Ole10Native": ole10native(filename, data), "\x01CompObj": b"\x01\x00\xfe\xff" + bytes(24)}


