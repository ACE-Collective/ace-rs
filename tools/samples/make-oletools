def main():
    with zipfile.ZipFile(SOURCE_DOCM) as archive:
        real_vba = archive.read("word/vbaProject.bin")
    manifest_path = SAMPLES / "manifest.json"
    manifest = json.loads(manifest_path.read_text())
    kept = [s for s in manifest["samples"] if not s.get("source", "").startswith("tools/samples/make-oletools")]
    made = []
    for folder, samples, kind in ((OFFICE, office_samples(real_vba), "office"), (RTF, rtf_samples(real_vba), "rtf")):
        folder.mkdir(parents=True, exist_ok=True)
        for name, data in samples.items():
            (folder / name).write_bytes(data)
            made.append(
                {
                    "path": f"ace4/{folder.name}/{name}",
                    "sha256": hashlib.sha256(data).hexdigest(),
                    "size": len(data),
                    "kinds": [f"{kind}/hand-made"],
                    "source": "tools/samples/make-oletools",
                    "in_git": True,
                    "alert_path": name,
                    "meta_tags": ["type=email.attachment"],
                }
            )
    manifest["samples"] = sorted(kept + made, key=lambda s: s["path"])
    manifest["gaps"] = [
        gap for gap in manifest["gaps"] if not gap.startswith("PowerPoint and Excel files with VBA macros")
    ] + ["PowerPoint and Excel files with VBA written by Office itself: tools/samples/make-oletools hand-makes the containers around a Word project"]
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    print(f"{len(made)} samples")


if __name__ == "__main__":
    main()
