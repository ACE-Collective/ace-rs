FREE = 0xFFFFFFFF
END = 0xFFFFFFFE
FATSECT = 0xFFFFFFFD
NOSTREAM = 0xFFFFFFFF
EXCEL_CLSID = bytes.fromhex("2008020000000000C000000000000046")
PPT_CLSID = bytes.fromhex("108D81649B4FCF1186EA00AA00B929E8")
