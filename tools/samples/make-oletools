def fat_loop(cfb):
    """A stream that claims more than it has, in a FAT that goes in a circle."""
    first = next(e for e in cfb.entries if e["name"] == "big")
    cfb.fat[first["start"]] = first["start"]
    first["size"] = 1 << 20


def dir_cycle(cfb):
    cfb.entries[1]["right"] = 1
    cfb.entries[1]["child"] = 0


def bad_name_length(cfb):
    cfb.entries[1]["name_length"] = 0
    cfb.entries[2]["name_length"] = 1
    cfb.entries[3]["name_length"] = 500


def broken_mini(cfb):
    module = next(e for e in cfb.entries if e["name"] == "Module1")
    cfb.minifat[module["start"]] = 0xFFFFFF00


def orphan(cfb):
    """Leaves the module stream with no parent: VBA's chain skips it."""
    vba = next(e for e in cfb.entries if e["name"] == "VBA")
    sids = {e["name"]: sid for sid, e in enumerate(cfb.entries)}
    vba["child"] = sids["dir"]
    cfb.entries[sids["dir"]]["right"] = sids["_VBA_PROJECT"]
    cfb.entries[sids["_VBA_PROJECT"]]["right"] = NOSTREAM


def deep_directory(count):
    """A compound file whose directory is one chain of right siblings, deeper than Python's stack."""
    return Cfb({f"s{i}": b"x" for i in range(count)})


