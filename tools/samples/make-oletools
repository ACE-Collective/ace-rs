    add("ole_bad_sector_shift.doc", good[:30] + struct.pack("<H", 16) + good[32:])
    add("ole_huge_sector_shift.doc", good[:30] + struct.pack("<H", 70) + good[32:])
    add("ole_small_sector_shift.doc", good[:30] + struct.pack("<H", 1) + good[32:])
    add("ole_bad_difat.doc", good[:68] + struct.pack("<II", 1, 1) + good[76:])
    add("ole_bad_difat_count.doc", good[:44] + struct.pack("<I", 200) + good[48:68] + struct.pack("<II", 1, 1) + good[76:])
    add("ole_bad_directory_start.doc", good[:48] + struct.pack("<I", 0xFFFFFF00) + good[52:])

    rels, types = RELS % "word/document.xml", TYPES % ("word/document.xml", docm)
    add("zip_no_types.docm", office_zip([("_rels/.rels", rels), ("word/vbaProject.bin", real_vba)]))
    add("zip_bad_rels.docm", office_zip([("_rels/.rels", "<not xml"), ("[Content_Types].xml", types), ("word/vbaProject.bin", real_vba)]))
    add("zip_bad_types.docm", office_zip([("_rels/.rels", rels), ("[Content_Types].xml", "<Types"), ("word/vbaProject.bin", real_vba)]))
    add("zip_no_part_name.docm", office_zip([("_rels/.rels", rels), ("[Content_Types].xml", '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Override ContentType="a"/></Types>')]))
    corrupt = bytearray(ooxml("word/document.xml", docm, "word/vbaProject.bin", real_vba))
    at = corrupt.index(b"word/vbaProject.bin") + len("word/vbaProject.bin")
    corrupt[at:at + 40] = b"\xff" * 40
    add("zip_bad_deflate.docm", bytes(corrupt))
    add("zip_junk_ole_member.docm", ooxml("word/document.xml", docm, "word/vbaProject.bin", real_vba[:600]))
    return samples


def stomp(real_tree):
    """The same project with each module's source replaced, keeping its p-code."""
    tree = json_copy(real_tree)
    vba = tree["VBA"]
    for name, data in list(vba.items()):
        if isinstance(data, bytes) and name not in ("dir", "_VBA_PROJECT", "__SRP_0", "__SRP_1", "__SRP_2", "__SRP_3"):
            at = data.rfind(b"\x01")
            offset = find_source(data)
            if offset is not None:
                vba[name] = data[:offset] + compress_literal(b'Attribute VB_Name = "' + name.encode() + b'"\r\n')
    return tree


def find_source(data):
    at = data.find(b"Attribut")
    while at != -1:
        if at >= 4 and data[at - 4] == 1:
            return at - 4
        at = data.find(b"Attribut", at + 1)
    return None


def json_copy(tree):
    return {key: json_copy(value) if isinstance(value, dict) else value for key, value in tree.items()}


def ole1(class_name, data, format_id=2):
    def lp(text):
        return struct.pack("<I", len(text) + 1) + text + b"\0" if text is not None else struct.pack("<I", 0)

    head = struct.pack("<II", 0x501, format_id) + lp(class_name) + lp(b"") + lp(b"")
    return head + struct.pack("<I", len(data)) + data if format_id == 2 else head


def package(filename, src, temp, data):
    return struct.pack("<H", 2) + filename + b"\0" + src + b"\0" + bytes(8) + temp + b"\0" + struct.pack("<I", len(data)) + data


def objdata(raw, wrap=None):
    hexed = raw.hex()
    if wrap:
        hexed = "\n".join(hexed[i:i + wrap] for i in range(0, len(hexed), wrap))
    return "{\\object\\objemb{\\*\\objdata " + hexed + "}}"


