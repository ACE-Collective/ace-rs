EPOCH = (2026, 1, 1, 0, 0, 0)


class Cfb:
    """A version 3 compound file, built from a tree of {name: bytes or {name: ...}}. Each storage's
    children hang off a chain of right siblings, which olefile reads like any tree."""

    def __init__(self, tree, clsid=bytes(16), mini_cutoff=4096):
        self.entries = []
        self.sectors = []
        self.fat = []
        self.ministream = bytearray()
        self.minifat = []
        self.clsid = clsid
        self.cutoff = mini_cutoff
        self.add(("Root Entry", tree), 5)

    def alloc(self, data):
        if not data:
            return END
        count = (len(data) + 511) // 512
        first = len(self.sectors)
        for index in range(count):
            self.sectors.append(data[index * 512:(index + 1) * 512].ljust(512, b"\0"))
            self.fat.append(first + index + 1 if index + 1 < count else END)
        return first

    def alloc_mini(self, data):
        if not data:
            return END
        count = (len(data) + 63) // 64
        first = len(self.minifat)
        for index in range(count):
            self.ministream += data[index * 64:(index + 1) * 64].ljust(64, b"\0")
            self.minifat.append(first + index + 1 if index + 1 < count else END)
        return first

    def add(self, item, kind=None):
        name, value = item
        sid = len(self.entries)
        entry = {"name": name, "left": NOSTREAM, "right": NOSTREAM, "child": NOSTREAM, "start": END, "size": 0}
        self.entries.append(entry)
        if isinstance(value, dict):
            entry["type"] = kind or 1
            previous = None
            # by length and name, as a compound file sorts them
            for child_item in sorted(value.items(), key=lambda kv: (len(kv[0]), kv[0].upper())):
                child = self.add(child_item)
                if previous is None:
                    entry["child"] = child
                else:
                    self.entries[previous]["right"] = child
                previous = child
        else:
            entry["type"] = 2
            entry["size"] = len(value)
            entry["data"] = value
        return sid

    def build(self, mutate=None):
        for entry in self.entries:
            if entry["type"] == 2:
                data = entry.pop("data")
                entry["start"] = self.alloc_mini(data) if len(data) < self.cutoff else self.alloc(data)
        root = self.entries[0]
        root["size"] = len(self.ministream)
        root["start"] = self.alloc(bytes(self.ministream))
        minifat_raw = b"".join(struct.pack("<I", v) for v in self.minifat)
        minifat_raw += struct.pack("<I", FREE) * (-(len(self.minifat)) % 128)
        minifat_start = self.alloc(minifat_raw)
        minifat_sectors = len(minifat_raw) // 512
        if mutate:
            mutate(self)
        directory = b"".join(self.direntry(e, sid) for sid, e in enumerate(self.entries))
        directory += self.direntry(None, 0) * (-len(self.entries) % 4)
        dir_start = self.alloc(directory)
        # the FAT covers itself
        fat_sectors = 1
        while True:
            total = len(self.sectors) + fat_sectors
            if total <= fat_sectors * 128:
                break
            fat_sectors += 1
        first_fat = len(self.sectors)
        fat = list(self.fat) + [FATSECT] * fat_sectors
        fat += [FREE] * (-len(fat) % 128)
        fat_raw = struct.pack(f"<{len(fat)}I", *fat)
        difat = [first_fat + i for i in range(fat_sectors)] + [FREE] * (109 - fat_sectors)
        header = b"\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1" + bytes(16)
        header += struct.pack("<HHHHH", 0x3E, 3, 0xFFFE, 9, 6) + bytes(6)
        header += struct.pack("<IIIIIIIII", 0, fat_sectors, dir_start, 0, 4096, minifat_start, minifat_sectors, END, 0)
        header += struct.pack("<109I", *difat)
        self.header_fields = {"dir_start": dir_start}
        return header + b"".join(self.sectors) + fat_raw

    def direntry(self, entry, sid):
        if entry is None:
            return bytes(64) + struct.pack("<HBB", 0, 0, 0) + struct.pack("<III", NOSTREAM, NOSTREAM, NOSTREAM) + bytes(36) + struct.pack("<IQ", 0, 0)[:12]
        name = entry["name"].encode("utf-16-le")
        length = entry.get("name_length", len(name) + 2)
        clsid = self.clsid if sid == 0 else bytes(16)
        raw = name[:64].ljust(64, b"\0") + struct.pack("<HBB", length, entry["type"], 1)
        raw += struct.pack("<III", entry["left"], entry["right"], entry["child"])
        raw += clsid + bytes(4) + bytes(16) + struct.pack("<II", entry["start"], entry["size"]) + bytes(4)
        assert len(raw) == 128
        return raw


def tree_of(ole_bytes):
    """Reads a compound file back into a tree, simply: enough for a well-formed project."""
    sector = 512
    fat = []
    difat = struct.unpack("<109I", ole_bytes[76:512])
    for index in difat:
        if index >= 0xFFFFFFFE:
            continue
        fat += struct.unpack("<128I", ole_bytes[(index + 1) * 512:(index + 2) * 512])

    def chain(start):
        out = bytearray()
        while start < 0xFFFFFFFA:
            out += ole_bytes[(start + 1) * sector:(start + 2) * sector]
            start = fat[start]
        return bytes(out)

    dir_raw = chain(struct.unpack("<I", ole_bytes[48:52])[0])
    entries = [dir_raw[i:i + 128] for i in range(0, len(dir_raw), 128)]
    mini_raw = chain(struct.unpack("<I", ole_bytes[60:64])[0])
    minifat = struct.unpack(f"<{len(mini_raw) // 4}I", mini_raw)
    root = entries[0]
    ministream = chain(struct.unpack("<I", root[116:120])[0])

    def read(entry):
        start, size = struct.unpack("<II", entry[116:124])
        if size < 4096:
            out = bytearray()
            while start < 0xFFFFFFFA:
                out += ministream[start * 64:(start + 1) * 64]
                start = minifat[start]
            return bytes(out[:size])
        return chain(start)[:size]

    def children(sid, out):
        if sid == NOSTREAM:
            return
        entry = entries[sid]
        left, right, child = struct.unpack("<III", entry[68:80])
        children(left, out)
        length = struct.unpack("<H", entry[64:66])[0]
        name = entry[:length - 2].decode("utf-16-le")
        if entry[66] == 1:
            sub = {}
            children(child, sub)
            out[name] = sub
        elif entry[66] == 2:
            out[name] = read(entry)
        children(right, out)

    tree = {}
    children(struct.unpack("<I", root[76:80])[0], tree)
    return tree


def compress_literal(data):
    """MS-OVBA compression with no copy tokens: valid, and simple."""
    out = bytearray(b"\x01")
    for start in range(0, max(len(data), 1), 4096):
        chunk = data[start:start + 4096]
        body = bytearray()
        for at in range(0, len(chunk), 8):
            piece = chunk[at:at + 8]
            body.append(0)
            body += piece
        header = 0xB000 | (len(body) + 2 - 3)
        out += struct.pack("<H", header) + body
    return bytes(out)


def dir_stream(modules, codepage=1252):
    """A dir stream, with the records VBA_Project reads. modules is (name, stream, offset)."""

    def record(rid, data):
        return struct.pack("<HI", rid, len(data)) + data

    out = record(1, struct.pack("<I", 1))
    out += record(2, struct.pack("<I", 0x409))
    out += record(0x14, struct.pack("<I", 0x409))
    out += record(3, struct.pack("<H", codepage))
    out += record(4, b"VBAProject")
    out += record(5, b"") + record(0x40, b"")
    out += record(6, b"") + record(0x3D, b"")
    out += record(7, struct.pack("<I", 0))
    out += record(8, struct.pack("<I", 0))
    out += struct.pack("<HIIH", 9, 4, 1, 0)
    out += record(0x0C, b"") + record(0x3C, b"")
    out += record(0x0F, struct.pack("<H", len(modules)))
    out += record(0x13, struct.pack("<H", 0xFFFF))
    for name, stream, offset in modules:
        raw = name.encode("latin1") if codepage == 1252 else name
        out += record(0x19, raw)
        stream_raw = stream.encode("latin1") if codepage == 1252 else stream
        unicode_name = (stream if isinstance(stream, str) else stream.decode("cp932")).encode("utf-16-le")
        out += struct.pack("<HI", 0x1A, len(stream_raw)) + stream_raw
        out += struct.pack("<HI", 0x32, len(unicode_name)) + unicode_name
        out += record(0x1C, b"") + record(0x48, b"")
        out += record(0x31, struct.pack("<I", offset))
        out += record(0x1E, struct.pack("<I", 0))
        out += record(0x2C, struct.pack("<H", 0xFFFF))
        out += struct.pack("<HI", 0x21, 0)
        out += struct.pack("<HI", 0x2B, 0)
    out += struct.pack("<HI", 0x10, 0)
    return out


def project(source, codepage=1252, name="Module1"):
    """A minimal VBA project tree holding one module with no p-code."""
    raw_name = name if codepage == 1252 else name.encode("cp932")
    return {
        "PROJECT": b'ID="{00000000-0000-0000-0000-000000000000}"\r\nModule=' + (raw_name.encode() if isinstance(raw_name, str) else raw_name) + b'\r\nName="VBAProject"\r\n',
        "PROJECTwm": b"",
        "VBA": {
            "_VBA_PROJECT": struct.pack("<HHBH", 0x61CC, 0xFFFF, 0, 0),
            "dir": compress_literal(dir_stream([(raw_name, raw_name, 0)], codepage)),
            name: compress_literal(source),
        },
    }


def biff(sheets):
    """A Workbook stream: BOF, a BOUNDSHEET for each (name, type), EOF."""

    def record(kind, data):
        return struct.pack("<HH", kind, len(data)) + data

    out = record(0x0809, struct.pack("<HHHHII", 0x0600, 5, 0x1FFF, 0x07CD, 0, 6))
    for name, sheet_type in sheets:
        out += record(0x85, struct.pack("<IBB", 0, 0, sheet_type) + bytes([len(name), 0]) + name.encode())
    out += record(0x0A, b"")
    return out


def plain_sheets(stream):
    """The same BIFF records, with each macro sheet a worksheet."""
    out = bytearray(stream)
    at = 0
    while at + 4 <= len(out):
        kind, size = struct.unpack_from("<HH", out, at)
        if kind == 0x85:
            out[at + 9] = 0
        if kind == 0x0809 and struct.unpack_from("<H", out, at + 6)[0] == 0x40:
            struct.pack_into("<H", out, at + 6, 0x10)
        at += 4 + size
    return bytes(out)


def office_zip(entries):
    out = io.BytesIO()
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as archive:
        for name, data in entries:
            info = zipfile.ZipInfo(name, EPOCH)
            info.compress_type = zipfile.ZIP_DEFLATED
            info.create_system = 0
            archive.writestr(info, data)
    return out.getvalue()


RELS = '<?xml version="1.0"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="%s"/></Relationships>'
TYPES = '<?xml version="1.0"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="bin" ContentType="application/vnd.ms-office.vbaProject"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/%s" ContentType="%s"/></Types>'


def ooxml(main_part, content_type, vba_path, vba, extra=()):
    return office_zip(
        [
            ("[Content_Types].xml", TYPES % (main_part, content_type)),
            ("_rels/.rels", RELS % main_part),
            (main_part, "<a/>"),
            (vba_path, vba),
            *extra,
        ]
    )


def activemime(ole):
    compressed = zlib.compress(ole)
    return b"ActiveMime" + bytes(20) + struct.pack("<H", 4) + bytes(18) + compressed


def ppt_record(version, instance, kind, data):
    return struct.pack("<HHI", version | instance << 4, kind, len(data)) + data


def ppt(storages, info=(0, 1, 2)):
    """A PowerPoint Document stream with a VBAInfoContainer, and each of its (compressed, data)."""
    atom = ppt_record(2, 0, 0x400, struct.pack("<III", *info))
    stream = ppt_record(0xF, 1, 0x3FF, atom)
    for compressed, data in storages:
        if compressed:
            stream += ppt_record(0, 1, 0x1011, struct.pack("<I", len(data)) + zlib.compress(data))
        else:
            stream += ppt_record(0, 0, 0x1011, data)
    return stream


def current_user():
    name = b"a"
    atom = struct.pack("<IIIHHBB", 0x14, 0xE391C05F, 0, len(name), 0x3F4, 3, 0) + bytes(2) + name + struct.pack("<I", 8)
    return ppt_record(0, 0, 0xFF6, atom)


