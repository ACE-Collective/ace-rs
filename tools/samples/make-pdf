FONT = b"/Resources<</Font<</F1<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>>>>>"


def text_stream(lines, size=12):
    """A content stream that draws each (x, y, text) in Helvetica, y from the bottom of the page."""
    return b"".join(b"BT /F1 %d Tf %d %d Td (%s) Tj ET\n" % (size, x, y, text) for x, y, text in lines)


def text_link(uri, rect, extra=b""):
    return b"<</Type/Annot/Subtype/Link/Rect" + rect + extra + b"/A<</S/URI/URI(" + uri + b")>>>>"


def pages(specs, tree=b"", extra=None):
    """A file of pages, each (page dictionary entries, content stream bytes), under one /Pages with
    `tree`'s entries, which the pages inherit. `extra` is more objects, by number, past the pages'."""
    kids = b" ".join(b"%d 0 R" % (3 + 2 * i) for i in range(len(specs)))
    objects = {
        1: b"<</Type/Catalog/Pages 2 0 R>>",
        2: b"<</Type/Pages/Kids[" + kids + b"]/Count %d" % len(specs) + tree + b">>",
    }
    for i, (entries, content) in enumerate(specs):
        objects[3 + 2 * i] = b"<</Type/Page/Parent 2 0 R" + FONT + entries + b"/Contents %d 0 R>>" % (4 + 2 * i)
        objects[4 + 2 * i] = stream(content)
    objects.update(extra or {})
    return pdf(objects)


