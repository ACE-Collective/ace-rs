        : len(samples["encrypted_aes_256_r6.pdf"]) * 3 // 4
    ]
    return samples


def nested(depth, key=b"/K"):
    return b"<<" + key + b" " + (b"<<" + key + b" ") * depth + b"1" + b">>" * (depth + 1)


def filters_sample():
    """pdf-parser.py's filters, one object each. It stops at the first FlateDecode that fails, so that
    has a sample of its own."""
    # LZW codes in 9 bits: clear, A, B, 258 (AB), end of data
    bits = 0
    for code in (256, 65, 66, 258, 257):
        bits = (bits << 9) | code
    lzw = (bits << 3).to_bytes(6, "big")
    items = [
        stream(b"plain, with no filter"),
        flate(b"flate 'single quote' and \"double\" and \\ and \xff\n"),
        stream(b"68 65 78>", b"/Filter/ASCIIHexDecode"),
        stream(b"6865", b"/Filter/AHx"),
        stream(b"not hex", b"/Filter/ASCIIHexDecode"),
        stream(b"686", b"/Filter/ASCIIHexDecode"),
        stream(b"87cURDZ~>", b"/Filter/ASCII85Decode"),
        stream(b"z87cUR~>", b"/Filter/A85"),
        stream(b"8z", b"/Filter/ASCII85Decode"),
        stream(b"uuuuu~>", b"/Filter/ASCII85Decode"),
        stream(lzw, b"/Filter/LZWDecode"),
        stream(b"\xff\xff\xff", b"/Filter/LZW"),
        stream(b"\x01ab\xfex\x80", b"/Filter/RunLengthDecode"),
        stream(b"\x01ab", b"/Filter/R"),
        stream(b"\x00zero length", b"/Filter/RunLengthDecode"),
        stream(zlib.compress(zlib.compress(b"flate twice")), b"/Filter[/FlateDecode/Fl]"),
        stream(zlib.compress(b"68 65"), b"/Filter[/FlateDecode/ASCIIHexDecode]"),
        stream(zlib.compress(b""), b"/Filter[/FlateDecode/AHx]"),
        stream(zlib.compress(b"x"), b"/Filter[/FlateDecode/A85]"),
        stream(zlib.compress(b"x"), b"/Filter[/FlateDecode/LZW]"),
        stream(zlib.compress(b"x"), b"/Filter[/FlateDecode/R]"),
        stream(base64.b16encode(zlib.compress(b"hex of flate")), b"/Filter[/AHx/Fl]"),
        stream(b"\xff\xd8\xff", b"/Filter/DCTDecode"),
        stream(b"x", b"/Filter[/DCTDecode/\xe9name]"),
        stream(b"x", b"/F#69lter/Unknown"),
        stream(zlib.compress(b"name in hex"), b"/F#69lter/Fl#61teDecode"),
        stream(zlib.compress(b"trailing bytes") + b"after the stream", b"/Filter/FlateDecode"),
    ]
    return document(extra={4 + i: item for i, item in enumerate(items)})


