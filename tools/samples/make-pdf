        "encrypted_needs_password_aes_128.pdf": encrypted(owner="owner", user="secret", R=4),
        "encrypted_needs_password_aes_256.pdf": encrypted(owner="owner", user="secret", R=6),
        # pikepdf's save rewrites this XMP through lxml, and ace-rs's doesn't. So this save mustn't.
        "encrypted_with_xmp.pdf": encrypted(
            source=for_encryption(metadata=True), owner="owner", user="", R=6, fix_metadata_version=False
