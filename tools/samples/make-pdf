def for_encryption(metadata=False):
    """What every encrypted sample holds, so a sample shows each read works through the decryption."""
    catalog = (
        b"/AcroForm<</Fields[<</T(payload)/V/" + LONG_NAME + b">><</T(text)/V(secret value)>>]>>"
        b"/Names<</JavaScript<</Names[(script)<</JS(var s = 'https://example.com/in-a-string';)>>"
        b"(stream)<</JS 4 0 R>>]>>>>"
    )
    extra = {
        4: flate(b"var t = 'https://example.com/in-a-stream';\n"),
        5: flate(b"BT /F1 12 Tf 10 10 Td (hidden text) Tj ET\n"),
    }
    if metadata:
        catalog += b"/Metadata 6 0 R"
        extra[6] = stream(XMP, b"/Type/Metadata/Subtype/XML")
    # two levels of page tree, an attribute to inherit and a wrong /Count, which pdf.save repairs
    objects = {
        1: b"<</Type/Catalog/Pages 2 0 R" + catalog + b">>",
        2: b"<</Type/Pages/Kids[7 0 R]/Count 5/MediaBox[0 0 200 200]>>",
        3: b"<</Type/Page/Parent 7 0 R/Contents 5 0 R/Annots["
        + link(b"(https://example.com/encrypted-annotation)")
        + b"]>>",
        7: b"<</Type/Pages/Parent 2 0 R/Kids[3 0 R]/Count 1>>",
    }
    objects.update(extra)
    return pdf(objects)


def encrypted(source=None, **options):
    """The source through pikepdf, with its encryption options."""
    save = {key: options.pop(key) for key in ("object_stream_mode", "fix_metadata_version") if key in options}
    options.setdefault("aes", options["R"] >= 4)
    options.setdefault("metadata", options["aes"])
    with pikepdf.open(io.BytesIO(source or for_encryption())) as document:
        out = io.BytesIO()
        document.save(out, encryption=pikepdf.Encryption(**options), **save)
    return out.getvalue()


