#!/usr/bin/env python3
"""Makes the crafted PDFs of docs/measurements/pdf-hostile.md, which measure what a PDF can make libqpdf
and the pdf-parser port do against a task's deadline and rlimits (PLAN.md 4.9). They're large or slow
on purpose, so they aren't samples.

    make-pdf-hostile <out dir>
"""

import sys
import zlib
from pathlib import Path


def body(objects, root=1):
    out = bytearray(b"%PDF-1.7\n")
    for number, value in objects:
        out += b"%d 0 obj\n" % number + value + b"\nendobj\n"
    out += b"trailer\n<</Root %d 0 R>>\n" % root
    return bytes(out)


def stream(data, entries=b""):
    return b"<<" + entries + b"/Length %d>>\nstream\n" % len(data) + data + b"\nendstream"


def bomb(size, chunk=1 << 24):
    compress = zlib.compressobj(9)
    out = bytearray()
    zeros = bytes(chunk)
    for _ in range(size // chunk):
        out += compress.compress(zeros)
    return bytes(out + compress.flush())


def catalog(entries=b""):
    return b"<</Type/Catalog/Pages 2 0 R" + entries + b">>"


# one page, because libqpdf refuses a tree with none. Object 3 is that page.
PAGES = [(2, b"<</Type/Pages/Kids[3 0 R]/Count 1>>"), (3, b"<</Type/Page/Parent 2 0 R>>")]


def js_stream(data, filters):
    return body(
        [
            (1, catalog(b"/Names<</JavaScript<</Names[(a)<</JS 4 0 R>>]>>>>")),
            *PAGES,
            (4, stream(data, filters)),
        ]
    )


def make(out):
    out.mkdir(parents=True, exist_ok=True)
    one_gib = bomb(1 << 30)
    four_gib = bomb(4 << 30)
    nested = zlib.compress(one_gib, 9)
    pages = 200_000
    kids = b" ".join(b"%d 0 R" % (10 + i) for i in range(pages))
    files = {
        # decoded by libqpdf, for a script, with nothing to stop it but the limit
        "js_flate_1gib.pdf": js_stream(one_gib, b"/Filter/FlateDecode"),
        "js_flate_4gib.pdf": js_stream(four_gib, b"/Filter/FlateDecode"),
        "js_flate_twice_1gib.pdf": js_stream(nested, b"/Filter[/FlateDecode/FlateDecode]"),
        # the same files as far as pdf-parser's limit is concerned: printed as repr, 4 bytes a byte
        "stream_flate_100mib.pdf": body([(1, catalog()), *PAGES, (4, stream(bomb(100 << 20), b"/Filter/FlateDecode"))]),
        # the script's table of strings grows with each code
        "stream_lzw_quadratic.pdf": body(
            [(1, catalog()), *PAGES, (4, stream(lzw_quadratic(1 << 20), b"/Filter/LZWDecode"))]
        ),
        # a token per byte
        "delimiters_64mib.pdf": b"%PDF-1.7\n1 0 obj\n" + b"(" * (64 << 20) + b"\nendobj\n",
        "numbers_16mib.pdf": b"%PDF-1.7\n" + b"1 " * (8 << 20),
        "stray_32mib.pdf": b"%PDF-1.7\n" + b"x " * (16 << 20),
        # deep structures, which qpdf bounds at 500, and which Python's limit ends in the script
        "nested_arrays_1m.pdf": body([(1, catalog(b"/A" + b"[" * 1_000_000 + b"]" * 1_000_000)), *PAGES]),
        "nested_dicts_100k.pdf": body([(1, catalog(b"/A " + b"<</A " * 100_000 + b"1" + b">>" * 100_000)), *PAGES]),
        # many objects
        "pages_200k.pdf": body(
            [
                (1, catalog()),
                (2, b"<</Type/Pages/Count %d/Kids[%s]>>" % (pages, kids)),
                *[(10 + i, b"<</Type/Page/Parent 2 0 R>>") for i in range(pages)],
            ]
        ),
        "annots_1m.pdf": body(
            [
                (1, catalog()),
                (2, b"<</Type/Pages/Count 1/Kids[3 0 R]>>"),
                (3, b"<</Type/Page/Parent 2 0 R/Annots[" + b"<</A<</URI(u)>>>>" * 1_000_000 + b"]>>"),
            ]
        ),
        # a tree that goes down until something stops it, and one that loops
        "page_tree_deep.pdf": body(
            [
                (1, catalog()),
                (2, b"<</Type/Pages/Kids[10 0 R]/Count 1>>"),
                *[(10 + i, b"<</Type/Pages/Parent 2 0 R/Kids[%d 0 R]/Count 1>>" % (11 + i)) for i in range(100_000)],
            ]
        ),
        "indirect_chain.pdf": body(
            [
                (1, catalog(b"/AcroForm<</Fields[<</T(a)/V 10 0 R>>]>>")),
                *PAGES,
                *[(10 + i, b"%d 0 R" % (11 + i)) for i in range(100_000)],
            ]
        ),
        "length_loop.pdf": body(
            [(1, catalog(b"/Names<</JavaScript<</Names[(a)<</JS 4 0 R>>]>>>>")), *PAGES, (4, b"<</Length 4 0 R>>\nstream\nabc\nendstream")]
        ),
        "xref_prev_loop.pdf": b"%PDF-1.7\n1 0 obj\n<</Type/Catalog>>\nendobj\nxref\n0 1\n0000000000 65535 f \ntrailer\n<</Root 1 0 R/Size 2/Prev 41>>\nstartxref\n41\n%%EOF\n",
        "object_streams_100k.pdf": object_streams(100_000),
    }
    for name, data in files.items():
        (out / name).write_bytes(data)
        print(name, len(data))


def lzw_quadratic(codes):
    """Clear, then a code that extends the last entry each time: entry n is n bytes long."""
    bits = bytearray()
    accumulator = 0
    count = 0

    def put(code, width):
        nonlocal accumulator, count
        accumulator = (accumulator << width) | code
        count += width
        while count >= 8:
            count -= 8
            bits.append((accumulator >> count) & 0xFF)
        accumulator &= (1 << count) - 1

    put(256, 9)
    put(65, 9)
    table = 258
    width = 9
    for _ in range(codes):
        # the entry about to be made, while codes can name it
        code = min(table, 4095)
        put(code, width)
        table += 1
        if table == 511:
            width = 10
        elif table == 1023:
            width = 11
        elif table == 2047:
            width = 12
    return bytes(bits)


def object_streams(count):
    text = b" ".join(b"%d %d" % (10 + i, i * 10) for i in range(count))
    first = len(text) + 1
    data = text + b"\n" + b"".join(b"<<>>      " for _ in range(count))
    return body(
        [
            (1, catalog()),
            *PAGES,
            (4, stream(zlib.compress(data), b"/Type/ObjStm/N %d/First %d/Filter/FlateDecode" % (count, first))),
        ]
    )


if __name__ == "__main__":
    make(Path(sys.argv[1]))
