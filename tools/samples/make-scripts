# --- what an RTF's objects can be ----------------------------------------------------------------------


def pe32():
    """The smallest file libmagic calls a PE32 executable: a DOS header pointing at a PE header."""
    dos = bytearray(b"MZ" + bytes(0x3A) + struct.pack("<I", 0x40))
    coff = b"PE\x00\x00" + struct.pack("<HHIIIHH", 0x14C, 1, 0, 0, 0, 0xE0, 0x0102)
    optional = struct.pack("<H", 0x10B) + bytes(0x5A) + struct.pack("<H", 2) + bytes(0xE0 - 0x5C)
    return bytes(dos) + coff + optional + bytes(40)


def extracted_fixtures():
    lnk = bytes.fromhex("4c0000000114020000000000c000000000000046") + bytes(56)
    return {
        "payload.exe": pe32(),
        "payload.bin": pe32(),
        # an MS-DOS executable, whose mime type is application/x-dosexec
        "stub.dat": b"MZ" + bytes(62) + b"\xb4\x4c\xcd\x21" + bytes(60),
        "shortcut.bin": lnk,
        "dropper.vbs": VBS,
        "archive.ZIP": b"PK\x05\x06" + bytes(18),
        "notes.txt": b"just some words\n",
    }


# --- samples ---------------------------------------------------------------------------------------------


def samples():
    return {
        "invoice.vbe": encode(VBS),
        "loader.jse": encode(JS),
        "hexdropper.vbs": b"Dim s\r\n' decode and run\r\ns = \"\" _\r\n"
        + b"".join(b"  & \"" + hex_run(64, f"sample{i}") + b"\" _\r\n" for i in range(30))
        + b"  & \"\"\r\nExecute s\r\n",
    }


def write(folder, files):
    for name, data in files.items():
        path = folder / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)


def main():
    write(FIXTURES / "mse", mse_fixtures())
    write(FIXTURES / "vbs", vbs_fixtures())
    write(FIXTURES / "rtf", rtf_fixtures())
    write(FIXTURES / "extracted", extracted_fixtures())

    made = []
    for name, data in samples().items():
        SCRIPTS.mkdir(parents=True, exist_ok=True)
        (SCRIPTS / name).write_bytes(data)
        made.append(
            {
                "path": f"ace4/scripts/{name}",
                "sha256": hashlib.sha256(data).hexdigest(),
                "size": len(data),
                "kinds": ["scripts"],
                "source": SOURCE,
                "in_git": True,
                "alert_path": name,
                "meta_tags": ["type=email.attachment"],
            }
        )
    manifest_path = SAMPLES / "manifest.json"
    manifest = json.loads(manifest_path.read_text())
    kept = [s for s in manifest["samples"] if s.get("source") != SOURCE]
    manifest["samples"] = sorted(kept + made, key=lambda s: s["path"])
    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n")
    print(f"{len(made)} samples")


if __name__ == "__main__":
    main()
