def xlsm_book():
    """A workbook with what a macro can read beyond its own sheet: a worksheet, shared strings, styles, row
    heights, a formula's quoted sheet, and a data formula for a name."""
    macro = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xm:macrosheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:xm="http://schemas.microsoft.com/office/excel/2006/main">
<sheetFormatPr defaultRowHeight="15"/>
<sheetData>
<row r="1" ht="30.5"><c r="A1"><f>CALL("show",Data!A1,Data!B2,'Data'!A3)</f></c></row>
<row r="2"><c r="A2" s="1"><f>CALL("cell",GET.CELL(17,A1),GET.CELL(17,A2),GET.CELL(19,A2),GET.CELL(24,A2),GET.CELL(38,A2),GET.CELL(8,A2),GET.CELL(50,A2),GET.CELL(19,A3),GET.CELL(8,Z9),GET.CELL(99,A2))</f></c></row>
<row r="3"><c r="A3" t="s"><v>1</v></c></row>
<row r="4"><c r="A4" t="str"><f>"cached"</f><v>shown</v></c></row>
<row r="5"><c r="A5"><f bx="1">myname=1+1</f></c></row>
<row r="6"><c r="A6"><f>CALL(myname,Macro1!A3,hidden_cell)</f></c></row>
<row r="7"><c r="A7"/><c r="B7"><f>GOTO(A8)</f></c></row>
<row r="8"><c r="A8"><f>HALT()</f></c></row>
</sheetData>
</xm:macrosheet>"""
    data = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">
<sheetFormatPr defaultRowHeight="14"/>
<sheetData>
<row r="1"><c r="A1" t="s"><v>0</v></c><c r="B1"><v>2.5</v></c></row>
<row r="2"><c r="B2"><f>1+1</f><v>2</v></c></row>
<row r="3"><c r="A3" t="inlineStr"><is><t>inline</t></is></c></row>
</sheetData>
</worksheet>"""
    strings = """<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" count="3"><si><t>first</t></si><si><r><t>run one</t></r><r><t>run two</t></r></si></sst>"""
    types = CONTENT_TYPES.replace(
        "</Types>",
        '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/></Types>',
    )
    rels = WORKBOOK_RELS.replace(
        "</Relationships>",
        '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet2.xml"/></Relationships>',
    )
    book = workbook(
        '<definedNames><definedName name="_xlnm.Auto_Open">Macro1!$A$1</definedName>'
        '<definedName name="Auto_Close2">Macro1!$A$8</definedName>'
        '<definedName name="hidden_cell">Macro1!$A$3</definedName></definedNames>'
    ).replace(
        '<sheet name="Macro1" sheetId="1" r:id="rId1"/>',
        '<sheet name="Macro1" sheetId="1" r:id="rId1"/><sheet name="Data" sheetId="2" r:id="rId2"/><sheet name="NoRel" sheetId="3" r:id="rId9"/>',
    )
    return make_zip([
        ("[Content_Types].xml", types),
        ("_rels/.rels", RELS),
        ("xl/workbook.xml", book),
        ("xl/_rels/workbook.xml.rels", rels),
        ("xl/macrosheets/sheet1.xml", macro),
        ("xl/worksheets/sheet2.xml", data),
        ("xl/sharedStrings.xml", strings),
        ("xl/styles.xml", STYLES),
    ])


def make(directory):
    """Each file, by the name the manifest knows it by."""
    files = {
        # what the emulator exists for: the URL is only there once the macro has run
        "xlm_obfuscated.xlsm": xlsm(OBFUSCATED_ROWS),
        # no Auto_Open, so the command asks where to start, on a stdin at its end
        "xlm_no_entry.xlsm": xlsm(OBFUSCATED_ROWS, names=""),
        # a cell nothing filled, so the command opens its shell, on a stdin at its end
        "xlm_unknown_cell.xlsm": xlsm(UNKNOWN_CELL_ROWS),
        # a sheet with no cells: xlm4:no_cells
        "xlm_no_cells.xlsm": xlsm([]),
        # a workbook that won't load: xlm4:error
        "xlm_broken.xlsm": make_zip([
            ("[Content_Types].xml", CONTENT_TYPES),
            ("_rels/.rels", RELS),
            ("xl/workbook.xml", "this isn't XML"),
            ("xl/_rels/workbook.xml.rels", WORKBOOK_RELS),
            ("xl/macrosheets/sheet1.xml", "nor this"),
        ]),
        "xlm_biff8.xls": compound_file("Workbook", biff8_workbook()),
        "xlm_xlsb.xlsb": xlsb(),
        # none of the module's own rules match, but tools/ace3/trees/signatures' XLM_Macrosheet_NonBin
        # matches a file in it, so the module analyzes both, as for any of its yara_rule_names
        "xlm_yara_rule.zip": make_zip([("note.txt", "ACE4-XLM-RULE-MARKER-9d2e\n")]),
        # a pass's timeout, in both systems
        "xlm_loop.xlsm": xlsm(LOOP_ROWS),
    }
    for name, rows in BRANCHES.items():
        files[f"xlm_branch_{name}.xlsm"] = xlsm(rows)
    files["xlm_book.xlsm"] = xlsm_book()
    directory.mkdir(parents=True, exist_ok=True)
    for name, data in files.items():
        (directory / name).write_bytes(data)
    return list(files)


if __name__ == "__main__":
    print("\n".join(make(Path(sys.argv[1]))))
