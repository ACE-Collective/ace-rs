#!/usr/bin/env python3
"""Writes crates/ace-mod-oletools/src/xlmdeob/grammar_tables.rs from XLMMacroDeobfuscator's grammar, as
lark 0.12 compiles it. The port runs lark's LALR tables and contextual lexer rather than a parser written
by hand, because which formulas parse, and into what tree, decides what the macro does.

Run it on the library's image, with this file's directory mounted at /w:

    docker run --rm -v "$PWD/tools/xlm":/w --entrypoint python \
        ace4-library-diff-python-libraries:<tag> /w/make-tables > crates/ace-mod-oletools/src/xlmdeob/grammar_tables.rs
"""

import os

import XLMMacroDeobfuscator
from lark import Lark
from lark.parsers.lalr_analysis import Shift

path = os.path.join(os.path.dirname(XLMMacroDeobfuscator.__file__), "xlm-macro.lark.template")
grammar = open(path, encoding="utf-8").read()
for name, char in (("XLLEFTBRACKET", "["), ("XLRIGHTBRACKET", "]"), ("XLLISTSEPARATOR", ",")):
    grammar = grammar.replace("{{%s}}" % name, char)
lark = Lark(grammar, parser="lalr")
table = lark.parser.parser._parse_table
lexer = lark.parser.lexer


def rust(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


terminals = [t.name for t in lark.terminals] + ["$END"]
term_id = {name: i for i, name in enumerate(terminals)}
rules = list(lark.rules)
rule_id = {id(rule): i for i, rule in enumerate(rules)}
origins = sorted({rule.origin.name for rule in rules})
origin_id = {name: i + len(terminals) for i, name in enumerate(origins)}

print("// @generated by tools/xlm/make-tables. Don't edit it.")
print()
print("/// (name, regular expression, what an error message calls it)")
print("pub(super) const TERMINALS: &[(&str, &str, &str)] = &[")
for t in lark.terminals:
    print(f"    ({rust(t.name)}, {rust(t.pattern.to_regexp())}, {rust(t.user_repr())}),")
print(f'    ("$END", "", "$END"),')
print("];")
print(f"pub(super) const IGNORE: u16 = {term_id[lark.ignore_tokens[0]]};")
print("/// Terminal names that can hold a newline, which the column in an error message counts.")
newline = sorted(lexer.root_lexer.newline_types)
print(f"pub(super) const NEWLINE_TERMINALS: &[u16] = &{[term_id[n] for n in newline]};")
print()
print("/// A nonterminal's name, by id less TERMINALS.len().")
print("pub(super) const ORIGINS: &[&str] = &[" + ", ".join(rust(o) for o in origins) + "];")
print()
print("/// A rule: its nonterminal, how many symbols it pops, whether a single child stands for the node,")
print("/// and which popped symbols it keeps: (index, splice that child's children).")
print("pub(super) type Rule = (u16, u8, bool, &'static [(u8, bool)]);")
print("pub(super) const RULES: &[Rule] = &[")
for rule in rules:
    keep = []
    for i, sym in enumerate(rule.expansion):
        filtered = sym.is_term and sym.filter_out and not rule.options.keep_all_tokens
        if not filtered:
            keep.append(f"({i}, {'true' if not sym.is_term and sym.name.startswith('_') else 'false'})")
    expand1 = "true" if rule.options.expand1 else "false"
    print(f"    ({origin_id[rule.origin.name]}, {len(rule.expansion)}, {expand1}, &[{', '.join(keep)}]),")
print("];")
print()
print(f"pub(super) const START_STATE: u16 = {table.start_states['start']};")
print(f"pub(super) const END_STATE: u16 = {table.end_states['start']};")
print("/// For each state: (symbol, action), sorted by symbol. An action of n >= 0 shifts or goes to state n,")
print("/// and one of n < 0 reduces by rule -n - 1.")
print("pub(super) const STATES: &[&[(u16, i16)]] = &[")
for state in range(len(table.states)):
    row = []
    for sym, (action, arg) in table.states[state].items():
        sid = term_id[sym] if sym in term_id else origin_id[sym]
        row.append((sid, arg if action is Shift else -rule_id[id(arg)] - 1))
    print("    &[" + ", ".join(f"({a}, {b})" for a, b in sorted(row)) + "],")
print("];")
print()
# a lexer per set of accepted terminals: the order tried, and strings a regular expression's match turns into
lexers, by_state, ids = [], [], {}
for state in range(len(table.states)):
    lx = lexer.lexers[state]
    key = id(lx)
    if key not in ids:
        ids[key] = len(lexers)
        lx.scanner
        unless = {}
        for name, callback in lx.callback.items():
            unless[name] = [t for t in callback.scanner.terminals]
        lexers.append((lx.scanner.terminals, unless))
    by_state.append(ids[key])
lexer.root_lexer.scanner
lexers_all = lexers + [(lexer.root_lexer.scanner.terminals, {n: list(c.scanner.terminals) for n, c in lexer.root_lexer.callback.items()})]
print("/// The lexer each state uses. The last in LEXERS is the root lexer, which only words an error.")
print(f"pub(super) const LEXER_OF_STATE: &[u16] = &{by_state};")
print("/// For each lexer: the terminals in the order it tries them, each with the terminals a match becomes when")
print("/// its whole text matches one of theirs.")
print("pub(super) const LEXERS: &[&[(u16, &[u16])]] = &[")
for terminals_of, unless in lexers_all:
    row = []
    for t in terminals_of:
        embedded = [term_id[u.name] for u in unless.get(t.name, [])]
        row.append(f"({term_id[t.name]}, &{embedded})")
    print("    &[" + ", ".join(row) + "],")
print("];")
